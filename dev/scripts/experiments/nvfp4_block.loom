kernel.def export("nvfp4_block") @nvfp4_block() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%block: buffer, %out: buffer) {
  %t = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %bytes = buffer.view %block[%origin] : buffer -> view<36xi8>
  %values = buffer.view %out[%origin] : buffer -> view<64xf32>
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %sub = index.div %t, %c16 : index
  %j = index.rem %t, %c16 : index
  %j8 = index.rem %j, %c8 : index
  %high = index.cmp uge, %j, %c8 : index
  %sub8 = index.mul %sub, %c8 : index
  %qs_base = index.add %sub8, %c4 : index
  %qs_index = index.add %qs_base, %j8 : index
  %packed8 = view.load %bytes[%qs_index] : view<36xi8> -> i8
  %scale8 = view.load %bytes[%sub] : view<36xi8> -> i8
  %packed = scalar.extui %packed8 : i8 to i32
  %c0_i32 = scalar.constant 0 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c15 = scalar.constant 15 : i32
  %shift = scf.select %high, %c4_i32, %c0_i32 : i32
  %shifted = scalar.shrui %packed, %shift : i32
  %nibble = scalar.andi %shifted, %c15 : i32
  %c7 = scalar.constant 7 : i32
  %c3 = scalar.constant 3 : i32
  %c2 = scalar.constant 2 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c8_i32 = scalar.constant 8 : i32
  %m = scalar.andi %nibble, %c7 : i32
  %negative_bit = scalar.andi %nibble, %c8_i32 : i32
  %is_negative = scalar.cmpi ne, %negative_bit, %c0_i32 : i32
  %big = scalar.cmpi uge, %m, %c4_i32 : i32
  %odd = scalar.andi %m, %c1_i32 : i32
  %mantissa = scalar.addi %c2, %odd : i32
  %half_m = scalar.shrui %m, %c1_i32 : i32
  %exp_shift = scalar.subi %half_m, %c1_i32 : i32
  %large = scalar.shli %mantissa, %exp_shift : i32
  %doubled = scf.select %big, %large, %m : i32
  %negated = scalar.subi %c0_i32, %doubled : i32
  %signed = scf.select %is_negative, %negated, %doubled : i32
  %code = scalar.sitofp %signed : i32 to f32
  %scale_fp8 = scalar.bitcast %scale8 : i8 to f8E4M3
  %scale = scalar.extf %scale_fp8 : f8E4M3 to f32
  %half = scalar.constant 0.5 : f32
  %scaled = scalar.mulf %scale, %half : f32
  %result = scalar.mulf %code, %scaled : f32
  view.store %result, %values[%t] : f32, view<64xf32>
  kernel.return
}
