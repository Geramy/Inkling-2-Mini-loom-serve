func.decl @inkling_attn_span_record(%spans: buffer, %span_cap: index, %s: index) -> (index, index, index, index, offset, i1)
func.decl @inkling_attn_decode_split(%split_blocks: index, %blocks: index) -> (index)

func.decl @inkling_attn_find_tile(%spans: buffer, %span_cap: index, %tile: index) -> (i1, index, index, index, index, offset, index)

template.decl @inkling.attn.mma.operand_elements() -> (index)

template.decl @inkling.attn.mma.accumulate(%accumulator_elements: index, %reduction_size: index, %left_columns: index, %left_layout: encoding<layout>, %left: buffer, %right_rows: index, %right_columns: index, %right: buffer, %right_row: index, %right_column: index, %initial: vector<[%accumulator_elements]xf32>) -> (vector<[%accumulator_elements]xf32>)

// Attention over blocks of 64 key positions. Mode 0: a tile of 16 query rows of one head from a span longer than one token. Mode 1: three heads of one KV head from one
// split of the context of a one token span. Keys below the span position come from the cache, the others from the activation buffers.
// Keys outside the visible range load as zero so that masked probabilities never meet stale data.
func.def public inline @inkling_attn_row(%dec: i1, %r: index, %rel0: index, %len: index, %begin: index, %pos0: index, %head: index, %kvh: index) -> (i1, index, index, index) {
  %c3 = index.constant 3 : index
  %c23 = index.constant 23 : index
  %rel = index.add %rel0, %r : index
  %prefill_valid = index.cmp ult, %rel, %len : index
  %decode_valid = index.cmp ult, %r, %c3 : index
  %valid = scf.select %dec, %decode_valid, %prefill_valid : i1
  %prefill_token0 = index.add %begin, %rel : index
  %prefill_token = scf.select %prefill_valid, %prefill_token0, %begin : index
  %token = scf.select %dec, %begin, %prefill_token : index
  %decode_head0 = index.madd %kvh, %c3, %r : index
  %decode_head = index.min %decode_head0, %c23 : index
  %row_head = scf.select %dec, %decode_head, %head : index
  %prefill_pos = index.add %pos0, %rel : index
  %qpos = scf.select %dec, %pos0, %prefill_pos : index
  func.return %valid, %token, %row_head, %qpos : i1, index, index, index
}

func.def public inline @inkling_attn_stage_block(%stage: buffer, %act: buffer, %state: buffer, %cache_off: offset, %tid: index, %threads: index, %block: index, %begin: index, %pos0: index, %kv_end: index, %kmin: index, %g: index, %cap: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c1024 = index.constant 1024 : index
  %zero = index.constant 0 : offset
  %zero8 = vector.splatf 0.0 : vector<8xf16>
  %stage_view = buffer.view %stage[%zero] : buffer -> view<64x136xf16>
  %act_view = buffer.view %act[%zero] : buffer -> view<[%cap]x1024xf16>
  %cache_view = buffer.view %state[%cache_off] : buffer -> view<8192xf16>
  %loads = index.div %c1024, %threads : index
  %block_pos = index.mul %block, %c64 : index
  %head_col = index.mul %g, %c128 : index
  scf.for %it = [%c0 to %loads step %c1] unroll {
    %idx0 = index.madd %it, %threads, %tid : index
    %idx = index.assume %idx0 [range(%idx0, 0, 1023)] : index
    %row = index.div %idx, %c16 : index
    %c8x = index.rem %idx, %c16 : index
    %col = index.mul %c8x, %c8 : index
    %kpos = index.add %block_pos, %row : index
    %above = index.cmp ule, %kmin, %kpos : index
    %below = index.cmp ult, %kpos, %kv_end : index
    %ok = scalar.andi %above, %below : i1
    %value = scf.if %ok -> (vector<8xf16>) {
      %from_act = index.cmp uge, %kpos, %pos0 : index
      %v = scf.if %from_act -> (vector<8xf16>) {
        %rel = index.sub %kpos, %pos0 : index
        %tok0 = index.add %begin, %rel : index
        %tok = index.assume %tok0 [range(%tok0, 0, 32767), lt(%tok0, %cap)] : index
        %col_act = index.add %head_col, %col : index
        %a = vector.load %act_view[%tok, %col_act] : view<[%cap]x1024xf16> -> vector<8xf16>
        scf.yield %a : vector<8xf16>
      } else {
        %at = index.madd %row, %c128, %col : index
        %c = vector.load %cache_view[%at] : view<8192xf16> -> vector<8xf16>
        scf.yield %c : vector<8xf16>
      }
      scf.yield %v : vector<8xf16>
    } else {
      scf.yield %zero8 : vector<8xf16>
    }
    vector.store %value, %stage_view[%row, %col] : vector<8xf16>, view<64x136xf16>
  }
  func.return
}

func.def public inline @inkling_attn_bias(%rb_view_buffer: buffer, %dist: i32, %rvec: vector<16xf32>) -> (f32) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %zero_f = scalar.constant 0.0 : f32
  %lo = scalar.constant 0 : i32
  %hi = scalar.constant 1023 : i32
  %clamped0 = scalar.maxsi %dist, %lo : i32
  %clamped = scalar.minsi %clamped0, %hi : i32
  %idx0 = index.cast %clamped : i32 to index
  %idx = index.assume %idx0 [range(%idx0, 0, 1023)] : index
  %view = buffer.view %rb_view_buffer[%zero] : buffer -> view<1024x16xf32>
  %row = vector.load %view[%idx, %c0] : view<1024x16xf32> -> vector<16xf32>
  %prod = vector.mulf %row, %rvec : vector<16xf32>
  %sum = vector.reduce<addf> %prod, %zero_f : vector<16xf32>, f32
  %in_range_lo = scalar.cmpi sge, %dist, %lo : i32
  %in_range_hi = scalar.cmpi sle, %dist, %hi : i32
  %in_range = scalar.andi %in_range_lo, %in_range_hi : i1
  %bias = scf.select %in_range, %sum, %zero_f : f32
  func.return %bias : f32
}

func.def public inline @inkling_attn_softmax_tile(%key_origin: index, %lane: index, %width: index, %qpos: vector<4xi32>, %qvalid: vector<4xi1>, %r0: vector<16xf32>, %r1: vector<16xf32>, %r2: vector<16xf32>, %r3: vector<16xf32>, %rel_bias: buffer, %is_global: i1, %query_row: index, %current_max: vector<4xf32>, %current_sum: vector<4xf32>, %scores: buffer, %probs: buffer) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %origin = index.constant 0 : offset
  %window = scalar.constant 1024 : i32
  %scale = scalar.constant 0.088388347648318447 : f32
  %padding = index.sub %width, %c1 : index
  %rounded = index.add %c64, %padding : index
  %packets = index.div %rounded, %width : index
  %negative = vector.splatf -1e+30 : vector<4xf32>
  %empty_sum = vector.splatf 0.0 : vector<4xf32>
  %scale4 = vector.splat %scale : vector<4xf32>
  %empty_scores = vector.splatf -1e+30 : vector<[%packets]x4xf32>
  %empty_masks = vector.splati 0 : vector<[%packets]x4xi1>
  %score_view = buffer.view %scores[%origin] : buffer -> view<64x24xf32>
  %prob_view = buffer.view %probs[%origin] : buffer -> view<64x24xf16>
  %zero_i4 = vector.splati 0 : vector<4xi32>
  %window4 = vector.splat %window : vector<4xi32>
  %global4 = vector.splat %is_global : vector<4xi1>
  %score_bank, %valid_bank = scf.for %packet = [%c0 to %packets step %c1](%old_scores = %empty_scores : vector<[%packets]x4xf32>, %old_masks = %empty_masks : vector<[%packets]x4xi1>) -> (vector<[%packets]x4xf32>, vector<[%packets]x4xi1>) unroll {
    %row = index.madd %packet, %width, %lane : index
    %live = index.cmp ult, %row, %c64 : index
    %key = index.add %key_origin, %row : index
    %key_word = index.cast %key : index to i32
    %keys = vector.splat %key_word : vector<4xi32>
    %dist = vector.subi %qpos, %keys : vector<4xi32>
    %causal = vector.cmpi sge, %dist, %zero_i4 : vector<4xi32> -> vector<4xi1>
    %inside = vector.cmpi slt, %dist, %window4 : vector<4xi32> -> vector<4xi1>
    %in_window = vector.ori %inside, %global4 : vector<4xi1>
    %live4 = vector.splat %live : vector<4xi1>
    %q_live = vector.andi %qvalid, %live4 : vector<4xi1>
    %causal_live = vector.andi %causal, %q_live : vector<4xi1>
    %valid = vector.andi %causal_live, %in_window : vector<4xi1>
    %raw = scf.if %live -> (vector<4xf32>) {
      %bounded_row = index.assume %row [range(%row, 0, 63)] : index
      %value = vector.load %score_view[%bounded_row, %query_row] : view<64x24xf32> -> vector<4xf32>
      scf.yield %value : vector<4xf32>
    } else {
      scf.yield %negative : vector<4xf32>
    }
    %d0 = vector.extract %dist[0] : vector<4xi32> -> i32
    %d1 = vector.extract %dist[1] : vector<4xi32> -> i32
    %d2 = vector.extract %dist[2] : vector<4xi32> -> i32
    %d3 = vector.extract %dist[3] : vector<4xi32> -> i32
    %b0 = func.call @inkling_attn_bias(%rel_bias, %d0, %r0) : (buffer, i32, vector<16xf32>) -> (f32)
    %b1 = func.call @inkling_attn_bias(%rel_bias, %d1, %r1) : (buffer, i32, vector<16xf32>) -> (f32)
    %b2 = func.call @inkling_attn_bias(%rel_bias, %d2, %r2) : (buffer, i32, vector<16xf32>) -> (f32)
    %b3 = func.call @inkling_attn_bias(%rel_bias, %d3, %r3) : (buffer, i32, vector<16xf32>) -> (f32)
    %bias = vector.from_elements %b0, %b1, %b2, %b3 : vector<4xf32>
    %scaled = vector.mulf %raw, %scale4 : vector<4xf32>
    %logit = vector.addf %scaled, %bias : vector<4xf32>
    %masked = vector.select %valid, %logit, %negative : vector<4xf32>
    %next_scores = vector.insert %masked into %old_scores[%packet] : vector<4xf32>, vector<[%packets]x4xf32>
    %next_masks = vector.insert %valid into %old_masks[%packet] : vector<4xi1>, vector<[%packets]x4xi1>
    scf.yield %next_scores, %next_masks : vector<[%packets]x4xf32>, vector<[%packets]x4xi1>
  }
  %first_scores = vector.extract %score_bank[0] : vector<[%packets]x4xf32> -> vector<4xf32>
  %local_max = scf.for %packet = [%c1 to %packets step %c1](%maximum = %first_scores : vector<4xf32>) -> (vector<4xf32>) unroll {
    %values = vector.extract %score_bank[%packet] : vector<[%packets]x4xf32> -> vector<4xf32>
    %next = vector.maxnumf %maximum, %values : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  %block_max = kernel.subgroup.reduce<maxnumf> %local_max : vector<4xf32>
  %next_max = vector.maxnumf %current_max, %block_max : vector<4xf32>
  %local_sum = scf.for %packet = [%c0 to %packets step %c1](%sum = %empty_sum : vector<4xf32>) -> (vector<4xf32>) unroll {
    %values = vector.extract %score_bank[%packet] : vector<[%packets]x4xf32> -> vector<4xf32>
    %valid = vector.extract %valid_bank[%packet] : vector<[%packets]x4xi1> -> vector<4xi1>
    %delta = vector.subf %values, %next_max : vector<4xf32>
    %raw_probability = vector.expf<afn> %delta : vector<4xf32>
    %probability = vector.select %valid, %raw_probability, %empty_sum : vector<4xf32>
    %half = vector.fptrunc %probability : vector<4xf32> to vector<4xf16>
    %row = index.madd %packet, %width, %lane : index
    %in_tile = index.cmp ult, %row, %c64 : index
    scf.if %in_tile {
      %bounded_row = index.assume %row [range(%row, 0, 63)] : index
      vector.store %half, %prob_view[%bounded_row, %query_row] : vector<4xf16>, view<64x24xf16>
    }
    %next = vector.addf %sum, %probability : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  %block_sum = kernel.subgroup.reduce<addf> %local_sum : vector<4xf32>
  %old_delta = vector.subf %current_max, %next_max : vector<4xf32>
  %old_scale = vector.expf<afn> %old_delta : vector<4xf32>
  %scaled_sum = vector.mulf %current_sum, %old_scale : vector<4xf32>
  %next_sum = vector.addf %scaled_sum, %block_sum : vector<4xf32>
  func.return %next_max, %next_sum, %old_scale : vector<4xf32>, vector<4xf32>, vector<4xf32>
}

kernel.def export("inkling_attn_tile") @inkling_attn_tile(%grid_x: index, %grid_y: index, %grid_z: index) {
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %width = target.subgroup.size : index
  %threads = index.mul %four, %width : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %grid_z) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %span_cap: index, %mode: index, %global: index, %split_blocks: index, %max_splits: index, %max_blocks: index, %kv_origin: offset, %spans: buffer, %rows: buffer, %state: buffer, %q: buffer, %r: buffer, %k_act: buffer, %v_act: buffer, %rel_bias: buffer, %sink: buffer, %gate: buffer, %out: buffer, %partial: buffer) {
  %cap = index.assume %cap_in [range(%cap_in, 1, 32768)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c24 = index.constant 24 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c136 = index.constant 136 : index
  %c256 = index.constant 256 : index
  %c1023 = index.constant 1023 : index
  %c2048 = index.constant 2048 : index
  %c32768 = index.constant 32768 : index
  %c16384 = index.constant 16384 : offset
  %c1_o = index.constant 1 : offset
  %c262144 = index.constant 262144 : offset
  %c40 = index.constant 40 : offset
  %zero = index.constant 0 : offset
  %zero_f = scalar.constant 0.0 : f32
  %one_f = scalar.constant 1.0 : f32
  %width = target.subgroup.size : index
  %threads = index.mul %c4, %width : index
  %operand_elements = template.apply<@inkling.attn.mma.operand_elements>() : () -> (index)
  %matrix_elements = index.div %c256, %width : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %tid = kernel.workitem.id<x> : index
  %sg0 = kernel.subgroup.id : index
  %sg = index.assume %sg0 [range(%sg0, 0, 3)] : index
  %lane = kernel.subgroup.lane.id : index
  %wg_x = kernel.workgroup.id<x> : index
  %wg_y = kernel.workgroup.id<y> : index
  %wg_z = kernel.workgroup.id<z> : index
  %dec = index.cmp ne, %mode, %c0 : index
  %is_global = index.cmp ne, %global, %c0 : index

  %pf_found, %pf_begin, %pf_len, %pf_pos0, %pf_row, %pf_slot, %pf_tile = func.call @inkling_attn_find_tile(%spans, %span_cap, %wg_x) : (buffer, index, index) -> (i1, index, index, index, index, offset, index)
  %dc_begin, %dc_len, %dc_pos0, %dc_row, %dc_slot, %dc_active = func.call @inkling_attn_span_record(%spans, %span_cap, %wg_x) : (buffer, index, index) -> (index, index, index, index, offset, i1)
  %dc_single = index.cmp eq, %dc_len, %c1 : index
  %dc_found = scalar.andi %dc_active, %dc_single : i1
  %found = scf.select %dec, %dc_found, %pf_found : i1
  %begin = scf.select %dec, %dc_begin, %pf_begin : index
  %len = scf.select %dec, %dc_len, %pf_len : index
  %pos0 = scf.select %dec, %dc_pos0, %pf_pos0 : index
  %row = scf.select %dec, %dc_row, %pf_row : index
  %slot = scf.select %dec, %dc_slot, %pf_slot : offset
  %tile16 = index.mul %pf_tile, %c16 : index
  %rel0 = scf.select %dec, %c0, %tile16 : index
  %head_div = index.div %wg_y, %c3 : index
  %kvh0 = scf.select %dec, %wg_y, %head_div : index
  %c7 = index.constant 7 : index
  %c23 = index.constant 23 : index
  %kvh = index.min %kvh0, %c7 : index
  %head = index.min %wg_y, %c23 : index

  %q_stage_bytes = index.constant 4352 : offset
  %kv_stage_bytes = index.constant 17408 : offset
  %score_stage_bytes = index.constant 6144 : offset
  %prob_stage_bytes = index.constant 3072 : offset
  %small_stage_bytes = index.constant 1024 : offset
  %prod_stage_bytes = index.constant 8192 : offset
  %q_stage = buffer.alloca<workgroup> align(16) %q_stage_bytes : buffer
  %kv_stage = buffer.alloca<workgroup> align(16) %kv_stage_bytes : buffer
  %score_stage = buffer.alloca<workgroup> align(16) %score_stage_bytes : buffer
  %prob_stage = buffer.alloca<workgroup> align(16) %prob_stage_bytes : buffer
  %r_stage = buffer.alloca<workgroup> align(16) %small_stage_bytes : buffer
  %prod_stage = buffer.alloca<workgroup> align(16) %prod_stage_bytes : buffer

  scf.if %found {
    %kv_end = index.add %pos0, %len : index
    %p_lo = index.add %pos0, %rel0 : index
    %len_m1 = index.sub %len, %c1 : index
    %rel_last0 = index.add %rel0, %c15 : index
    %rel_last1 = index.min %rel_last0, %len_m1 : index
    %rel_last = scf.select %dec, %c0, %rel_last1 : index
    %p_hi = index.add %pos0, %rel_last : index
    %lo_max = index.max %p_lo, %c1023 : index
    %lo_shift = index.sub %lo_max, %c1023 : index
    %kmin = scf.select %is_global, %c0, %lo_shift : index
    %kmin_a = index.assume %kmin [range(%kmin, 0, 2147483647)] : index
    %p_hi_a = index.assume %p_hi [range(%p_hi, 0, 2147483647)] : index
    %b_lo = index.div %kmin_a, %c64 : index
    %b_hi = index.div %p_hi_a, %c64 : index
    %b_end = index.add %b_hi, %c1 : index
    %nblocks = index.sub %b_end, %b_lo : index
    %eff_split = func.call @inkling_attn_decode_split(%split_blocks, %nblocks) : (index, index) -> (index)
    %split_off = index.mul %wg_z, %eff_split : index
    %sb0_dec = index.add %b_lo, %split_off : index
    %sb1_dec0 = index.add %sb0_dec, %eff_split : index
    %sb1_dec = index.min %sb1_dec0, %b_end : index
    %sb0 = scf.select %dec, %sb0_dec, %b_lo : index
    %sb1 = scf.select %dec, %sb1_dec, %b_end : index
    %has_work = index.cmp ult, %sb0, %sb1 : index
    scf.if %has_work {
      %q_view = buffer.view %q[%zero] : buffer -> view<[%cap]x3072xf32>
      %r_view = buffer.view %r[%zero] : buffer -> view<[%cap]x384xf32>
      %sink_view = buffer.view %sink[%zero] : buffer -> view<[%cap]x24xf32>
      %gate_view = buffer.view %gate[%zero] : buffer -> view<[%cap]x3072xf32>
      %out_view = buffer.view %out[%zero] : buffer -> view<[%cap]x3072xf32>
      %q_stage_view = buffer.view %q_stage[%zero] : buffer -> view<16x136xf16>
      %q_t_layout = encoding.layout.strided [1, 136] : encoding<layout>
      %q_t_view = buffer.view %q_stage[%zero] : buffer -> view<128x16xf16, %q_t_layout>
      %kv_view = buffer.view %kv_stage[%zero] : buffer -> view<64x136xf16>
      %score_view = buffer.view %score_stage[%zero] : buffer -> view<64x24xf32>
      %r_stage_view = buffer.view %r_stage[%zero] : buffer -> view<16x16xf32>
      %scale_view = buffer.view %r_stage[%zero] : buffer -> view<16x16xf32>
      %prod_view = buffer.view %prod_stage[%zero] : buffer -> view<16x128xf32>
      %ml_view = buffer.view %score_stage[%zero] : buffer -> view<16x2xf32>
      %prob_t_layout = encoding.layout.strided [1, 24] : encoding<layout>
      %qpk = index.div %c128, %width : index
      %zero_q = vector.splatf 0.0 : vector<[%qpk]xf16>

      scf.for %it = [%c0 to %c4 step %c1] unroll {
        %local_row = index.madd %it, %c4, %sg : index
        %valid, %token0, %row_head, %qpos = func.call @inkling_attn_row(%dec, %local_row, %rel0, %len, %begin, %pos0, %head, %kvh) : (i1, index, index, index, index, index, index, index) -> (i1, index, index, index)
        %token = index.assume %token0 [range(%token0, 0, 32767), lt(%token0, %cap)] : index
        %channel = index.mul %lane, %qpk : index
        %q_col0 = index.madd %row_head, %c128, %channel : index
        %q_col = index.assume %q_col0 [range(%q_col0, 0, 3071)] : index
        %value = scf.if %valid -> (vector<[%qpk]xf16>) {
          %loaded = vector.load %q_view[%token, %q_col] : view<[%cap]x3072xf32> -> vector<[%qpk]xf32>
          %half = vector.fptrunc %loaded : vector<[%qpk]xf32> to vector<[%qpk]xf16>
          scf.yield %half : vector<[%qpk]xf16>
        } else {
          scf.yield %zero_q : vector<[%qpk]xf16>
        }
        vector.store %value, %q_stage_view[%local_row, %channel] : vector<[%qpk]xf16>, view<16x136xf16>
      }
      scf.for %e = [%tid to %c256 step %threads] {
        %local_row = index.div %e, %c16 : index
        %mm = index.rem %e, %c16 : index
        %valid, %token0, %row_head, %qpos = func.call @inkling_attn_row(%dec, %local_row, %rel0, %len, %begin, %pos0, %head, %kvh) : (i1, index, index, index, index, index, index, index) -> (i1, index, index, index)
        %token = index.assume %token0 [range(%token0, 0, 32767), lt(%token0, %cap)] : index
        %r_col0 = index.madd %row_head, %c16, %mm : index
        %r_col = index.assume %r_col0 [range(%r_col0, 0, 383)] : index
        %rv = scf.if %valid -> (f32) {
          %loaded = view.load %r_view[%token, %r_col] : view<[%cap]x384xf32> -> f32
          scf.yield %loaded : f32
        } else {
          scf.yield %zero_f : f32
        }
        %lr = index.assume %local_row [range(%local_row, 0, 15)] : index
