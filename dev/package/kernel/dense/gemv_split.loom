// A workgroup of 256 workitems takes one weight row for each subgroup. For small K (64) and many rows.
func.def public pure inline @inkling_dense_gemv_rows_groups(%n_rows: index) -> (index, index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %size = target.subgroup.size : index
  %waves = index.div %threads, %size : index
  %waves_m1 = index.sub %waves, %c1 : index
  %round = index.add %n_rows, %waves_m1 : index
  %groups = index.div %round, %waves : index
  func.return %groups, %threads : index, index
}

kernel.def @inkling_gemv_rows_bf16(%n_rows: index) {
  %c1 = index.constant 1 : index
  %groups, %threads = func.call pure @inkling_dense_gemv_rows_groups(%n_rows) : (index) -> (index, index)
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %is_bf16 = scalar.constant true : i1
  func.call @inkling_dense_gemv_rows_body(%is_bf16, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (i1, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def @inkling_gemv_rows_f32(%n_rows: index) {
  %c1 = index.constant 1 : index
  %groups, %threads = func.call pure @inkling_dense_gemv_rows_groups(%n_rows) : (index) -> (index, index)
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %is_bf16 = scalar.constant false : i1
  func.call @inkling_dense_gemv_rows_body(%is_bf16, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (i1, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
