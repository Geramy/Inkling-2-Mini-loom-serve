// GEMV for few weight rows and any K (K % 4 = 0) with F32 or BF16 weights: one workgroup for each weight row, the subgroups of the workgroup split K.
// Same launch list as the GEMV kernels, up to 8 live rows. Used for the 24, 32, 64 and 128 row tensors and for K = 64 and K = 4608.
// y[r][n] = act(sum_k W[n][k] * x[r][k]) for r < min(T, cols), n < n_rows.

config.decl @inkling.dense.split.waves : %value: index where [range(%value, 1, 16)]

config.decl @inkling.dense.gemv.cols : %value: index where [range(%value, 1, 8)]

func.decl @inkling_dense_live_rows(%control: buffer, %count_origin: offset) -> (index)

func.decl @inkling_dense_col_origin(%origin: offset, %col: index, %last: index, %stride: index) -> (offset)

func.decl @inkling_dense_epilogue(%value: f32, %act: index, %cap: f32) -> (f32)

func.decl @inkling_dense_store(%dst: buffer, %col_origin: offset, %n_rows: index, %row: index, %value: f32)

// Four weight values at element e of the row. The caller proves e + 3 < k_size.
func.def public inline @inkling_dense_split_w4(%weight: buffer, %row_origin: offset, %k_size: index, %e: index, %is_bf16: i1) -> (vector<4xf32>) {
  %w = scf.if %is_bf16 -> (vector<4xf32>) {
    %view = buffer.view %weight[%row_origin] : buffer -> view<[%k_size]xbf16>
    %raw = vector.load %view[%e] : view<[%k_size]xbf16> -> vector<4xbf16>
    %wide = vector.extf %raw : vector<4xbf16> to vector<4xf32>
    scf.yield %wide : vector<4xf32>
  } else {
    %view = buffer.view %weight[%row_origin] : buffer -> view<[%k_size]xf32>
    %raw = vector.load %view[%e] : view<[%k_size]xf32> -> vector<4xf32>
    scf.yield %raw : vector<4xf32>
  }
  func.return %w : vector<4xf32>
}

func.def public inline @inkling_dense_split_acc(%acc: vector<4xf32>, %use: i1, %input: buffer, %col_origin: offset, %k_size: index, %e: index, %w: vector<4xf32>) -> (vector<4xf32>) {
  %next = scf.if %use -> (vector<4xf32>) {
    %view = buffer.view %input[%col_origin] : buffer -> view<[%k_size]xf32>
    %x = vector.load %view[%e] : view<[%k_size]xf32> -> vector<4xf32>
    %sum = vector.fmaf %w, %x, %acc : vector<4xf32>
    scf.yield %sum : vector<4xf32>
  } else {
    scf.yield %acc : vector<4xf32>
  }
  func.return %next : vector<4xf32>
}

// All lanes of the subgroup call this. The first lane of the subgroup stores the subgroup sum.
func.def public inline @inkling_dense_split_publish(%acc: vector<4xf32>, %use: i1, %stage: buffer, %wave: index, %col: index, %is_lane0: i1) {
  scf.if %use {
    %zero = scalar.constant 0.0 : f32
    %b0 = index.constant 0 : offset
    %lane_sum = vector.reduce<addf> %acc, %zero : vector<4xf32>, f32
    %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    scf.if %is_lane0 {
      %view = buffer.view %stage[%b0] : buffer -> view<16x8xf32>
      view.store %sum, %view[%wave, %col] : f32, view<16x8xf32>
    }
  }
  func.return
}

func.def public inline @inkling_dense_gemv_split_body(%is_bf16: i1, %n_rows_in: index, %k_size_in: index, %control: buffer, %count_origin: offset, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %dst: buffer) {
  %k_size = index.assume %k_size_in [range(%k_size_in, 4, 16384), multiple_of(%k_size_in, 4)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_tile = config.get @inkling.dense.gemv.cols : index
  %waves = config.get @inkling.dense.split.waves : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %b0 = index.constant 0 : offset
  %stage_bytes = index.constant 512 : offset
  %zero = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %row = kernel.workgroup.id<x> : index
  %wave0 = kernel.subgroup.id : index
  %lane0 = kernel.subgroup.lane.id : index
  %size = kernel.subgroup.size : index
  %wave = index.assume %wave0 [range(%wave0, 0, 15)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 63)] : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %live0 = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %live = index.min %live0, %n_tile : index
  %live_floor = index.max %live, %c1 : index
  %last_live = index.sub %live_floor, %c1 : index
  %unit_shift = scf.if %is_bf16 -> (index) {
    scf.yield %c1 : index
  } else {
    scf.yield %c2 : index
  }
  %row_elems = index.mul %row, %k_size : index
  %row_bytes = index.shli %row_elems, %unit_shift : index
  %row_bytes_o = index.cast %row_bytes : index to offset
  %w_row_origin = index.add %w_origin, %row_bytes_o : offset
  %xo0 = func.call @inkling_dense_col_origin(%x_origin, %c0, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo1 = func.call @inkling_dense_col_origin(%x_origin, %c1, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo2 = func.call @inkling_dense_col_origin(%x_origin, %c2, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo3 = func.call @inkling_dense_col_origin(%x_origin, %c3, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo4 = func.call @inkling_dense_col_origin(%x_origin, %c4, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo5 = func.call @inkling_dense_col_origin(%x_origin, %c5, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo6 = func.call @inkling_dense_col_origin(%x_origin, %c6, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo7 = func.call @inkling_dense_col_origin(%x_origin, %c7, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %use0 = index.cmp ult, %c0, %n_tile : index
  %use1 = index.cmp ult, %c1, %n_tile : index
  %use2 = index.cmp ult, %c2, %n_tile : index
  %use3 = index.cmp ult, %c3, %n_tile : index
  %use4 = index.cmp ult, %c4, %n_tile : index
  %use5 = index.cmp ult, %c5, %n_tile : index
  %use6 = index.cmp ult, %c6, %n_tile : index
  %use7 = index.cmp ult, %c7, %n_tile : index
  %lane_e = index.mul %lane, %c4 : index
  %wave_span = index.mul %size, %c4 : index
  %first = index.mul %wave, %wave_span : index
  %e0 = index.add %first, %lane_e : index
  %step = index.mul %waves, %wave_span : index
  %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7 = scf.for %e_raw = [%e0 to %k_size step %step](%s0 = %zero4 : vector<4xf32>, %s1 = %zero4 : vector<4xf32>, %s2 = %zero4 : vector<4xf32>, %s3 = %zero4 : vector<4xf32>, %s4 = %zero4 : vector<4xf32>, %s5 = %zero4 : vector<4xf32>, %s6 = %zero4 : vector<4xf32>, %s7 = %zero4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %e = index.assume %e_raw [range(%e_raw, 0, 2147483640)] : index
    %last = index.add %e, %c3 : index
    %fits = index.cmp ult, %last, %k_size : index
    %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 = scf.if %fits -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %w = func.call @inkling_dense_split_w4(%weight_noalias, %w_row_origin, %k_size, %e, %is_bf16) : (buffer, offset, index, index, i1) -> (vector<4xf32>)
      %n0 = func.call @inkling_dense_split_acc(%s0, %use0, %input_noalias, %xo0, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n1 = func.call @inkling_dense_split_acc(%s1, %use1, %input_noalias, %xo1, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n2 = func.call @inkling_dense_split_acc(%s2, %use2, %input_noalias, %xo2, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n3 = func.call @inkling_dense_split_acc(%s3, %use3, %input_noalias, %xo3, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n4 = func.call @inkling_dense_split_acc(%s4, %use4, %input_noalias, %xo4, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n5 = func.call @inkling_dense_split_acc(%s5, %use5, %input_noalias, %xo5, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n6 = func.call @inkling_dense_split_acc(%s6, %use6, %input_noalias, %xo6, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      %n7 = func.call @inkling_dense_split_acc(%s7, %use7, %input_noalias, %xo7, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
      scf.yield %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    } else {
      scf.yield %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    scf.yield %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  %is_lane0 = index.cmp eq, %lane, %c0 : index
  func.call @inkling_dense_split_publish(%a0, %use0, %stage, %wave, %c0, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a1, %use1, %stage, %wave, %c1, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a2, %use2, %stage, %wave, %c2, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a3, %use3, %stage, %wave, %c3, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a4, %use4, %stage, %wave, %c4, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a5, %use5, %stage, %wave, %c5, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a6, %use6, %stage, %wave, %c6, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  func.call @inkling_dense_split_publish(%a7, %use7, %stage, %wave, %c7, %is_lane0) : (vector<4xf32>, i1, buffer, index, index, i1)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %t = index.madd %wave, %size, %lane : index
  %is_col = index.cmp ult, %t, %live : index
  scf.if %is_col {
    %col = index.assume %t [range(%t, 0, 7)] : index
    %view = buffer.view %stage[%b0] : buffer -> view<16x8xf32>
    %sum = scf.for %w = [%c0 to %waves step %c1](%acc = %zero : f32) -> (f32) {
      %w_in = index.assume %w [range(%w, 0, 15)] : index
      %part = view.load %view[%w_in, %col] : view<16x8xf32> -> f32
      %next = scalar.addf %acc, %part : f32
      scf.yield %next : f32
    }
    %y = func.call @inkling_dense_epilogue(%sum, %act, %cap) : (f32, index, f32) -> (f32)
    %d_col = func.call @inkling_dense_col_origin(%d_origin, %col, %last_live, %d_stride) : (offset, index, index, index) -> (offset)
    func.call @inkling_dense_store(%dst_noalias, %d_col, %n_rows, %row, %y) : (buffer, offset, index, index, f32)
  }
  func.return
}

func.def public pure inline @inkling_dense_gemv_split_threads() -> (index) {
  %waves = config.get @inkling.dense.split.waves : index
  %size = target.subgroup.size : index
  %threads = index.mul %waves, %size : index
  func.return %threads : index
}

kernel.def @inkling_gemv_split_bf16(%n_rows: index) {
  %c1 = index.constant 1 : index
  %threads = func.call pure @inkling_dense_gemv_split_threads() : () -> (index)
  kernel.launch.config workgroups(%n_rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %is_bf16 = scalar.constant true : i1
  func.call @inkling_dense_gemv_split_body(%is_bf16, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (i1, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def @inkling_gemv_split_f32(%n_rows: index) {
  %c1 = index.constant 1 : index
  %threads = func.call pure @inkling_dense_gemv_split_threads() : () -> (index)
  kernel.launch.config workgroups(%n_rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %is_bf16 = scalar.constant false : i1
  func.call @inkling_dense_gemv_split_body(%is_bf16, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (i1, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

// Subgroup sum of one column, activation and store by the first lane. All lanes of the subgroup call this.
func.def public inline @inkling_dense_rows_finish(%acc: vector<4xf32>, %col: index, %live: index, %last_live: index, %is_lane0: i1, %dst: buffer, %d_origin: offset, %d_stride: index, %n_rows: index, %row: index, %act: index, %cap: f32) {
  %zero = scalar.constant 0.0 : f32
  %lane_sum = vector.reduce<addf> %acc, %zero : vector<4xf32>, f32
  %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
  %store = index.cmp ult, %col, %live : index
  %go = scalar.andi %is_lane0, %store : i1
  scf.if %go {
    %y = func.call @inkling_dense_epilogue(%sum, %act, %cap) : (f32, index, f32) -> (f32)
    %d_col = func.call @inkling_dense_col_origin(%d_origin, %col, %last_live, %d_stride) : (offset, index, index, index) -> (offset)
    func.call @inkling_dense_store(%dst, %d_col, %n_rows, %row, %y) : (buffer, offset, index, index, f32)
  }
  func.return
}

func.def public inline @inkling_dense_gemv_rows_body(%is_bf16: i1, %n_rows_in: index, %k_size_in: index, %control: buffer, %count_origin: offset, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %dst: buffer) {
  %k_size = index.assume %k_size_in [range(%k_size_in, 4, 16384), multiple_of(%k_size_in, 4)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_tile = config.get @inkling.dense.gemv.cols : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %wg = kernel.workgroup.id<x> : index
  %wave0 = kernel.subgroup.id : index
  %lane0 = kernel.subgroup.lane.id : index
  %size = kernel.subgroup.size : index
  %waves = kernel.subgroup.count : index
  %wave = index.assume %wave0 [range(%wave0, 0, 15)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 63)] : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %row = index.madd %wg, %waves, %wave : index
  %row_in = index.cmp ult, %row, %n_rows : index
  scf.if %row_in {
    %live0 = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
    %live = index.min %live0, %n_tile : index
    %live_floor = index.max %live, %c1 : index
    %last_live = index.sub %live_floor, %c1 : index
    %unit_shift = scf.if %is_bf16 -> (index) {
      scf.yield %c1 : index
    } else {
      scf.yield %c2 : index
    }
    %row_elems = index.mul %row, %k_size : index
    %row_bytes = index.shli %row_elems, %unit_shift : index
    %row_bytes_o = index.cast %row_bytes : index to offset
    %w_row_origin = index.add %w_origin, %row_bytes_o : offset
    %xo0 = func.call @inkling_dense_col_origin(%x_origin, %c0, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo1 = func.call @inkling_dense_col_origin(%x_origin, %c1, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo2 = func.call @inkling_dense_col_origin(%x_origin, %c2, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo3 = func.call @inkling_dense_col_origin(%x_origin, %c3, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo4 = func.call @inkling_dense_col_origin(%x_origin, %c4, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo5 = func.call @inkling_dense_col_origin(%x_origin, %c5, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo6 = func.call @inkling_dense_col_origin(%x_origin, %c6, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %xo7 = func.call @inkling_dense_col_origin(%x_origin, %c7, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %use0 = index.cmp ult, %c0, %n_tile : index
    %use1 = index.cmp ult, %c1, %n_tile : index
    %use2 = index.cmp ult, %c2, %n_tile : index
    %use3 = index.cmp ult, %c3, %n_tile : index
    %use4 = index.cmp ult, %c4, %n_tile : index
    %use5 = index.cmp ult, %c5, %n_tile : index
    %use6 = index.cmp ult, %c6, %n_tile : index
    %use7 = index.cmp ult, %c7, %n_tile : index
    %e0 = index.mul %lane, %c4 : index
    %step = index.mul %size, %c4 : index
    %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7 = scf.for %e_raw = [%e0 to %k_size step %step](%s0 = %zero4 : vector<4xf32>, %s1 = %zero4 : vector<4xf32>, %s2 = %zero4 : vector<4xf32>, %s3 = %zero4 : vector<4xf32>, %s4 = %zero4 : vector<4xf32>, %s5 = %zero4 : vector<4xf32>, %s6 = %zero4 : vector<4xf32>, %s7 = %zero4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %e = index.assume %e_raw [range(%e_raw, 0, 2147483640)] : index
      %last = index.add %e, %c3 : index
      %fits = index.cmp ult, %last, %k_size : index
      %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 = scf.if %fits -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
        %w = func.call @inkling_dense_split_w4(%weight_noalias, %w_row_origin, %k_size, %e, %is_bf16) : (buffer, offset, index, index, i1) -> (vector<4xf32>)
        %n0 = func.call @inkling_dense_split_acc(%s0, %use0, %input_noalias, %xo0, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
        %n1 = func.call @inkling_dense_split_acc(%s1, %use1, %input_noalias, %xo1, %k_size, %e, %w) : (vector<4xf32>, i1, buffer, offset, index, index, vector<4xf32>) -> (vector<4xf32>)
