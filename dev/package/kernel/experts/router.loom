// Router: logits = x . Wr (f32), then sigmoid, selection bias, top 8, normalisation and the expert weight scale.
// inkling_router_logits also writes the f16 slot-order copy of x that the expert kernels read.

func.decl @inkling_x_pack(%v: vector<16xf16>) -> (vector<16xf16>)

// Workgroup (row group of 4 rows, token group of 4 tokens), 4 waves, one row per wave.
kernel.def export("inkling_router_logits") @inkling_router_logits(%n: index) {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %rounded = index.add %n, %c3 : index
  %groups = index.div %rounded, %c4 : index
  kernel.launch.config workgroups(%c32, %groups, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%n: index, %x: buffer, %rw: buffer, %logits: buffer, %x16: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c18 = index.constant 18 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c2304 = index.constant 2304 : index
  %origin = index.constant 0 : offset
  %gx = kernel.workgroup.id<x> : index
  %gy = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %xv = buffer.view %x[%origin] : buffer -> view<[%n]x[%c2304]xf32>
  %t0 = index.mul %gy, %c4 : index
  %first = index.cmp eq, %gx, %c0 : index
  scf.if %first {
    %x16v = buffer.view %x16[%origin] : buffer -> view<[%n]x[%c2304]xf16>
    scf.for %j = [%c0 to %c4 step %c1] unroll schedule(linear) {
      %token_raw = index.add %t0, %j : index
      %live = index.cmp ult, %token_raw, %n : index
      scf.if %live {
        %token = index.assume %token_raw [ge(%token_raw, 0), lt(%token_raw, %n)] : index
        scf.for %u = [%tid to %c144 step %c128] {
          %e_raw = index.mul %u, %c16 : index
          %e = index.assume %e_raw [ge(%e_raw, 0), le(%e_raw, 2288)] : index
          %e1 = index.add %e, %c4 : index
          %e2 = index.add %e, %c8 : index
          %e3 = index.add %e, %c12 : index
          %v0 = vector.load %xv[%token, %e] : view<[%n]x[%c2304]xf32> -> vector<4xf32>
          %v1 = vector.load %xv[%token, %e1] : view<[%n]x[%c2304]xf32> -> vector<4xf32>
          %v2 = vector.load %xv[%token, %e2] : view<[%n]x[%c2304]xf32> -> vector<4xf32>
          %v3 = vector.load %xv[%token, %e3] : view<[%n]x[%c2304]xf32> -> vector<4xf32>
          %h0 = vector.fptrunc %v0 : vector<4xf32> to vector<4xf16>
          %h1 = vector.fptrunc %v1 : vector<4xf32> to vector<4xf16>
          %h2 = vector.fptrunc %v2 : vector<4xf32> to vector<4xf16>
          %h3 = vector.fptrunc %v3 : vector<4xf32> to vector<4xf16>
          %a0 = vector.extract %h0[0] : vector<4xf16> -> f16
          %a1 = vector.extract %h0[1] : vector<4xf16> -> f16
          %a2 = vector.extract %h0[2] : vector<4xf16> -> f16
          %a3 = vector.extract %h0[3] : vector<4xf16> -> f16
          %b0 = vector.extract %h1[0] : vector<4xf16> -> f16
          %b1 = vector.extract %h1[1] : vector<4xf16> -> f16
          %b2 = vector.extract %h1[2] : vector<4xf16> -> f16
          %b3 = vector.extract %h1[3] : vector<4xf16> -> f16
          %d0 = vector.extract %h2[0] : vector<4xf16> -> f16
          %d1 = vector.extract %h2[1] : vector<4xf16> -> f16
          %d2 = vector.extract %h2[2] : vector<4xf16> -> f16
          %d3 = vector.extract %h2[3] : vector<4xf16> -> f16
          %f0 = vector.extract %h3[0] : vector<4xf16> -> f16
          %f1 = vector.extract %h3[1] : vector<4xf16> -> f16
          %f2 = vector.extract %h3[2] : vector<4xf16> -> f16
          %f3 = vector.extract %h3[3] : vector<4xf16> -> f16
          %nat = vector.from_elements %a0, %a1, %a2, %a3, %b0, %b1, %b2, %b3, %d0, %d1, %d2, %d3, %f0, %f1, %f2, %f3 : vector<16xf16>
          %packed = func.call @inkling_x_pack(%nat) : (vector<16xf16>) -> (vector<16xf16>)
          vector.store %packed, %x16v[%token, %e] : vector<16xf16>, view<[%n]x[%c2304]xf16>
        }
      }
    }
  }
  %row_raw = index.madd %gx, %c4, %wave : index
  %row = index.assume %row_raw [ge(%row_raw, 0), lt(%row_raw, 128)] : index
  %wv = buffer.view %rw[%origin] : buffer -> view<128x2304xf32>
  %lv = buffer.view %logits[%origin] : buffer -> view<[%n]x128xf32>
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %zero = scalar.constant 0.0 : f32
  %a0, %a1, %a2, %a3 = scf.for %i = [%c0 to %c18 step %c1](%p0 = %zero4 : vector<4xf32>, %p1 = %zero4 : vector<4xf32>, %p2 = %zero4 : vector<4xf32>, %p3 = %zero4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %k = index.madd %i, %c32, %lane : index
    %k4_raw = index.mul %k, %c4 : index
    %k4 = index.assume %k4_raw [ge(%k4_raw, 0), le(%k4_raw, 2300)] : index
    %wrow = vector.load %wv[%row, %k4] : view<128x2304xf32> -> vector<4xf32>
    %r0, %r1, %r2, %r3 = scf.for %j = [%c0 to %c4 step %c1](%q0 = %p0 : vector<4xf32>, %q1 = %p1 : vector<4xf32>, %q2 = %p2 : vector<4xf32>, %q3 = %p3 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) unroll schedule(linear) {
      %token_raw = index.add %t0, %j : index
      %live = index.cmp ult, %token_raw, %n : index
      %token = index.assume %token_raw [ge(%token_raw, 0), le(%token_raw, 2147483646)] : index
      %xr = scf.if %live -> (vector<4xf32>) {
        %tk = index.assume %token_raw [ge(%token_raw, 0), lt(%token_raw, %n)] : index
        %xl = vector.load %xv[%tk, %k4] : view<[%n]x[%c2304]xf32> -> vector<4xf32>
        scf.yield %xl : vector<4xf32>
      } else {
        scf.yield %zero4 : vector<4xf32>
      }
      %c0j = index.cmp eq, %j, %c0 : index
      %c1j = index.cmp eq, %j, %c1 : index
      %c2j = index.constant 2 : index
      %cmp2 = index.cmp eq, %j, %c2j : index
      %m0 = vector.fmaf %wrow, %xr, %q0 : vector<4xf32>
      %m1 = vector.fmaf %wrow, %xr, %q1 : vector<4xf32>
      %m2 = vector.fmaf %wrow, %xr, %q2 : vector<4xf32>
      %m3 = vector.fmaf %wrow, %xr, %q3 : vector<4xf32>
      %n0 = scf.select %c0j, %m0, %q0 : vector<4xf32>
      %n1 = scf.select %c1j, %m1, %q1 : vector<4xf32>
      %n2 = scf.select %cmp2, %m2, %q2 : vector<4xf32>
      %c3j = index.cmp eq, %j, %c3 : index
      %n3 = scf.select %c3j, %m3, %q3 : vector<4xf32>
      scf.yield %n0, %n1, %n2, %n3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    scf.yield %r0, %r1, %r2, %r3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  %s0 = vector.reduce<addf> %a0, %zero : vector<4xf32>, f32
  %s1 = vector.reduce<addf> %a1, %zero : vector<4xf32>, f32
  %s2 = vector.reduce<addf> %a2, %zero : vector<4xf32>, f32
  %s3 = vector.reduce<addf> %a3, %zero : vector<4xf32>, f32
  %z0 = kernel.subgroup.reduce<addf> %s0 : f32
  %z1 = kernel.subgroup.reduce<addf> %s1 : f32
  %z2 = kernel.subgroup.reduce<addf> %s2 : f32
  %z3 = kernel.subgroup.reduce<addf> %s3 : f32
  %leader = index.cmp eq, %lane, %c0 : index
  scf.if %leader {
    %i0 = index.add %t0, %c0 : index
    %l0 = index.cmp ult, %i0, %n : index
    scf.if %l0 {
      %tk = index.assume %i0 [ge(%i0, 0), lt(%i0, %n)] : index
      view.store %z0, %lv[%tk, %row] : f32, view<[%n]x128xf32>
    }
    %i1 = index.add %t0, %c1 : index
    %l1 = index.cmp ult, %i1, %n : index
    scf.if %l1 {
      %tk = index.assume %i1 [ge(%i1, 0), lt(%i1, %n)] : index
      view.store %z1, %lv[%tk, %row] : f32, view<[%n]x128xf32>
    }
    %i2 = index.add %t0, %c2 : index
    %l2 = index.cmp ult, %i2, %n : index
    scf.if %l2 {
      %tk = index.assume %i2 [ge(%i2, 0), lt(%i2, %n)] : index
      view.store %z2, %lv[%tk, %row] : f32, view<[%n]x128xf32>
    }
    %i3 = index.add %t0, %c3 : index
    %l3 = index.cmp ult, %i3, %n : index
    scf.if %l3 {
      %tk = index.assume %i3 [ge(%i3, 0), lt(%i3, %n)] : index
      view.store %z3, %lv[%tk, %row] : f32, view<[%n]x128xf32>
    }
  }
  kernel.return
}

// One wave per token, four tokens per workgroup. A lane owns 4 consecutive experts. Ties go to the lower expert index.
kernel.def export("inkling_router_select") @inkling_router_select(%n: index) {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c128 = index.constant 128 : index
  %rounded = index.add %n, %c3 : index
  %groups = index.div %rounded, %c4 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%n: index, %logits: buffer, %bias: buffer, %ids: buffer, %wts: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %origin = index.constant 0 : offset
  %gx = kernel.workgroup.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %token_raw = index.madd %gx, %c4, %wave : index
  %live = index.cmp ult, %token_raw, %n : index
  scf.if %live {
    %token = index.assume %token_raw [ge(%token_raw, 0), lt(%token_raw, %n)] : index
    %lv = buffer.view %logits[%origin] : buffer -> view<[%n]x128xf32>
    %bv = buffer.view %bias[%origin] : buffer -> view<128xf32>
    %idv = buffer.view %ids[%origin] : buffer -> view<[%n]x8xi32>
    %wv = buffer.view %wts[%origin] : buffer -> view<[%n]x8xf32>
    %e0_raw = index.mul %lane, %c4 : index
    %e0 = index.assume %e0_raw [ge(%e0_raw, 0), le(%e0_raw, 124)] : index
    %l4 = vector.load %lv[%token, %e0] : view<[%n]x128xf32> -> vector<4xf32>
    %b4 = vector.load %bv[%e0] : view<128xf32> -> vector<4xf32>
    %p4 = vector.logisticf<afn> %l4 : vector<4xf32>
    %sel4 = vector.addf %p4, %b4 : vector<4xf32>
    %ninf = scalar.constant -3.4028234663852886e+38 : f32
    %big = scalar.constant 1000 : i32
    %zero = scalar.constant 0.0 : f32
    %zero8 = vector.splatf 0.0 : vector<8xf32>
    %izero8 = vector.splati 0 : vector<8xi32>
    %base32 = index.cast %e0 : index to i32
    %sel_final, %pw, %pid = scf.for %r = [%c0 to %c8 step %c1](%sel = %sel4 : vector<4xf32>, %pv = %zero8 : vector<8xf32>, %iv = %izero8 : vector<8xi32>) -> (vector<4xf32>, vector<8xf32>, vector<8xi32>) unroll schedule(linear) {
      %s0 = vector.extract %sel[0] : vector<4xf32> -> f32
      %s1 = vector.extract %sel[1] : vector<4xf32> -> f32
      %s2 = vector.extract %sel[2] : vector<4xf32> -> f32
      %s3 = vector.extract %sel[3] : vector<4xf32> -> f32
      %g01 = scalar.cmpf ogt, %s1, %s0 : f32
      %v01 = scf.select %g01, %s1, %s0 : f32
      %k0 = scalar.constant 0 : i32
      %k1 = scalar.constant 1 : i32
      %k2 = scalar.constant 2 : i32
      %k3 = scalar.constant 3 : i32
      %i01 = scf.select %g01, %k1, %k0 : i32
      %g23 = scalar.cmpf ogt, %s3, %s2 : f32
      %v23 = scf.select %g23, %s3, %s2 : f32
      %i23 = scf.select %g23, %k3, %k2 : i32
      %g = scalar.cmpf ogt, %v23, %v01 : f32
      %bv_local = scf.select %g, %v23, %v01 : f32
      %bi_local = scf.select %g, %i23, %i01 : i32
      %m = kernel.subgroup.reduce<maxnumf> %bv_local : f32
      %hit = scalar.cmpf oeq, %bv_local, %m : f32
      %gi = scalar.addi %base32, %bi_local : i32
      %cand = scf.select %hit, %gi, %big : i32
      %win = kernel.subgroup.reduce<minui> %cand : i32
      %rel = scalar.subi %win, %base32 : i32
      %p0 = vector.extract %p4[0] : vector<4xf32> -> f32
      %p1 = vector.extract %p4[1] : vector<4xf32> -> f32
      %p2 = vector.extract %p4[2] : vector<4xf32> -> f32
      %p3 = vector.extract %p4[3] : vector<4xf32> -> f32
      %is0 = scalar.cmpi eq, %rel, %k0 : i32
      %is1 = scalar.cmpi eq, %rel, %k1 : i32
      %is2 = scalar.cmpi eq, %rel, %k2 : i32
      %is3 = scalar.cmpi eq, %rel, %k3 : i32
      %q0 = scf.select %is0, %p0, %zero : f32
      %q1 = scf.select %is1, %p1, %q0 : f32
      %q2 = scf.select %is2, %p2, %q1 : f32
      %q3 = scf.select %is3, %p3, %q2 : f32
      %pwin = kernel.subgroup.reduce<addf> %q3 : f32
      %n0 = scf.select %is0, %ninf, %s0 : f32
      %n1 = scf.select %is1, %ninf, %s1 : f32
      %n2 = scf.select %is2, %ninf, %s2 : f32
      %n3 = scf.select %is3, %ninf, %s3 : f32
      %ns = vector.from_elements %n0, %n1, %n2, %n3 : vector<4xf32>
      %pv2 = vector.insert %pwin into %pv[%r] : f32, vector<8xf32>
      %iv2 = vector.insert %win into %iv[%r] : i32, vector<8xi32>
      scf.yield %ns, %pv2, %iv2 : vector<4xf32>, vector<8xf32>, vector<8xi32>
    }
    %total = vector.reduce<addf> %pw, %zero : vector<8xf32>, f32
    %eps = scalar.constant 1.0e-20 : f32
    %den = scalar.addf %total, %eps : f32
    %scale = scalar.constant 8.0 : f32
    %leader = index.cmp eq, %lane, %c0 : index
    scf.if %leader {
      scf.for %r = [%c0 to %c8 step %c1] unroll schedule(linear) {
        %p = vector.extract %pw[%r] : vector<8xf32> -> f32
        %id = vector.extract %pid[%r] : vector<8xi32> -> i32
        %q = scalar.divf %p, %den : f32
        %w = scalar.mulf %q, %scale : f32
        view.store %id, %idv[%token, %r] : i32, view<[%n]x8xi32>
        view.store %w, %wv[%token, %r] : f32, view<[%n]x8xf32>
      }
    }
  }
  kernel.return
}
