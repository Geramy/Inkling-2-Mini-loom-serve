// gate_up GEMV over route records, fused with the per-expert scale and SiTU. One 8-lane group per (gate row, up row) pair; a wave has 4 groups, a workgroup 4 waves.
// act[route][1152] = 4 tanh(g/4) sigmoid(g) 25 tanh(u/25) with g, u = scale[e] * dot(row, x[token]). The result is f16 in slot order.

func.decl @inkling_experts_records(%n: index) -> (index)
func.decl @inkling_experts_row_bytes(%wtype: index, %units: index) -> (offset)
func.decl @inkling_nvfp4_unit_raw(%w: buffer, %row: offset, %units: index, %unit: index) -> (i32, i32, i32)
func.decl @inkling_nvfp4_unit_decode(%scales: i32, %v0: i32, %v1: i32, %unit: index) -> (vector<16xf16>, f32)
func.decl @inkling_experts_unit_load(%wtype: index, %w: buffer, %row: offset, %units: index, %unit: index) -> (vector<16xf16>, f32)
func.decl @inkling_unit_dot(%codes: vector<16xf16>, %x: vector<16xf16>, %scale: f32) -> (f32)
func.decl @inkling_x_slot(%e: index) -> (index)

kernel.def export("inkling_experts_gate_up") @inkling_experts_gate_up(%n: index) {
  %c1 = index.constant 1 : index
  %c72 = index.constant 72 : index
  %c128 = index.constant 128 : index
  %records = func.call pure @inkling_experts_records(%n) : (index) -> (index)
  kernel.launch.config workgroups(%c72, %records, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%n: index, %wtype: index, %x: buffer, %tasks: buffer, %w: buffer, %scales: buffer, %act: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c18 = index.constant 18 : index
  %c1152 = index.constant 1152 : index
  %c2304 = index.constant 2304 : index
  %c144 = index.constant 144 : index
  %origin = index.constant 0 : offset
  %records_origin = index.constant 16 : offset
  %two = index.constant 2 : offset
  %rec_raw = kernel.workgroup.id<y> : index
  %gx = kernel.workgroup.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %group = index.div %lane, %c8 : index
  %lr = index.rem %lane, %c8 : index
  %capacity = func.call pure @inkling_experts_records(%n) : (index) -> (index)
  %routes = index.mul %n, %c8 : index
  %rec = index.assume %rec_raw [ge(%rec_raw, 0), lt(%rec_raw, %capacity)] : index
  %header = buffer.view %tasks[%origin] : buffer -> view<1xi32>
  %count32 = view.load %header[0] : view<1xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live_record = index.cmp ult, %rec, %count : index
  scf.if %live_record {
    %table = buffer.view %tasks[%records_origin] : buffer -> view<[%capacity]x34xi32>
    %expert32 = view.load %table[%rec, 0] : view<[%capacity]x34xi32> -> i32
    %live32 = view.load %table[%rec, 1] : view<[%capacity]x34xi32> -> i32
    %expert_raw = index.cast %expert32 : i32 to index
    %live_raw = index.cast %live32 : i32 to index
    %expert = index.assume %expert_raw [ge(%expert_raw, 0), lt(%expert_raw, 128)] : index
    %live = index.assume %live_raw [ge(%live_raw, 0), le(%live_raw, 8)] : index
    %pair_base = index.mul %gx, %c16 : index
    %wave_pair = index.mul %wave, %c4 : index
    %pair0 = index.add %pair_base, %wave_pair : index
    %pair = index.add %pair0, %group : index
    %row_bytes = func.call @inkling_experts_row_bytes(%wtype, %c144) : (index, index) -> (offset)
    %expert_rows = index.mul %expert, %c2304 : index
    %gate_row = index.add %expert_rows, %pair : index
    %up_row0 = index.add %gate_row, %c1152 : index
    %gate_byte = index.scale %gate_row, %row_bytes : index, offset -> offset
    %up_byte = index.scale %up_row0, %row_bytes : index, offset -> offset
    %zero8 = vector.splatf 0.0 : vector<8xf32>
    %xv = buffer.view %x[%origin] : buffer -> view<[%n]x[%c2304]xf16>
    // Fast path: NVFP4 and one live route. The loads of the next two units are issued before the current units are decoded. The sums have the same order as in the generic loop.
    %cN_last = index.constant 8 : index
    %tag = index.madd %wtype, %c16, %live : index
    %fast = index.cmp eq, %tag, %c1 : index
    %gacc, %uacc = scf.if %fast -> (vector<8xf32>, vector<8xf32>) {
      %route_f32 = view.load %table[%rec, %c2] : view<[%capacity]x34xi32> -> i32
      %route_f_raw = index.cast %route_f32 : i32 to index
      %route_f = index.assume %route_f_raw [ge(%route_f_raw, 0), lt(%route_f_raw, %routes)] : index
      %token_f_raw = index.div %route_f, %c8 : index
      %token_f = index.assume %token_f_raw [ge(%token_f_raw, 0), lt(%token_f_raw, %n)] : index
      %cG = index.constant 2 : index
      %cN = index.constant 9 : index
      %k8_0 = index.constant 0 : index
      %u0_0 = index.add %lr, %k8_0 : index
      %pre_a0, %pre_b0, %pre_c0 = func.call @inkling_nvfp4_unit_raw(%w, %gate_byte, %c144, %u0_0) : (buffer, offset, index, index) -> (i32, i32, i32)
      %pre_d0, %pre_e0, %pre_f0 = func.call @inkling_nvfp4_unit_raw(%w, %up_byte, %c144, %u0_0) : (buffer, offset, index, index) -> (i32, i32, i32)
      %ef0 = index.mul %u0_0, %c16 : index
      %efa0 = index.assume %ef0 [ge(%ef0, 0), le(%ef0, 2288)] : index
      %x0_0 = vector.load %xv[%token_f, %efa0] : view<[%n]x[%c2304]xf16> -> vector<16xf16>
      %k8_1 = index.constant 8 : index
      %u0_1 = index.add %lr, %k8_1 : index
      %pre_a1, %pre_b1, %pre_c1 = func.call @inkling_nvfp4_unit_raw(%w, %gate_byte, %c144, %u0_1) : (buffer, offset, index, index) -> (i32, i32, i32)
      %pre_d1, %pre_e1, %pre_f1 = func.call @inkling_nvfp4_unit_raw(%w, %up_byte, %c144, %u0_1) : (buffer, offset, index, index) -> (i32, i32, i32)
      %ef1 = index.mul %u0_1, %c16 : index
      %efa1 = index.assume %ef1 [ge(%ef1, 0), le(%ef1, 2288)] : index
      %x0_1 = vector.load %xv[%token_f, %efa1] : view<[%n]x[%c2304]xf16> -> vector<16xf16>
      %zero_f = scalar.constant 0.0 : f32
      %fg, %fu, %r_ga0, %r_gb0, %r_gc0, %r_ua0, %r_ub0, %r_uc0, %r_cx0, %r_ga1, %r_gb1, %r_gc1, %r_ua1, %r_ub1, %r_uc1, %r_cx1 = scf.for %i = [%c0 to %cN step %c1](%pg = %zero_f : f32, %pu = %zero_f : f32, %ga0 = %pre_a0 : i32, %gb0 = %pre_b0 : i32, %gc0 = %pre_c0 : i32, %ua0 = %pre_d0 : i32, %ub0 = %pre_e0 : i32, %uc0 = %pre_f0 : i32, %cx0 = %x0_0 : vector<16xf16>, %ga1 = %pre_a1 : i32, %gb1 = %pre_b1 : i32, %gc1 = %pre_c1 : i32, %ua1 = %pre_d1 : i32, %ub1 = %pre_e1 : i32, %uc1 = %pre_f1 : i32, %cx1 = %x0_1 : vector<16xf16>) -> (f32, f32, i32, i32, i32, i32, i32, i32, vector<16xf16>, i32, i32, i32, i32, i32, i32, vector<16xf16>) {
        %i1 = index.add %i, %c1 : index
        %more = index.cmp ult, %i1, %cN : index
        %inext = scf.select %more, %i1, %cN_last : index
        %ig = index.mul %i, %cG : index
        %ing = index.mul %inext, %cG : index
        %ck0 = index.constant 0 : index
        %ia0 = index.add %ig, %ck0 : index
        %ib0 = index.mul %ia0, %c8 : index
        %unit0 = index.add %ib0, %lr : index
        %na0 = index.add %ing, %ck0 : index
        %nb0 = index.mul %na0, %c8 : index
        %unit_n0 = index.add %nb0, %lr : index
        %ck1 = index.constant 1 : index
        %ia1 = index.add %ig, %ck1 : index
        %ib1 = index.mul %ia1, %c8 : index
        %unit1 = index.add %ib1, %lr : index
        %na1 = index.add %ing, %ck1 : index
        %nb1 = index.mul %na1, %c8 : index
        %unit_n1 = index.add %nb1, %lr : index
        %n_a0, %n_b0, %n_c0 = func.call @inkling_nvfp4_unit_raw(%w, %gate_byte, %c144, %unit_n0) : (buffer, offset, index, index) -> (i32, i32, i32)
        %n_d0, %n_e0, %n_f0 = func.call @inkling_nvfp4_unit_raw(%w, %up_byte, %c144, %unit_n0) : (buffer, offset, index, index) -> (i32, i32, i32)
        %en_raw0 = index.mul %unit_n0, %c16 : index
        %en0 = index.assume %en_raw0 [ge(%en_raw0, 0), le(%en_raw0, 2288)] : index
        %xn0 = vector.load %xv[%token_f, %en0] : view<[%n]x[%c2304]xf16> -> vector<16xf16>
        %n_a1, %n_b1, %n_c1 = func.call @inkling_nvfp4_unit_raw(%w, %gate_byte, %c144, %unit_n1) : (buffer, offset, index, index) -> (i32, i32, i32)
        %n_d1, %n_e1, %n_f1 = func.call @inkling_nvfp4_unit_raw(%w, %up_byte, %c144, %unit_n1) : (buffer, offset, index, index) -> (i32, i32, i32)
        %en_raw1 = index.mul %unit_n1, %c16 : index
        %en1 = index.assume %en_raw1 [ge(%en_raw1, 0), le(%en_raw1, 2288)] : index
        %xn1 = vector.load %xv[%token_f, %en1] : view<[%n]x[%c2304]xf16> -> vector<16xf16>
        %gcodes0, %gscale0 = func.call @inkling_nvfp4_unit_decode(%ga0, %gb0, %gc0, %unit0) : (i32, i32, i32, index) -> (vector<16xf16>, f32)
        %ucodes0, %uscale0 = func.call @inkling_nvfp4_unit_decode(%ua0, %ub0, %uc0, %unit0) : (i32, i32, i32, index) -> (vector<16xf16>, f32)
        %dg0 = func.call @inkling_unit_dot(%gcodes0, %cx0, %gscale0) : (vector<16xf16>, vector<16xf16>, f32) -> (f32)
        %du0 = func.call @inkling_unit_dot(%ucodes0, %cx0, %uscale0) : (vector<16xf16>, vector<16xf16>, f32) -> (f32)
        %sg0 = scalar.addf %pg, %dg0 : f32
        %su0 = scalar.addf %pu, %du0 : f32
        %gcodes1, %gscale1 = func.call @inkling_nvfp4_unit_decode(%ga1, %gb1, %gc1, %unit1) : (i32, i32, i32, index) -> (vector<16xf16>, f32)
        %ucodes1, %uscale1 = func.call @inkling_nvfp4_unit_decode(%ua1, %ub1, %uc1, %unit1) : (i32, i32, i32, index) -> (vector<16xf16>, f32)
        %dg1 = func.call @inkling_unit_dot(%gcodes1, %cx1, %gscale1) : (vector<16xf16>, vector<16xf16>, f32) -> (f32)
        %du1 = func.call @inkling_unit_dot(%ucodes1, %cx1, %uscale1) : (vector<16xf16>, vector<16xf16>, f32) -> (f32)
        %sg1 = scalar.addf %sg0, %dg1 : f32
        %su1 = scalar.addf %su0, %du1 : f32
        scf.yield %sg1, %su1, %n_a0, %n_b0, %n_c0, %n_d0, %n_e0, %n_f0, %xn0, %n_a1, %n_b1, %n_c1, %n_d1, %n_e1, %n_f1, %xn1 : f32, f32, i32, i32, i32, i32, i32, i32, vector<16xf16>, i32, i32, i32, i32, i32, i32, vector<16xf16>
      }
      %fg8 = vector.insert %fg into %zero8[0] : f32, vector<8xf32>
      %fu8 = vector.insert %fu into %zero8[0] : f32, vector<8xf32>
      scf.yield %fg8, %fu8 : vector<8xf32>, vector<8xf32>
    } else {
      %ngv, %nuv = scf.for %i = [%c0 to %c18 step %c1](%ga = %zero8 : vector<8xf32>, %ua = %zero8 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
        %i8 = index.mul %i, %c8 : index
        %unit = index.add %i8, %lr : index
        %gcodes, %gscale = func.call @inkling_experts_unit_load(%wtype, %w, %gate_byte, %c144, %unit) : (index, buffer, offset, index, index) -> (vector<16xf16>, f32)
        %ucodes, %uscale = func.call @inkling_experts_unit_load(%wtype, %w, %up_byte, %c144, %unit) : (index, buffer, offset, index, index) -> (vector<16xf16>, f32)
        %elem_raw = index.mul %unit, %c16 : index
        %elem0 = index.assume %elem_raw [ge(%elem_raw, 0), le(%elem_raw, 2288)] : index
        %ng, %nu = scf.for %t = [%c0 to %c8 step %c1](%g = %ga : vector<8xf32>, %u = %ua : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll schedule(linear) {
          %active = index.cmp ult, %t, %live : index
          %pg = vector.extract %g[%t] : vector<8xf32> -> f32
          %pu = vector.extract %u[%t] : vector<8xf32> -> f32
          %rg, %ru = scf.if %active -> (f32, f32) {
            %field = index.add %t, %c2 : index
            %route32 = view.load %table[%rec, %field] : view<[%capacity]x34xi32> -> i32
            %route_raw = index.cast %route32 : i32 to index
            %route = index.assume %route_raw [ge(%route_raw, 0), lt(%route_raw, %routes)] : index
            %token_raw = index.div %route, %c8 : index
            %token = index.assume %token_raw [ge(%token_raw, 0), lt(%token_raw, %n)] : index
            %xr = vector.load %xv[%token, %elem0] : view<[%n]x[%c2304]xf16> -> vector<16xf16>
            %dg = func.call @inkling_unit_dot(%gcodes, %xr, %gscale) : (vector<16xf16>, vector<16xf16>, f32) -> (f32)
            %du = func.call @inkling_unit_dot(%ucodes, %xr, %uscale) : (vector<16xf16>, vector<16xf16>, f32) -> (f32)
            %sg = scalar.addf %pg, %dg : f32
            %su = scalar.addf %pu, %du : f32
            scf.yield %sg, %su : f32, f32
          } else {
            scf.yield %pg, %pu : f32, f32
          }
          %g2 = vector.insert %rg into %g[%t] : f32, vector<8xf32>
          %u2 = vector.insert %ru into %u[%t] : f32, vector<8xf32>
          scf.yield %g2, %u2 : vector<8xf32>, vector<8xf32>
        }
        scf.yield %ng, %nu : vector<8xf32>, vector<8xf32>
      }
      scf.yield %ngv, %nuv : vector<8xf32>, vector<8xf32>
    }
    %gsum = kernel.subgroup.reduce<addf> %gacc {cluster_size = 8} : vector<8xf32>
    %usum = kernel.subgroup.reduce<addf> %uacc {cluster_size = 8} : vector<8xf32>
    %leader = index.cmp eq, %lr, %c0 : index
    scf.if %leader {
      %is_fp4 = index.cmp eq, %wtype, %c0 : index
      %sv = buffer.view %scales[%origin] : buffer -> view<128xf32>
      %es = view.load %sv[%expert] : view<128xf32> -> f32
      %one = scalar.constant 1.0 : f32
      %outer = scf.select %is_fp4, %es, %one : f32
      %av = buffer.view %act[%origin] : buffer -> view<[%routes]x[%c1152]xf16>
      %b4 = scalar.constant 4.0 : f32
      %b25 = scalar.constant 25.0 : f32
      %q4 = scalar.constant 0.25 : f32
      %q25 = scalar.constant 0.04 : f32
      %unit = index.div %pair, %c16 : index
      %element = index.rem %pair, %c16 : index
      %slot = func.call @inkling_x_slot(%element) : (index) -> (index)
      %unit16 = index.mul %unit, %c16 : index
      %column_raw = index.add %unit16, %slot : index
      %column = index.assume %column_raw [ge(%column_raw, 0), lt(%column_raw, 1152)] : index
      scf.for %t = [%c0 to %c8 step %c1] unroll schedule(linear) {
        %active = index.cmp ult, %t, %live : index
        scf.if %active {
          %field = index.add %t, %c2 : index
          %route32 = view.load %table[%rec, %field] : view<[%capacity]x34xi32> -> i32
          %route_raw = index.cast %route32 : i32 to index
          %route = index.assume %route_raw [ge(%route_raw, 0), lt(%route_raw, %routes)] : index
          %graw = vector.extract %gsum[%t] : vector<8xf32> -> f32
          %uraw = vector.extract %usum[%t] : vector<8xf32> -> f32
          %g = scalar.mulf %graw, %outer : f32
          %u = scalar.mulf %uraw, %outer : f32
          %gq = scalar.mulf %g, %q4 : f32
          %gt = scalar.tanhf<afn> %gq : f32
          %gs = scalar.logisticf<afn> %g : f32
          %g4 = scalar.mulf %gt, %b4 : f32
          %gate = scalar.mulf %g4, %gs : f32
          %uq = scalar.mulf %u, %q25 : f32
          %ut = scalar.tanhf<afn> %uq : f32
          %up = scalar.mulf %ut, %b25 : f32
          %value = scalar.mulf %gate, %up : f32
          %h = scalar.fptrunc %value : f32 to f16
          view.store %h, %av[%route, %column] : f16, view<[%routes]x[%c1152]xf16>
        }
      }
    }
  }
  kernel.return
}
