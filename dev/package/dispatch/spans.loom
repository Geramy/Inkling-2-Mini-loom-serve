config.decl @inkling.tokens : %value: index where [range(%value, 1, 2147483647)]

config.decl @inkling.spans : %value: index where [range(%value, 1, 2147483647)]

config.decl @inkling.packet_capacity : %value: index where [range(%value, 2, 2147483646)]

target.decl @target

// Span table: four header words {span count, live tokens, 0, 0}, then eight words per span {first token, length, read slot lo, read slot hi, write slot lo, write slot hi, position, row}.
// Slot words are arena byte offsets of the row recurrent region. Token map: four words per token {span, row, position, index in span}.
kernel.def target(@target) @inkling_prep_spans() {
  %spans = config.get @inkling.spans : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%spans, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%metadata: buffer, %origins: buffer, %span_table: buffer, %token_map: buffer) {
  %spans = config.get @inkling.spans : index
  %tokens = config.get @inkling.tokens : index
  %packet = config.get @inkling.packet_capacity : index
  %span = kernel.workgroup.id<x> : index
  %item = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : offset
  %c12 = index.constant 12 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<3xi32>
  %live_tokens = view.load %header[0] : view<3xi32> -> i32
  %live_spans = view.load %header[1] : view<3xi32> -> i32
  %count = index.cast %live_spans : i32 to index
  %live = index.cmp ult, %span, %count : index
  %descriptors = buffer.view %metadata[%c12] : buffer -> view<[%packet]x6xi32>
  %table_header = buffer.view %span_table[%origin] : buffer -> view<4xi32>
  %table = buffer.view %span_table[%c16] : buffer -> view<[%spans]x8xi32>
  %map = buffer.view %token_map[%origin] : buffer -> view<[%tokens]x4xi32>
  %c0_i32 = scalar.constant 0 : i32
  %lead = index.cmp eq, %span, %c0 : index
  %first_item = index.cmp eq, %item, %c0 : index
  %writes_header = scalar.andi %lead, %first_item : i1
  scf.if %writes_header {
    view.store %live_spans, %table_header[0] : i32, view<4xi32>
    view.store %live_tokens, %table_header[1] : i32, view<4xi32>
    view.store %c0_i32, %table_header[2] : i32, view<4xi32>
    view.store %c0_i32, %table_header[3] : i32, view<4xi32>
  }
  scf.if %live {
    %bounded_span = index.assume %span [range(%span, 0, 2147483646), lt(%span, %packet)] : index
    %length32 = view.load %descriptors[%bounded_span, 0] : view<[%packet]x6xi32> -> i32
    %position32 = view.load %descriptors[%bounded_span, 1] : view<[%packet]x6xi32> -> i32
    %cursor32 = view.load %descriptors[%bounded_span, 2] : view<[%packet]x6xi32> -> i32
    %row32 = view.load %descriptors[%bounded_span, 3] : view<[%packet]x6xi32> -> i32
    %length = index.cast %length32 : i32 to index
    %cursor = index.cast %cursor32 : i32 to index
    scf.if %first_item {
      %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
      %row_value = index.cast %row_bound : i32 to index
      %row = index.assume %row_value [range(%row_value, 0, 2147483646)] : index
      %record_stride = index.constant 40 : offset
      %record_offset = index.scale %row, %record_stride : index, offset -> offset
      %records = buffer.view %origins[%record_offset] : buffer -> view<5xi64>
      %read64 = view.load %records[0] : view<5xi64> -> i64
      %write64 = view.load %records[1] : view<5xi64> -> i64
      %fork64 = view.load %records[3] : view<5xi64> -> i64
      %position64 = scalar.extui %position32 : i32 to i64
      %fork = scalar.cmpi eq, %position64, %fork64 : i64
      %reader64 = scf.select %fork, %read64, %write64 : i64
      %c32 = scalar.constant 32 : i64
      %read_lo = scalar.trunci %reader64 : i64 to i32
      %read_shifted = scalar.shrui %reader64, %c32 : i64
      %read_hi = scalar.trunci %read_shifted : i64 to i32
      %write_lo = scalar.trunci %write64 : i64 to i32
      %write_shifted = scalar.shrui %write64, %c32 : i64
      %write_hi = scalar.trunci %write_shifted : i64 to i32
      view.store %cursor32, %table[%bounded_span, 0] : i32, view<[%spans]x8xi32>
      view.store %length32, %table[%bounded_span, 1] : i32, view<[%spans]x8xi32>
      view.store %read_lo, %table[%bounded_span, 2] : i32, view<[%spans]x8xi32>
      view.store %read_hi, %table[%bounded_span, 3] : i32, view<[%spans]x8xi32>
      view.store %write_lo, %table[%bounded_span, 4] : i32, view<[%spans]x8xi32>
      view.store %write_hi, %table[%bounded_span, 5] : i32, view<[%spans]x8xi32>
      view.store %position32, %table[%bounded_span, 6] : i32, view<[%spans]x8xi32>
      view.store %row32, %table[%bounded_span, 7] : i32, view<[%spans]x8xi32>
    }
    %c64 = index.constant 64 : index
    scf.for %j = [%item to %length step %c64] {
      %slot_value = index.add %cursor, %j : index
      %slot = index.assume %slot_value [range(%slot_value, 0, 2147483646), lt(%slot_value, %tokens)] : index
      %index32 = index.cast %j : index to i32
      %absolute = scalar.addi %position32, %index32 : i32
      %span32 = index.cast %span : index to i32
      view.store %span32, %map[%slot, 0] : i32, view<[%tokens]x4xi32>
      view.store %row32, %map[%slot, 1] : i32, view<[%tokens]x4xi32>
      view.store %absolute, %map[%slot, 2] : i32, view<[%tokens]x4xi32>
      view.store %index32, %map[%slot, 3] : i32, view<[%tokens]x4xi32>
    }
  }
  kernel.return
}
