// Registry of kernel hooks and the visit command. Every hook takes the visit coordinates as command specializations and the same 20 buffers (docs/DISPATCH.md).
// Buffers: parameters, span_table, token_map, metadata, origins, arena, cur, blocks, bank, x, xn, small, q, k, v, r, gate, ab, ob, y.
command.decl @inkling_hook_mix_attn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_mix_msg(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_ctrl_qkv(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_norm_in(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_proj(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_attn_prep(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_attn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_oproj(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_post_attn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_mix_ffn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_ctrl_ffn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_norm_ffn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_router(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_experts(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

command.decl @inkling_hook_post_ffn(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer)

func.decl pure @inkling_layer_is_global(%layer: index) -> (i1)

func.decl pure @inkling_layer_in_loop(%layer: index) -> (i1)

config.decl @inkling.capture_id : %value: index where [range(%value, 0, 1024)]

config.decl @inkling.capture_visit : %value: index where [range(%value, 0, 47)]

config.decl @inkling.capture_width : %value: index where [range(%value, 1, 1048576)]

config.decl @inkling.stop_after : %value: index where [range(%value, 0, 1000)]

kernel.decl @inkling_capture_rows() launch(%src_width: index, %col: index, %half: index, %metadata: buffer, %src: buffer, %residual: buffer)

// Debug capture of a shared tensor at one visit. Capture id 99 copies every tensor of the table below into its column range (total width 33432); another id copies only the tensor with that id into column 0.
command.def @inkling_capture_point(%id: index, %visit: index, %src_width: index, %col: index, %half: index) launch(%metadata: buffer, %src: buffer, %residual: buffer) {
  %capture = config.get @inkling.capture_id : index
  %capture_visit = config.get @inkling.capture_visit : index
  %c0 = index.constant 0 : index
  %c99 = index.constant 99 : index
  %all = index.cmp eq, %capture, %c99 : index
  %id_match = index.cmp eq, %capture, %id : index
  %any_id = scalar.ori %all, %id_match : i1
  %visit_match = index.cmp eq, %capture_visit, %visit : index
  %selected = scalar.andi %any_id, %visit_match : i1
  scf.if %selected {
    %column = scf.select %all, %col, %c0 : index
    kernel.launch @inkling_capture_rows(%src_width, %column, %half, %metadata, %src, %residual) : (index, index, index, buffer, buffer, buffer)
  }
  command.return
}

// One layer visit. The visit coordinates are exact specializations, so global or local attention, loop controllers and expert weight types resolve while the command is planned.
command.def public @inkling_visit(%layer: index, %visit: index, %pass: index) launch(%parameters: buffer, %span_table: buffer, %token_map: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %cur: buffer, %blocks: buffer, %bank: buffer, %x: buffer, %xn: buffer, %small: buffer, %q: buffer, %k: buffer, %v: buffer, %r: buffer, %gate: buffer, %ab: buffer, %ob: buffer, %y: buffer, %residual: buffer) {
  %global = func.call pure @inkling_layer_is_global(%layer) : (index) -> (i1)
  %in_loop = func.call pure @inkling_layer_in_loop(%layer) : (index) -> (i1)
  %c0 = index.constant 0 : index
  %later = index.cmp ugt, %pass, %c0 : index
  %controlled = scalar.andi %in_loop, %later : i1
  %k0 = index.constant 0 : index
  %k1 = index.constant 1 : index
  %k2 = index.constant 2 : index
  %k3 = index.constant 3 : index
  %k4 = index.constant 4 : index
  %k5 = index.constant 5 : index
  %k6 = index.constant 6 : index
  %k7 = index.constant 7 : index
  %k8 = index.constant 8 : index
  %k9 = index.constant 9 : index
  %k10 = index.constant 10 : index
  %k11 = index.constant 11 : index
  %k12 = index.constant 12 : index
  %k13 = index.constant 13 : index
  %k14 = index.constant 14 : index
  %k15 = index.constant 15 : index
  %k16 = index.constant 16 : index
  %k17 = index.constant 17 : index
  %k18 = index.constant 18 : index
  %k19 = index.constant 19 : index
  %k20 = index.constant 20 : index
  %k21 = index.constant 21 : index
  %k22 = index.constant 22 : index
  %k23 = index.constant 23 : index
  %k24 = index.constant 24 : index
  %k25 = index.constant 25 : index
  %k27 = index.constant 27 : index
  %k28 = index.constant 28 : index
  %k29 = index.constant 29 : index
  %k128 = index.constant 128 : index
  %k384 = index.constant 384 : index
  %k1024 = index.constant 1024 : index
  %k2304 = index.constant 2304 : index
  %k3072 = index.constant 3072 : index
  %k4608 = index.constant 4608 : index
  %k7680 = index.constant 7680 : index
  %k8704 = index.constant 8704 : index
  %k9728 = index.constant 9728 : index
  %k10112 = index.constant 10112 : index
  %k13184 = index.constant 13184 : index
  %k13208 = index.constant 13208 : index
  %k16280 = index.constant 16280 : index
  %k17304 = index.constant 17304 : index
  %k18328 = index.constant 18328 : index
  %k18712 = index.constant 18712 : index
  %k21784 = index.constant 21784 : index
  %k24088 = index.constant 24088 : index
  %k26392 = index.constant 26392 : index
  %k28696 = index.constant 28696 : index
  %k28824 = index.constant 28824 : index
  %k31128 = index.constant 31128 : index
  %stop = config.get @inkling.stop_after : index
  command.serial {
    %go0 = index.cmp ugt, %stop, %k0 : index
    scf.if %go0 {
    command.launch @inkling_hook_mix_attn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    %go1 = index.cmp ugt, %stop, %k1 : index
    scf.if %go1 {
    scf.if %controlled {
    command.launch @inkling_hook_mix_msg[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    }
    %go2 = index.cmp ugt, %stop, %k2 : index
    scf.if %go2 {
    scf.if %controlled {
    command.launch @inkling_hook_ctrl_qkv[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    command.launch @inkling_capture_point[%k10, %visit, %k2304, %k0, %k0](%metadata, %x, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go3 = index.cmp ugt, %stop, %k3 : index
    scf.if %go3 {
    command.launch @inkling_hook_norm_in[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k11, %visit, %k2304, %k2304, %k0](%metadata, %xn, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go4 = index.cmp ugt, %stop, %k4 : index
    scf.if %go4 {
    command.launch @inkling_hook_proj[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k12, %visit, %k3072, %k4608, %k0](%metadata, %q, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k13, %visit, %k1024, %k7680, %k0](%metadata, %k, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k14, %visit, %k1024, %k8704, %k0](%metadata, %v, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k15, %visit, %k384, %k9728, %k0](%metadata, %r, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k19, %visit, %k3072, %k10112, %k0](%metadata, %gate, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k21, %visit, %k24, %k13184, %k0](%metadata, %small, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go5 = index.cmp ugt, %stop, %k5 : index
    scf.if %go5 {
    command.launch @inkling_hook_attn_prep[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k22, %visit, %k3072, %k13208, %k0](%metadata, %q, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k23, %visit, %k1024, %k16280, %k1](%metadata, %xn, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k24, %visit, %k1024, %k17304, %k1](%metadata, %x, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k25, %visit, %k384, %k18328, %k0](%metadata, %r, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go6 = index.cmp ugt, %stop, %k6 : index
    scf.if %go6 {
    command.launch @inkling_hook_attn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k16, %visit, %k3072, %k18712, %k0](%metadata, %ab, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go7 = index.cmp ugt, %stop, %k7 : index
    scf.if %go7 {
    command.launch @inkling_hook_oproj[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k17, %visit, %k2304, %k21784, %k0](%metadata, %ob, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go8 = index.cmp ugt, %stop, %k8 : index
    scf.if %go8 {
    command.launch @inkling_hook_post_attn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k27, %visit, %k2304, %k24088, %k0](%metadata, %cur, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go9 = index.cmp ugt, %stop, %k9 : index
    scf.if %go9 {
    command.launch @inkling_hook_mix_ffn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    %go10 = index.cmp ugt, %stop, %k10 : index
    scf.if %go10 {
    scf.if %controlled {
    command.launch @inkling_hook_ctrl_ffn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    }
    %go11 = index.cmp ugt, %stop, %k11 : index
    scf.if %go11 {
    command.launch @inkling_hook_norm_ffn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k28, %visit, %k2304, %k26392, %k0](%metadata, %xn, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go12 = index.cmp ugt, %stop, %k12 : index
    scf.if %go12 {
    command.launch @inkling_hook_router[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k29, %visit, %k128, %k28696, %k0](%metadata, %small, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go13 = index.cmp ugt, %stop, %k13 : index
    scf.if %go13 {
    command.launch @inkling_hook_experts[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k18, %visit, %k2304, %k28824, %k0](%metadata, %y, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
    %go14 = index.cmp ugt, %stop, %k14 : index
    scf.if %go14 {
    command.launch @inkling_hook_post_ffn[%layer, %visit, %pass](%parameters, %span_table, %token_map, %metadata, %origins, %arena, %cur, %blocks, %bank, %x, %xn, %small, %q, %k, %v, %r, %gate, %ab, %ob, %y) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    command.launch @inkling_capture_point[%k20, %visit, %k2304, %k31128, %k0](%metadata, %cur, %residual) : [index, index, index, index, index](buffer, buffer, buffer)
    }
  }
  command.return
}
