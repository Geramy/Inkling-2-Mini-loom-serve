// Debug probes selected by the capture id. They are planned only when the id matches. Id 100: PR1 mul_mat (Q8_0, vec kernel) on blk.0.attn_q. Id 101: per-arch tune route test.
config.decl @inkling.tokens : %value: index where [range(%value, 1, 2147483647)]

config.decl @inkling.tune_probe : %value: index where [range(%value, 0, 1024)]

target.decl @target

target.decl @inkling_execution

target.decl @inkling_rdna3

target.decl @inkling_rdna4

kernel.decl @inkling_capture_rows() launch(%src_width: index, %col: index, %half: index, %metadata: buffer, %src: buffer, %residual: buffer)

kernel.decl @ggml_mul_mat_vec(%n_rows: index, %n_batch: index) launch(%k_size_in: index, %n_rows_in: index, %n_cols_in: index, %ne12_in: index, %r2_in: index, %r3_in: index, %w_s1_in: index, %w_s2_in: index, %w_s3_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_s3_in: index, %x_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_s3_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %dst: buffer)

template.decl @inkling.tune.probe() -> (index)

template.def<@inkling.tune.probe> priority(-1) @inkling_tune_probe_default() -> (index) {
  %value = config.get @inkling.tune_probe : index
  template.return %value : index
}

template.def<@inkling.tune.probe> target(@inkling_rdna3) @inkling_tune_probe_rdna3() -> (index) {
  %value = index.constant 11 : index
  template.return %value : index
}

template.def<@inkling.tune.probe> target(@inkling_rdna4) @inkling_tune_probe_rdna4() -> (index) {
  %value = index.constant 12 : index
  template.return %value : index
}

kernel.def target(@target) @inkling_probe_fill() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%value: index, %residual: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %out = buffer.view %residual[%origin] : buffer -> view<4xf32>
  %value32 = index.cast %value : index to i32
  %x = scalar.sitofp %value32 : i32 to f32
  view.store %x, %out[%c0] : f32, view<4xf32>
  kernel.return
}

command.def public target(@inkling_execution) @inkling_hook_debug(%id: index) launch(%parameters: buffer, %metadata: buffer, %x0: buffer, %residual: buffer) {
  %c100 = index.constant 100 : index
  %c101 = index.constant 101 : index
  %is_mul_mat = index.cmp eq, %id, %c100 : index
  scf.if %is_mul_mat {
    %weight = command.parameter %parameters, "blk.0.attn_q.weight" : view<3072x72x34xi8>
    %k = index.constant 2304 : index
    %rows = index.constant 3072 : index
    %cols = index.constant 8 : index
    %one = index.constant 1 : index
    %zero = index.constant 0 : index
    %w_s1 = index.constant 1224 : index
    %w_span = index.constant 3760128 : index
    %x_s1 = index.constant 2304 : index
    %x_s2 = index.constant 18432 : index
    %d_s1 = index.constant 3072 : index
    %d_s2 = index.constant 24576 : index
    kernel.launch @ggml_mul_mat_vec[%rows, %one](%k, %rows, %cols, %one, %one, %one, %w_s1, %w_span, %w_span, %w_span, %one, %x_s1, %x_s2, %x_s2, %x_s2, %d_s1, %d_s2, %d_s2, %d_s2, %weight, %x0, %residual) : [index, index](index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, view<3072x72x34xi8>, buffer, buffer)
  }
  %c102 = index.constant 102 : index
  %is_config = index.cmp eq, %id, %c102 : index
  scf.if %is_config {
    %configured = config.get @inkling.tune_probe : index
    kernel.launch @inkling_probe_fill(%configured, %residual) : (index, buffer)
  }
  %is_tune = index.cmp eq, %id, %c101 : index
  scf.if %is_tune {
    %value = template.apply<@inkling.tune.probe>() : () -> (index)
    kernel.launch @inkling_probe_fill(%value, %residual) : (index, buffer)
  }
  command.return
}
