func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

func.def @check(%condition: i1) {
  %value = scalar.extui %condition : i1 to i32
  %error = buffer.constant utf8("inkling skeleton accepts text messages without tools, reasoning_content or image parts") : buffer
  func.call @require(%value, %error) : (i32, buffer)
  func.return
}

func.def @equal(%a: buffer, %b: buffer) -> (i1) {
  %a_length = buffer.length %a
  %b_length = buffer.length %b
  %same_length = index.cmp eq, %a_length, %b_length : offset
  %same = scf.if %same_length -> (i1) {
    %c0 = index.constant 0 : offset
    %compared = buffer.compare %a[%c0], %b[%c0], %a_length
    %c0_i32 = scalar.constant 0 : i32
    %matches = scalar.cmpi eq, %compared, %c0_i32 : i32
    scf.yield %matches : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %same : i1
}

func.def @join(%a: buffer, %b: buffer) -> (buffer) {
  %c0 = index.constant 0 : offset
  %a_length = buffer.length %a
  %b_length = buffer.length %b
  %length = index.add %a_length, %b_length : offset
  %output = buffer.alloca<private> align(1) %length : buffer
  buffer.copy %a[%c0], %output[%c0], %a_length
  buffer.copy %b[%c0], %output[%a_length], %b_length
  func.return %output : buffer
}

func.def public @model_name() -> (buffer) {
  %name = buffer.constant utf8("inkling-2-mini") : buffer
  func.return %name : buffer
}

func.def public @request_defaults(%options: buffer) -> (buffer) {
  %fields, %type, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.constant 2 : i32
  %empty_count = scalar.constant 0 : i64
  %typed = scalar.cmpi eq, %type, %object : i32
  %empty_options = scalar.cmpi eq, %count, %empty_count : i64
  %valid = scalar.andi %typed, %empty_options : i1
  func.call @check(%valid) : (i1)
  %empty = buffer.constant utf8("") : buffer
  func.return %empty : buffer
}

func.def public @request_options(%defaults: buffer, %request: buffer, %nonce: i64) -> (buffer) {
  func.return %defaults : buffer
}

func.def public @bind_request(%state: buffer, %row: i32, %options: buffer) {
  func.return
}

func.def public @chat_reasoning() -> (i32, i32, i32) {
  %supported = scalar.constant 1 : i32
  %efforts = scalar.constant 63 : i32
  %default = scalar.constant 4 : i32
  func.return %supported, %efforts, %default : i32, i32, i32
}

func.def public @chat_image_limits() -> (i64, i64, i64, i64, i64) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  func.return %zero, %zero, %zero, %zero, %zero : i64, i64, i64, i64, i64
}

// State bits 0-2 hold the reasoning effort ordinal and bit 3 records that its header was emitted.
func.def @effort_ordinal(%value: buffer) -> (i64) {
  %none = buffer.constant utf8("none") : buffer
  %minimal = buffer.constant utf8("minimal") : buffer
  %low = buffer.constant utf8("low") : buffer
  %medium = buffer.constant utf8("medium") : buffer
  %high = buffer.constant utf8("high") : buffer
  %xhigh = buffer.constant utf8("xhigh") : buffer
  %max = buffer.constant utf8("max") : buffer
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %c2 = scalar.constant 2 : i64
  %c3 = scalar.constant 3 : i64
  %c4 = scalar.constant 4 : i64
  %c5 = scalar.constant 5 : i64
  %c6 = scalar.constant 6 : i64
  %c7 = scalar.constant 7 : i64
  %is_none = func.call @equal(%value, %none) : (buffer, buffer) -> (i1)
  %is_minimal = func.call @equal(%value, %minimal) : (buffer, buffer) -> (i1)
  %is_low = func.call @equal(%value, %low) : (buffer, buffer) -> (i1)
  %is_medium = func.call @equal(%value, %medium) : (buffer, buffer) -> (i1)
  %is_high = func.call @equal(%value, %high) : (buffer, buffer) -> (i1)
  %is_xhigh = func.call @equal(%value, %xhigh) : (buffer, buffer) -> (i1)
  %is_max = func.call @equal(%value, %max) : (buffer, buffer) -> (i1)
  %a = scf.select %is_max, %c6, %c7 : i64
  %b = scf.select %is_xhigh, %c5, %a : i64
  %c = scf.select %is_high, %c4, %b : i64
  %d = scf.select %is_medium, %c3, %c : i64
  %e = scf.select %is_low, %c2, %d : i64
  %f = scf.select %is_minimal, %c1, %e : i64
  %g = scf.select %is_none, %c0, %f : i64
  %known = scalar.cmpi ne, %g, %c7 : i64
  func.call @check(%known) : (i1)
  func.return %g : i64
}

func.def @effort_header(%ordinal: i64) -> (buffer) {
  %h0 = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: 0<|end_message|>") : buffer
  %h1 = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: 0.1<|end_message|>") : buffer
  %h2 = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: 0.2<|end_message|>") : buffer
  %h3 = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: 0.7<|end_message|>") : buffer
  %h4 = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|>") : buffer
  %h5 = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: 0.99<|end_message|>") : buffer
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %c2 = scalar.constant 2 : i64
  %c3 = scalar.constant 3 : i64
  %c4 = scalar.constant 4 : i64
  %is0 = scalar.cmpi eq, %ordinal, %c0 : i64
  %is1 = scalar.cmpi eq, %ordinal, %c1 : i64
  %is2 = scalar.cmpi eq, %ordinal, %c2 : i64
  %is3 = scalar.cmpi eq, %ordinal, %c3 : i64
  %is4 = scalar.cmpi eq, %ordinal, %c4 : i64
  %a = scf.select %is4, %h4, %h5 : buffer
  %b = scf.select %is3, %h3, %a : buffer
  %c = scf.select %is2, %h2, %b : buffer
  %d = scf.select %is1, %h1, %c : buffer
  %e = scf.select %is0, %h0, %d : buffer
  func.return %e : buffer
}

func.def public @chat_begin(%request: buffer, %tools: buffer) -> (buffer, i64) {
  %c0 = index.constant 0 : offset
  %c0_index = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i64 = scalar.constant 0 : i64
  %default_effort = scalar.constant 4 : i64
  %empty = buffer.constant utf8("") : buffer
  %tool_fields, %tool_type, %tool_count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %no_tools = scalar.cmpi eq, %tool_count, %c0_i64 : i64
  func.call @check(%no_tools) : (i1)
  %fields, %type, %count64 = func.call @members(%request) : (buffer) -> (buffer, i32, i64)
  %count_bounded = scalar.assume %count64 [range(%count64, 0, 2147483647)] : i64
  %count = index.cast %count_bounded : i64 to index
  %records = buffer.view %fields[%c0] : buffer -> view<[%count]x5xi64>
  %effort_key = buffer.constant utf8("reasoning_effort") : buffer
  %effort = scf.for %i = [%c0_index to %count step %c1](%current = %default_effort : i64) -> (i64) {
    %begin64 = view.load %records[%i, 0] : view<[%count]x5xi64> -> i64
    %length64 = view.load %records[%i, 1] : view<[%count]x5xi64> -> i64
    %begin_bounded = scalar.assume %begin64 [range(%begin64, 0, 9223372036854775807)] : i64
    %length_bounded = scalar.assume %length64 [range(%length64, 0, 9223372036854775807)] : i64
    %begin = index.cast %begin_bounded : i64 to offset
    %length = index.cast %length_bounded : i64 to offset
    %key = buffer.alloca<private> align(1) %length : buffer
    buffer.copy %request[%begin], %key[%c0], %length
    %is_effort = func.call @equal(%key, %effort_key) : (buffer, buffer) -> (i1)
    %next = scf.if %is_effort -> (i64) {
      %value_begin64 = view.load %records[%i, 2] : view<[%count]x5xi64> -> i64
      %value_length64 = view.load %records[%i, 3] : view<[%count]x5xi64> -> i64
      %value_begin_bounded = scalar.assume %value_begin64 [range(%value_begin64, 0, 9223372036854775807)] : i64
      %value_length_bounded = scalar.assume %value_length64 [range(%value_length64, 0, 9223372036854775807)] : i64
      %value_begin = index.cast %value_begin_bounded : i64 to offset
      %value_length = index.cast %value_length_bounded : i64 to offset
      %value = buffer.alloca<private> align(1) %value_length : buffer
      buffer.copy %request[%value_begin], %value[%c0], %value_length
      %ordinal = func.call @effort_ordinal(%value) : (buffer) -> (i64)
      scf.yield %ordinal : i64
    } else {
      scf.yield %current : i64
    }
    scf.yield %next : i64
  }
  func.return %empty, %effort : buffer, i64
}

func.def public @chat_message(%raw: buffer, %role: buffer, %content: buffer, %parts: buffer, %frames: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer, i64) {
  %c0_i64 = scalar.constant 0 : i64
  %c7 = scalar.constant 7 : i64
  %c8 = scalar.constant 8 : i64
  %plain = scalar.cmpi eq, %fields, %c0_i64 : i64
  %no_parts = scalar.cmpi eq, %part_count, %c0_i64 : i64
  %simple = scalar.andi %plain, %no_parts : i1
  func.call @check(%simple) : (i1)
  %assistant_role = buffer.constant utf8("assistant") : buffer
  %user_role = buffer.constant utf8("user") : buffer
  %system_role = buffer.constant utf8("system") : buffer
  %assistant = func.call @equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %user = func.call @equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %system = func.call @equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %ordinary = scalar.ori %user, %system : i1
  %supported = scalar.ori %ordinary, %assistant : i1
  func.call @check(%supported) : (i1)
  %user_prefix = buffer.constant utf8("<|message_user|><|content_text|>") : buffer
  %system_prefix = buffer.constant utf8("<|message_system|><|content_text|>") : buffer
  %assistant_prefix = buffer.constant utf8("<|message_model|><|content_text|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %end_sampling = buffer.constant utf8("<|content_model_end_sampling|>") : buffer
  %empty = buffer.constant utf8("") : buffer
  %user_or_system = scf.select %system, %system_prefix, %user_prefix : buffer
  %prefix = scf.select %assistant, %assistant_prefix, %user_or_system : buffer
  %suffix = scf.select %assistant, %end_sampling, %empty : buffer
  %body = func.call @join(%prefix, %content) : (buffer, buffer) -> (buffer)
  %closed = func.call @join(%body, %end_message) : (buffer, buffer) -> (buffer)
  %message = func.call @join(%closed, %suffix) : (buffer, buffer) -> (buffer)
  %effort = scalar.andi %state, %c7 : i64
  %header = func.call @effort_header(%effort) : (i64) -> (buffer)
  %emitted_bits = scalar.andi %state, %c8 : i64
  %emitted = scalar.cmpi ne, %emitted_bits, %c0_i64 : i64
  %true = scalar.constant true : i1
  %not_system = scalar.xori %system, %true : i1
  %not_emitted = scalar.xori %emitted, %true : i1
  %needs_header = scalar.andi %not_system, %not_emitted : i1
  %leading = scf.select %needs_header, %header, %empty : buffer
  %fragment = func.call @join(%leading, %message) : (buffer, buffer) -> (buffer)
  %marked = scalar.ori %state, %c8 : i64
  %next_state = scf.select %needs_header, %marked, %state : i64
  func.return %fragment, %next_state, %empty, %c0_i64 : buffer, i64, buffer, i64
}

func.def public @chat_end(%state: i64) -> (buffer, i64) {
  %c0 = scalar.constant 0 : i64
  %c7 = scalar.constant 7 : i64
  %c8 = scalar.constant 8 : i64
  %empty = buffer.constant utf8("") : buffer
  %emitted_bits = scalar.andi %state, %c8 : i64
  %emitted = scalar.cmpi ne, %emitted_bits, %c0 : i64
  %effort = scalar.andi %state, %c7 : i64
  %header = func.call @effort_header(%effort) : (i64) -> (buffer)
  %suffix = scf.select %emitted, %empty, %header : buffer
  func.return %suffix, %state : buffer, i64
}

func.def public @render_tool(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %c0 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %error = buffer.constant utf8("inkling skeleton does not render tool calls") : buffer
  func.call @require(%c0, %error) : (i32, buffer)
  %empty = buffer.constant utf8("") : buffer
  func.return %empty, %c0_i64 : buffer, i64
}

func.def public @parse_tools(%schemas: buffer, %response: buffer, %truncated: i64) -> (buffer) {
  %empty = buffer.constant utf8("[]") : buffer
  func.return %empty : buffer
}

// A boundary of 2 means the previous turn already ended with the terminal token, so the suffix starts with its text.
func.def public @prepare_input(%text: buffer, %markers: buffer, %marker_count: i64, %format: i32, %boundary: i32, %capacity: i64) -> (buffer, i64, buffer) {
  %c0 = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c1_i64 = scalar.constant 1 : i64
  %c2_i32 = scalar.constant 2 : i32
  %length = buffer.length %text
  %terminated = scalar.cmpi eq, %boundary, %c2_i32 : i32
  %terminal = buffer.constant utf8("<|content_model_end_sampling|>") : buffer
  %terminal_length = buffer.length %terminal
  %input = scf.if %terminated -> (buffer) {
    %fits = index.cmp uge, %length, %terminal_length : offset
    func.call @check(%fits) : (i1)
    %compared = buffer.compare %text[%c0], %terminal[%c0], %terminal_length
    %zero = scalar.constant 0 : i32
    %delimiter = scalar.cmpi eq, %compared, %zero : i32
    func.call @check(%delimiter) : (i1)
    %remaining = index.sub %length, %terminal_length : offset
    %suffix = buffer.alloca<private> align(1) %remaining : buffer
    buffer.copy %text[%terminal_length], %suffix[%c0], %remaining
    scf.yield %suffix : buffer
  } else {
    scf.yield %text : buffer
  }
  %probe = scalar.addi %capacity, %c1_i64 : i64
  %tokens, %count = func.call @encode(%input, %c0_i32, %probe) : (buffer, i32, i64) -> (buffer, i64)
  %fits_capacity = scalar.cmpi ule, %count, %capacity : i64
  %fits32 = scalar.extui %fits_capacity : i1 to i32
  %error = buffer.constant utf8("input exceeds the available context size") : buffer
  func.call @require(%fits32, %error) : (i32, buffer)
  %spans = buffer.alloca<private> align(4) %c0 : buffer
  func.return %tokens, %count, %spans : buffer, i64, buffer
}

func.def public @output_next(%response: buffer, %previous: i64, %state: i64, %phase: i32) -> (i64, i64, i64, i64) {
  %length = buffer.length %response
  %count = index.cast %length : offset to i64
  %content = scalar.constant 1 : i64
  func.return %content, %previous, %count, %state : i64, i64, i64, i64
}

func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %c0 = index.constant 0 : offset
  %length = buffer.length %response
  %empty = index.cmp eq, %length, %c0 : offset
  %result = scf.if %empty -> (buffer) {
    scf.yield %prompt : buffer
  } else {
    %joined = func.call @join(%prompt, %response) : (buffer, buffer) -> (buffer)
    scf.yield %joined : buffer
  }
  %reusable = scalar.constant 1 : i32
  func.return %result, %reusable : buffer, i32
}

