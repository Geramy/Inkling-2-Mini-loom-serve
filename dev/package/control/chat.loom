// Inkling 2 chat policy for the loom-serve text service: template rendering, request options, output channels, tool calls and canonical history.
// Message framing follows docs/chat_template.jinja. Helpers for canonical JSON are in chat_json.loom.
// The response text keeps the structure tokens only if the tokenizer marks them as not special (scripts/chat_tokenizer.py).

func.decl import("json") @compact(%text: buffer) -> (buffer)

func.decl import("json") @members(%text: buffer) -> (buffer, i32, i64)

func.decl import("json") @members_range(%source: buffer, %begin: i64, %length: i64) -> (buffer, i32, i64)

func.decl import("json") @unescape(%source: buffer, %offset: i64, %length: i64, %target: buffer, %target_offset: i64) -> (i64)

func.decl import("json") @parse_i64(%source: buffer, %offset: i64, %length: i64) -> (i64)

func.decl import("json") @parse_f64(%source: buffer, %offset: i64, %length: i64) -> (f64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)

func.decl @chat_put(%output: buffer, %position: offset, %text: buffer) -> (offset)

func.decl @chat_put_quoted(%output: buffer, %position: offset, %bytes: buffer, %begin: offset, %length: offset) -> (offset)

func.decl @chat_put_string(%output: buffer, %position: offset, %source: buffer, %begin: i64, %length: i64) -> (offset)

func.decl @chat_put_object(%output: buffer, %position: offset, %source: buffer, %begin: i64, %length: i64, %sort_self: i1, %sort_children: i1) -> (offset)

func.decl @chat_decode(%source: buffer, %begin: i64, %length: i64) -> (buffer)

// State of one rendered request: bits 0-19 effort in millionths, bit 23 effort header emitted.
func.def @chat_state_header_bit() -> (i64) {
  %bit = scalar.constant 8388608 : i64
  func.return %bit : i64
}

func.def @chat_check(%valid: i1, %message: buffer) {
  %condition = scalar.extui %valid : i1 to i32
  func.call @require(%condition, %message) : (i32, buffer)
  func.return
}

func.def @chat_equal(%a: buffer, %b: buffer) -> (i1) {
  %a_length = buffer.length %a
  %b_length = buffer.length %b
  %same_length = index.cmp eq, %a_length, %b_length : offset
  %same = scf.if %same_length -> (i1) {
    %c0 = index.constant 0 : offset
    %c0_i32 = scalar.constant 0 : i32
    %compared = buffer.compare %a[%c0], %b[%c0], %a_length
    %matches = scalar.cmpi eq, %compared, %c0_i32 : i32
    scf.yield %matches : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %same : i1
}

func.def @chat_range(%text: buffer, %begin: i64, %length: i64) -> (buffer) {
  %c0 = index.constant 0 : offset
  %begin_ok = scalar.assume %begin [range(%begin, 0, 9223372036854775807)] : i64
  %begin_offset = index.cast %begin_ok : i64 to offset
  %length_ok = scalar.assume %length [range(%length, 0, 9223372036854775807)] : i64
  %size = index.cast %length_ok : i64 to offset
  %output = buffer.alloca<private> align(1) %size : buffer
  buffer.copy %text[%begin_offset], %output[%c0], %size
  func.return %output : buffer
}

func.def @chat_join(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer) {
  %c0 = index.constant 0 : offset
  %a_end = func.call @chat_size_after(%c0, %a) : (offset, buffer) -> (offset)
  %b_end = func.call @chat_size_after(%a_end, %b) : (offset, buffer) -> (offset)
  %c_end = func.call @chat_size_after(%b_end, %c) : (offset, buffer) -> (offset)
  %d_end = func.call @chat_size_after(%c_end, %d) : (offset, buffer) -> (offset)
  %e_end = func.call @chat_size_after(%d_end, %e) : (offset, buffer) -> (offset)
  %f_end = func.call @chat_size_after(%e_end, %f) : (offset, buffer) -> (offset)
  %g_end = func.call @chat_size_after(%f_end, %g) : (offset, buffer) -> (offset)
  %total = func.call @chat_size_after(%g_end, %h) : (offset, buffer) -> (offset)
  %output = buffer.alloca<private> align(1) %total : buffer
  %a_next = func.call @chat_put(%output, %c0, %a) : (buffer, offset, buffer) -> (offset)
  %b_next = func.call @chat_put(%output, %a_next, %b) : (buffer, offset, buffer) -> (offset)
  %c_next = func.call @chat_put(%output, %b_next, %c) : (buffer, offset, buffer) -> (offset)
  %d_next = func.call @chat_put(%output, %c_next, %d) : (buffer, offset, buffer) -> (offset)
  %e_next = func.call @chat_put(%output, %d_next, %e) : (buffer, offset, buffer) -> (offset)
  %f_next = func.call @chat_put(%output, %e_next, %f) : (buffer, offset, buffer) -> (offset)
  %g_next = func.call @chat_put(%output, %f_next, %g) : (buffer, offset, buffer) -> (offset)
  %h_next = func.call @chat_put(%output, %g_next, %h) : (buffer, offset, buffer) -> (offset)
  func.return %output : buffer
}

func.def @chat_size_after(%size: offset, %text: buffer) -> (offset) {
  %length = buffer.length %text
  %sum = index.add %size, %length : offset
  func.return %sum : offset
}

func.def @chat_nonempty(%text: buffer) -> (i1) {
  %c0 = index.constant 0 : offset
  %length = buffer.length %text
  %result = index.cmp ne, %length, %c0 : offset
  func.return %result : i1
}

// Value of a member of the JSON object in [begin, begin+length) by literal key: type (-1 when absent), value begin and length. The last duplicate wins.
func.def @chat_find(%source: buffer, %begin: i64, %length: i64, %key: buffer) -> (i64, i64, i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i64 = scalar.constant 0 : i64
  %absent = scalar.constant -1 : i64
  %c0_i32 = scalar.constant 0 : i32
  %records, %type, %count64 = func.call @members_range(%source, %begin, %length) : (buffer, i64, i64) -> (buffer, i32, i64)
  %bounded = scalar.assume %count64 [range(%count64, 0, 33554431)] : i64
  %count = index.cast %bounded : i64 to index
  %fields = buffer.view %records[%origin] : buffer -> view<[%count]x5xi64>
  %key_length = buffer.length %key
  %key_length64 = index.cast %key_length : offset to i64
  %found_type, %found_begin, %found_length = scf.for %i = [%c0 to %count step %c1](%t = %absent : i64, %b = %c0_i64 : i64, %l = %c0_i64 : i64) -> (i64, i64, i64) {
    %name_begin = view.load %fields[%i, 0] : view<[%count]x5xi64> -> i64
    %name_length = view.load %fields[%i, 1] : view<[%count]x5xi64> -> i64
    %same_length = scalar.cmpi eq, %name_length, %key_length64 : i64
    %matches = scf.if %same_length -> (i1) {
      %name_begin_ok = scalar.assume %name_begin [range(%name_begin, 0, 9223372036854775807)] : i64
      %name_offset = index.cast %name_begin_ok : i64 to offset
      %compared = buffer.compare %source[%name_offset], %key[%origin], %key_length
      %equal = scalar.cmpi eq, %compared, %c0_i32 : i32
      scf.yield %equal : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    %value_begin = view.load %fields[%i, 2] : view<[%count]x5xi64> -> i64
    %value_length = view.load %fields[%i, 3] : view<[%count]x5xi64> -> i64
    %value_type = view.load %fields[%i, 4] : view<[%count]x5xi64> -> i64
    %next_type = scf.select %matches, %value_type, %t : i64
    %next_begin = scf.select %matches, %value_begin, %b : i64
    %next_length = scf.select %matches, %value_length, %l : i64
    scf.yield %next_type, %next_begin, %next_length : i64, i64, i64
  }
  func.return %found_type, %found_begin, %found_length : i64, i64, i64
}

func.def @chat_member(%source: buffer, %key: buffer) -> (i64, i64, i64) {
  %c0_i64 = scalar.constant 0 : i64
  %length = buffer.length %source
  %length64 = index.cast %length : offset to i64
  %type, %begin, %size = func.call @chat_find(%source, %c0_i64, %length64, %key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  func.return %type, %begin, %size : i64, i64, i64
}

// Text of a string member, empty when the member is absent or not a string.
func.def @chat_string_member(%source: buffer, %key: buffer) -> (buffer) {
  %c0_i64 = scalar.constant 0 : i64
  %string_type = scalar.constant 0 : i64
  %type, %begin, %length = func.call @chat_member(%source, %key) : (buffer, buffer) -> (i64, i64, i64)
  %is_string = scalar.cmpi eq, %type, %string_type : i64
  %empty = buffer.constant utf8("") : buffer
  %text = scf.if %is_string -> (buffer) {
    %decoded = func.call @chat_decode(%source, %begin, %length) : (buffer, i64, i64) -> (buffer)
    scf.yield %decoded : buffer
  } else {
    scf.yield %empty : buffer
  }
  func.return %text : buffer
}

// Finds the first byte offset at or after from where marker starts, or the text length.
func.def @chat_find_marker(%text: buffer, %from: offset, %marker: buffer) -> (offset) {
  %c1 = index.constant 1 : offset
  %length = buffer.length %text
  %marker_length = buffer.length %marker
  %end = scf.while(%position = %from : offset) -> (offset) {
    %remaining_known = index.cmp ult, %position, %length : offset
    %keep = scf.if %remaining_known -> (i1) {
      %matches = func.call @chat_marker_at(%text, %position, %marker) : (buffer, offset, buffer) -> (i1)
      %false = scalar.constant false : i1
      %no_match = scalar.cmpi eq, %matches, %false : i1
      scf.yield %no_match : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    scf.condition %keep, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  func.return %end : offset
}

// True when the complete marker starts at the position.
func.def @chat_marker_at(%text: buffer, %position: offset, %marker: buffer) -> (i1) {
  %c0 = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %length = buffer.length %text
  %marker_length = buffer.length %marker
  %inside = index.cmp ule, %position, %length : offset
  %clamped = scf.select %inside, %position, %length : offset
  %available = index.sub %length, %clamped : offset
  %room = index.cmp uge, %available, %marker_length : offset
  %fits = scalar.andi %inside, %room : i1
  %result = scf.if %fits -> (i1) {
    %compared = buffer.compare %text[%position], %marker[%c0], %marker_length
    %equal = scalar.cmpi eq, %compared, %c0_i32 : i32
    scf.yield %equal : i1
  } else {
    scf.yield %fits : i1
  }
  func.return %result : i1
}

// End of the text that cannot belong to the marker: stops at a complete marker and, while streaming, at a trailing marker prefix.
func.def @chat_until(%response: buffer, %marker: buffer, %from: offset, %streaming: i1) -> (offset) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %c0_i32 = scalar.constant 0 : i32
  %false = scalar.constant false : i1
  %length = buffer.length %response
  %marker_length = buffer.length %marker
  %end = scf.while(%position = %from : offset) -> (offset) {
    %has_bytes = index.cmp ult, %position, %length : offset
    %advance = scf.if %has_bytes -> (i1) {
      %remaining = index.sub %length, %position : offset
      %short = index.cmp ult, %remaining, %marker_length : offset
      %count = scf.select %short, %remaining, %marker_length : offset
      %comparison = buffer.compare %response[%position], %marker[%c0], %count
      %mismatch = scalar.cmpi ne, %comparison, %c0_i32 : i32
      %complete_marker = index.cmp uge, %remaining, %marker_length : offset
      %withhold = scalar.ori %streaming, %complete_marker : i1
      %release_fragment = scalar.cmpi eq, %withhold, %false : i1
      %next = scalar.ori %mismatch, %release_fragment : i1
      scf.yield %next : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %advance, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  func.return %end : offset
}

// Reasoning effort.

// Millionths for an effort name, -1 when unknown.
func.def @chat_effort_name(%value: buffer) -> (i64) {
  %none = buffer.constant utf8("none") : buffer
  %minimal = buffer.constant utf8("minimal") : buffer
  %low = buffer.constant utf8("low") : buffer
  %medium = buffer.constant utf8("medium") : buffer
  %high = buffer.constant utf8("high") : buffer
  %xhigh = buffer.constant utf8("xhigh") : buffer
  %max = buffer.constant utf8("max") : buffer
  %unknown = scalar.constant -1 : i64
  %c0 = scalar.constant 0 : i64
  %c100000 = scalar.constant 100000 : i64
  %c200000 = scalar.constant 200000 : i64
  %c700000 = scalar.constant 700000 : i64
  %c900000 = scalar.constant 900000 : i64
  %c990000 = scalar.constant 990000 : i64
  %is_none = func.call @chat_equal(%value, %none) : (buffer, buffer) -> (i1)
  %is_minimal = func.call @chat_equal(%value, %minimal) : (buffer, buffer) -> (i1)
  %is_low = func.call @chat_equal(%value, %low) : (buffer, buffer) -> (i1)
  %is_medium = func.call @chat_equal(%value, %medium) : (buffer, buffer) -> (i1)
  %is_high = func.call @chat_equal(%value, %high) : (buffer, buffer) -> (i1)
  %is_xhigh = func.call @chat_equal(%value, %xhigh) : (buffer, buffer) -> (i1)
  %is_max = func.call @chat_equal(%value, %max) : (buffer, buffer) -> (i1)
  %a = scf.select %is_max, %c990000, %unknown : i64
  %b = scf.select %is_xhigh, %c990000, %a : i64
  %c = scf.select %is_high, %c900000, %b : i64
  %d = scf.select %is_medium, %c700000, %c : i64
  %e = scf.select %is_low, %c200000, %d : i64
  %f = scf.select %is_minimal, %c100000, %e : i64
  %g = scf.select %is_none, %c0, %f : i64
  func.return %g : i64
}

// A JSON number between 0 and 0.99 with at most six decimals, in millionths. -1 when unsupported.
func.def @chat_effort_number(%source: buffer, %begin: i64, %length: i64) -> (i64) {
  %unknown = scalar.constant -1 : i64
  %c0_f64 = scalar.constant 0.0 : f64
  %scale = scalar.constant 1000000.0 : f64
  %limit = scalar.constant 0.99 : f64
  %value = func.call @parse_f64(%source, %begin, %length) : (buffer, i64, i64) -> (f64)
  %scaled = scalar.mulf %value, %scale : f64
  %rounded = scalar.roundevenf %scaled : f64
  %micro = scalar.fptosi %rounded : f64 to i64
  %restored_f = scalar.sitofp %micro : i64 to f64
  %back = scalar.divf %restored_f, %scale : f64
  %exact = scalar.cmpf oeq, %back, %value : f64
  %low_ok = scalar.cmpf oge, %value, %c0_f64 : f64
  %high_ok = scalar.cmpf ole, %value, %limit : f64
  %in_range = scalar.andi %low_ok, %high_ok : i1
  %valid = scalar.andi %in_range, %exact : i1
  %result = scf.select %valid, %micro, %unknown : i64
  func.return %result : i64
}

func.def @chat_trim(%text: buffer) -> (buffer) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %false = scalar.constant false : i1
  %length = buffer.length %text
  %begin = scf.while(%position = %c0 : offset) -> (offset) {
    %has_bytes = index.cmp ult, %position, %length : offset
    %advance = scf.if %has_bytes -> (i1) {
      %byte = buffer.load.i8.u %text[%position]
      %space = func.call @chat_is_space(%byte) : (i32) -> (i1)
      scf.yield %space : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %advance, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  %end = scf.while(%position = %length : offset) -> (offset) {
    %has_bytes = index.cmp ugt, %position, %begin : offset
    %retreat = scf.if %has_bytes -> (i1) {
      %last = index.sub %position, %c1 : offset
      %byte = buffer.load.i8.u %text[%last]
      %space = func.call @chat_is_space(%byte) : (i32) -> (i1)
      scf.yield %space : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %retreat, %position : i1, offset
  } do(%position: offset) {
    %next = index.sub %position, %c1 : offset
    scf.yield %next : offset
  }
  %size = index.sub %end, %begin : offset
  %output = buffer.alloca<private> align(1) %size : buffer
  buffer.copy %text[%begin], %output[%c0], %size
  func.return %output : buffer
}

func.def @chat_is_space(%byte: i32) -> (i1) {
  %space = scalar.constant 32 : i32
  %tab = scalar.constant 9 : i32
  %carriage_return = scalar.constant 13 : i32
  %is_space = scalar.cmpi eq, %byte, %space : i32
  %after_tab = scalar.cmpi uge, %byte, %tab : i32
  %before_return = scalar.cmpi ule, %byte, %carriage_return : i32
  %control = scalar.andi %after_tab, %before_return : i1
  %result = scalar.ori %is_space, %control : i1
  func.return %result : i1
}

// Millionths of the reasoning_effort member of the object in [begin, begin+length); -1 when the member is absent or null.
func.def @chat_effort_in(%source: buffer, %begin: i64, %length: i64) -> (i64) {
  %key = buffer.constant utf8("reasoning_effort") : buffer
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c6_i64 = scalar.constant 6 : i64
  %absent = scalar.constant -1 : i64
  %error = func.call @chat_error_effort_error() : () -> (buffer)
  %type, %value_begin, %value_length = func.call @chat_find(%source, %begin, %length, %key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  %is_absent = scalar.cmpi eq, %type, %absent : i64
  %is_null = scalar.cmpi eq, %type, %c6_i64 : i64
  %is_unset = scalar.ori %is_absent, %is_null : i1
  %is_string = scalar.cmpi eq, %type, %c0_i64 : i64
  %is_number = scalar.cmpi eq, %type, %c1_i64 : i64
  %micro = scf.if %is_unset -> (i64) {
    scf.yield %absent : i64
  } else {
    %value = scf.if %is_string -> (i64) {
      %decoded = func.call @chat_decode(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
      %trimmed = func.call @chat_trim(%decoded) : (buffer) -> (buffer)
      %named = func.call @chat_effort_name(%trimmed) : (buffer) -> (i64)
      scf.yield %named : i64
    } else {
      %number = scf.if %is_number -> (i64) {
        %parsed = func.call @chat_effort_number(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
        scf.yield %parsed : i64
      } else {
        scf.yield %absent : i64
      }
      scf.yield %number : i64
    }
    scf.yield %value : i64
  }
  %parsed = scalar.cmpi sge, %micro, %c0_i64 : i64
  %valid = scalar.ori %is_unset, %parsed : i1
  func.call @chat_check(%valid, %error) : (i1, buffer)
  func.return %micro : i64
}

// The enable_thinking member of a chat_template_kwargs object: -1 absent or null, 0 false, 1 true. Any other key or value type is an error.
func.def @chat_kwargs_in(%source: buffer, %begin: i64, %length: i64) -> (i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %absent = scalar.constant -1 : i64
  %true_type = scalar.constant 4 : i64
  %false_type = scalar.constant 5 : i64
  %null_type = scalar.constant 6 : i64
  %true = scalar.constant true : i1
  %effort_key = buffer.constant utf8("reasoning_effort") : buffer
  %thinking_key = buffer.constant utf8("enable_thinking") : buffer
  %error = func.call @chat_error_kwargs_error() : () -> (buffer)
  %records, %kind, %count64 = func.call @members_range(%source, %begin, %length) : (buffer, i64, i64) -> (buffer, i32, i64)
  %bounded = scalar.assume %count64 [range(%count64, 0, 33554431)] : i64
  %count = index.cast %bounded : i64 to index
  %fields = buffer.view %records[%origin] : buffer -> view<[%count]x5xi64>
  %result = scf.for %i = [%c0 to %count step %c1](%acc = %absent : i64) -> (i64) {
    %key_begin = view.load %fields[%i, 0] : view<[%count]x5xi64> -> i64
    %key_length = view.load %fields[%i, 1] : view<[%count]x5xi64> -> i64
    %value_type = view.load %fields[%i, 4] : view<[%count]x5xi64> -> i64
    %key = func.call @chat_decode(%source, %key_begin, %key_length) : (buffer, i64, i64) -> (buffer)
    %is_effort = func.call @chat_equal(%key, %effort_key) : (buffer, buffer) -> (i1)
    %is_thinking = func.call @chat_equal(%key, %thinking_key) : (buffer, buffer) -> (i1)
    %known = scalar.ori %is_effort, %is_thinking : i1
    func.call @chat_check(%known, %error) : (i1, buffer)
    %is_true = scalar.cmpi eq, %value_type, %true_type : i64
    %is_false = scalar.cmpi eq, %value_type, %false_type : i64
    %is_null = scalar.cmpi eq, %value_type, %null_type : i64
    %boolean = scalar.ori %is_true, %is_false : i1
    %boolean_or_null = scalar.ori %boolean, %is_null : i1
    %not_thinking = scalar.xori %is_thinking, %true : i1
    %type_ok = scalar.ori %not_thinking, %boolean_or_null : i1
    func.call @chat_check(%type_ok, %error) : (i1, buffer)
    %flag = scf.select %is_true, %c1_i64, %absent : i64
    %flag_value = scf.select %is_false, %c0_i64, %flag : i64
    %next = scf.select %is_thinking, %flag_value, %acc : i64
    scf.yield %next : i64
  }
  func.return %result : i64
}

// The request value of reasoning_effort in millionths. The top-level field and chat_template_kwargs (reasoning_effort, enable_thinking) are combined; nothing given means high.
func.def @chat_effort(%request: buffer) -> (i64) {
  %key = buffer.constant utf8("chat_template_kwargs") : buffer
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c2_i64 = scalar.constant 2 : i64
  %c6_i64 = scalar.constant 6 : i64
  %absent = scalar.constant -1 : i64
  %default = scalar.constant 900000 : i64
  %true = scalar.constant true : i1
  %kwargs_error = func.call @chat_error_kwargs_error() : () -> (buffer)
  %conflict_error = func.call @chat_error_effort_conflict_error() : () -> (buffer)
  %request_length = buffer.length %request
  %request_length64 = index.cast %request_length : offset to i64
  %top = func.call @chat_effort_in(%request, %c0_i64, %request_length64) : (buffer, i64, i64) -> (i64)
  %type, %begin, %length = func.call @chat_member(%request, %key) : (buffer, buffer) -> (i64, i64, i64)
  %is_object = scalar.cmpi eq, %type, %c2_i64 : i64
  %is_absent = scalar.cmpi eq, %type, %absent : i64
  %is_null = scalar.cmpi eq, %type, %c6_i64 : i64
  %is_unset = scalar.ori %is_absent, %is_null : i1
  %kwargs_ok = scalar.ori %is_object, %is_unset : i1
  func.call @chat_check(%kwargs_ok, %kwargs_error) : (i1, buffer)
  %kw_effort = scf.if %is_object -> (i64) {
    %effort = func.call @chat_effort_in(%request, %begin, %length) : (buffer, i64, i64) -> (i64)
    scf.yield %effort : i64
  } else {
    scf.yield %absent : i64
  }
  %kw_thinking = scf.if %is_object -> (i64) {
    %thinking = func.call @chat_kwargs_in(%request, %begin, %length) : (buffer, i64, i64) -> (i64)
    scf.yield %thinking : i64
  } else {
    scf.yield %absent : i64
  }
  %top_set = scalar.cmpi sge, %top, %c0_i64 : i64
  %kw_set = scalar.cmpi sge, %kw_effort, %c0_i64 : i64
  %both = scalar.andi %top_set, %kw_set : i1
  %differs = scalar.cmpi ne, %top, %kw_effort : i64
  %clash = scalar.andi %both, %differs : i1
  %no_clash = scalar.xori %clash, %true : i1
  func.call @chat_check(%no_clash, %conflict_error) : (i1, buffer)
  %given = scf.select %top_set, %top, %kw_effort : i64
  %given_set = scalar.cmpi sge, %given, %c0_i64 : i64
  %given_zero = scalar.cmpi eq, %given, %c0_i64 : i64
  %given_on = scalar.cmpi sgt, %given, %c0_i64 : i64
  %says_off = scalar.cmpi eq, %kw_thinking, %c0_i64 : i64
  %says_on = scalar.cmpi eq, %kw_thinking, %c1_i64 : i64
  %off_clash = scalar.andi %says_off, %given_on : i1
  %on_clash = scalar.andi %says_on, %given_zero : i1
  %thinking_clash = scalar.ori %off_clash, %on_clash : i1
  %thinking_ok = scalar.xori %thinking_clash, %true : i1
  func.call @chat_check(%thinking_ok, %conflict_error) : (i1, buffer)
  %fallback = scf.select %says_off, %c0_i64, %default : i64
  %micro = scf.select %given_set, %given, %fallback : i64
  func.return %micro : i64
}

// Shortest decimal text of millionths: 0 or 0.<digits> without trailing zeros.
func.def @chat_number_text(%micro: i64) -> (buffer) {
  %c0 = index.constant 0 : offset
  %c0_i64 = scalar.constant 0 : i64
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c6_index = index.constant 6 : index
  %c10_i64 = scalar.constant 10 : i64
  %c48 = scalar.constant 48 : i32
  %c46 = scalar.constant 46 : i32
  %c2 = index.constant 2 : offset
  %c8 = index.constant 8 : offset
  %zero_text = buffer.constant utf8("0") : buffer
  %is_zero = scalar.cmpi eq, %micro, %c0_i64 : i64
  %text = scf.if %is_zero -> (buffer) {
    scf.yield %zero_text : buffer
  } else {
    %scratch = buffer.alloca<private> align(1) %c8 : buffer
    %c1 = index.constant 1 : offset
    buffer.store.i8 %c48, %scratch[%c0]
    buffer.store.i8 %c46, %scratch[%c1]
    %scale = scalar.constant 100000 : i64
    %remainder, %final_scale = scf.for %k = [%c0_index to %c6_index step %c1_index](%rest = %micro : i64, %place = %scale : i64) -> (i64, i64) {
      %digit = scalar.divui %rest, %place : i64
      %left = scalar.remui %rest, %place : i64
      %digit32 = scalar.trunci %digit : i64 to i32
      %ascii = scalar.addi %digit32, %c48 : i32
      %relative = index.cast %k : index to offset
      %target = index.add %relative, %c2 : offset
      buffer.store.i8 %ascii, %scratch[%target]
      %next_place = scalar.divui %place, %c10_i64 : i64
      scf.yield %left, %next_place : i64, i64
    }
    %kept = scf.for %k = [%c0_index to %c6_index step %c1_index](%last = %c0 : offset) -> (offset) {
      %relative = index.cast %k : index to offset
      %target = index.add %relative, %c2 : offset
      %byte = buffer.load.i8.u %scratch[%target]
      %nonzero = scalar.cmpi ne, %byte, %c48 : i32
      %after = index.add %relative, %c1 : offset
      %next = scf.select %nonzero, %after, %last : offset
      scf.yield %next : offset
    }
    %size = index.add %kept, %c2 : offset
    %exact = buffer.alloca<private> align(1) %size : buffer
    buffer.copy %scratch[%c0], %exact[%c0], %size
    scf.yield %exact : buffer
  }
  func.return %text : buffer
}

func.def @chat_effort_header(%micro: i64) -> (buffer) {
  %prefix = buffer.constant utf8("<|message_system|><|content_text|>Thinking effort level: ") : buffer
  %suffix = buffer.constant utf8("<|end_message|>") : buffer
  %empty = buffer.constant utf8("") : buffer
  %number = func.call @chat_number_text(%micro) : (i64) -> (buffer)
  %header = func.call @chat_join(%prefix, %number, %suffix, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.return %header : buffer
}

// Declared tools: one canonical record per tool, keys sorted at every level.

func.def @chat_tool_spec(%output: buffer, %position: offset, %tools: buffer, %begin: i64, %length: i64) -> (offset) {
  %c0_i64 = scalar.constant 0 : i64
  %c0_i32 = scalar.constant 0 : i32
  %c2_i64 = scalar.constant 2 : i64
  %string_type = scalar.constant 0 : i64
  %absent = scalar.constant -1 : i64
  %true = scalar.constant true : i1
  %error = func.call @chat_error_tool_error() : () -> (buffer)
  %function_key = buffer.constant utf8("function") : buffer
  %name_key = buffer.constant utf8("name") : buffer
  %description_key = buffer.constant utf8("description") : buffer
  %parameters_key = buffer.constant utf8("parameters") : buffer
  %type_key = buffer.constant utf8("type") : buffer
  %function_type, %function_begin, %function_length = func.call @chat_find(%tools, %begin, %length, %function_key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  %has_function = scalar.cmpi eq, %function_type, %c2_i64 : i64
  %fn_begin = scf.select %has_function, %function_begin, %begin : i64
  %fn_length = scf.select %has_function, %function_length, %length : i64
  %name_type, %name_begin, %name_length = func.call @chat_find(%tools, %fn_begin, %fn_length, %name_key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  %name_ok = scalar.cmpi eq, %name_type, %string_type : i64
  func.call @chat_check(%name_ok, %error) : (i1, buffer)
  %description_type, %description_begin, %description_length = func.call @chat_find(%tools, %fn_begin, %fn_length, %description_key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  %parameters_type, %parameters_begin, %parameters_length = func.call @chat_find(%tools, %fn_begin, %fn_length, %parameters_key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  %kind_type, %kind_begin, %kind_length = func.call @chat_find(%tools, %begin, %length, %type_key) : (buffer, i64, i64, buffer) -> (i64, i64, i64)
  %open = buffer.constant utf8("{\"description\":") : buffer
  %name_label = buffer.constant utf8(",\"name\":") : buffer
  %parameters_label = buffer.constant utf8(",\"parameters\":") : buffer
  %type_label = buffer.constant utf8(",\"type\":") : buffer
  %close = buffer.constant utf8("}") : buffer
  %empty_string = buffer.constant utf8("\"\"") : buffer
  %empty_object = buffer.constant utf8("{}") : buffer
  %function_string = buffer.constant utf8("\"function\"") : buffer
  %p0 = func.call @chat_put(%output, %position, %open) : (buffer, offset, buffer) -> (offset)
  %description_is_string = scalar.cmpi eq, %description_type, %string_type : i64
  %description_nonempty = scalar.cmpi ugt, %description_length, %c0_i64 : i64
  %description_text = scalar.andi %description_is_string, %description_nonempty : i1
  %p1 = scf.if %description_text -> (offset) {
    %end = func.call @chat_put_string(%output, %p0, %tools, %description_begin, %description_length) : (buffer, offset, buffer, i64, i64) -> (offset)
    scf.yield %end : offset
  } else {
    %end = func.call @chat_put(%output, %p0, %empty_string) : (buffer, offset, buffer) -> (offset)
    scf.yield %end : offset
  }
  %p2 = func.call @chat_put(%output, %p1, %name_label) : (buffer, offset, buffer) -> (offset)
  %p3 = func.call @chat_put_string(%output, %p2, %tools, %name_begin, %name_length) : (buffer, offset, buffer, i64, i64) -> (offset)
  %p4 = func.call @chat_put(%output, %p3, %parameters_label) : (buffer, offset, buffer) -> (offset)
  %has_parameters = scalar.cmpi eq, %parameters_type, %c2_i64 : i64
  %p5 = scf.if %has_parameters -> (offset) {
    %end = func.call @chat_put_object(%output, %p4, %tools, %parameters_begin, %parameters_length, %true, %true) : (buffer, offset, buffer, i64, i64, i1, i1) -> (offset)
    scf.yield %end : offset
  } else {
    %end = func.call @chat_put(%output, %p4, %empty_object) : (buffer, offset, buffer) -> (offset)
    scf.yield %end : offset
  }
  %p6 = func.call @chat_put(%output, %p5, %type_label) : (buffer, offset, buffer) -> (offset)
  %kind_is_string = scalar.cmpi eq, %kind_type, %string_type : i64
  %kind_nonempty = scalar.cmpi ugt, %kind_length, %c0_i64 : i64
  %kind_text = scalar.andi %kind_is_string, %kind_nonempty : i1
  %p7 = scf.if %kind_text -> (offset) {
    %end = func.call @chat_put_string(%output, %p6, %tools, %kind_begin, %kind_length) : (buffer, offset, buffer, i64, i64) -> (offset)
    scf.yield %end : offset
  } else {
    %end = func.call @chat_put(%output, %p6, %function_string) : (buffer, offset, buffer) -> (offset)
    scf.yield %end : offset
  }
  %p8 = func.call @chat_put(%output, %p7, %close) : (buffer, offset, buffer) -> (offset)
  func.return %p8 : offset
}

func.def @chat_tool_declaration(%tools: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i64 = scalar.constant 0 : i64
  %c2_i64 = scalar.constant 2 : i64
  %empty = buffer.constant utf8("") : buffer
  %error = func.call @chat_error_tool_error() : () -> (buffer)
  %records, %type, %count64 = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %has_tools = scalar.cmpi ne, %count64, %c0_i64 : i64
  %result = scf.if %has_tools -> (buffer) {
    %bounded = scalar.assume %count64 [range(%count64, 1, 33554431)] : i64
    %count = index.cast %bounded : i64 to index
    %fields = buffer.view %records[%origin] : buffer -> view<[%count]x5xi64>
    %prefix = buffer.constant utf8("<|message_system|>tool_declare<|content_xml|>[") : buffer
    %suffix = buffer.constant utf8("]<|end_message|>") : buffer
    %comma = buffer.constant utf8(",") : buffer
    %tools_length = buffer.length %tools
    %c6 = index.constant 6 : offset
    %c512 = index.constant 512 : offset
    %tools_index = index.cast %tools_length : offset to index
    %scaled = index.scale %tools_index, %c6 : index, offset -> offset
    %extra = index.scale %count, %c512 : index, offset -> offset
    %margin = index.add %scaled, %extra : offset
    %capacity = index.add %margin, %c512 : offset
    %output = buffer.alloca<private> align(1) %capacity : buffer
    %start = func.call @chat_put(%output, %origin, %prefix) : (buffer, offset, buffer) -> (offset)
    %end = scf.for %i = [%c0 to %count step %c1](%at = %start : offset) -> (offset) {
      %value_begin = view.load %fields[%i, 2] : view<[%count]x5xi64> -> i64
      %value_length = view.load %fields[%i, 3] : view<[%count]x5xi64> -> i64
      %value_type = view.load %fields[%i, 4] : view<[%count]x5xi64> -> i64
      %is_object = scalar.cmpi eq, %value_type, %c2_i64 : i64
      func.call @chat_check(%is_object, %error) : (i1, buffer)
      %first = index.cmp eq, %i, %c0 : index
      %separated = scf.if %first -> (offset) {
        scf.yield %at : offset
      } else {
        %next = func.call @chat_put(%output, %at, %comma) : (buffer, offset, buffer) -> (offset)
        scf.yield %next : offset
      }
      %after = func.call @chat_tool_spec(%output, %separated, %tools, %value_begin, %value_length) : (buffer, offset, buffer, i64, i64) -> (offset)
      scf.yield %after : offset
    }
    %final = func.call @chat_put(%output, %end, %suffix) : (buffer, offset, buffer) -> (offset)
    %final_length = index.cast %final : offset to i64
    %exact = func.call @chat_range(%output, %c0_i64, %final_length) : (buffer, i64, i64) -> (buffer)
    scf.yield %exact : buffer
  } else {
    scf.yield %empty : buffer
  }
  func.return %result : buffer
}

// Request options: F32 temperature, F32 top-p, I32 top-k, I32 flags (bit 0 explicit seed, bit 1 tool calls forbidden), I64 seed.

func.def @chat_sampling_check(%valid: i1) {
  %error = func.call @chat_error_sampling_error() : () -> (buffer)
  func.call @chat_check(%valid, %error) : (i1, buffer)
  func.return
}

// Key classes: 1 temperature, 2 top_p, 3 top_k, 4 seed, 5 tool_choice, 10..14 numeric fields with a default, 15 logprobs, 16 null-only fields, 17 chat_template_kwargs (read by chat_effort), 0 other.
func.def @chat_key_class(%key: buffer) -> (i64) {
  %c0 = scalar.constant 0 : i64
  %temperature = buffer.constant utf8("temperature") : buffer
  %top_p = buffer.constant utf8("top_p") : buffer
  %top_k = buffer.constant utf8("top_k") : buffer
  %seed = buffer.constant utf8("seed") : buffer
  %tool_choice = buffer.constant utf8("tool_choice") : buffer
  %n = buffer.constant utf8("n") : buffer
  %frequency = buffer.constant utf8("frequency_penalty") : buffer
  %presence = buffer.constant utf8("presence_penalty") : buffer
  %repetition = buffer.constant utf8("repetition_penalty") : buffer
  %min_p = buffer.constant utf8("min_p") : buffer
  %logprobs = buffer.constant utf8("logprobs") : buffer
  %stop = buffer.constant utf8("stop") : buffer
  %top_logprobs = buffer.constant utf8("top_logprobs") : buffer
  %logit_bias = buffer.constant utf8("logit_bias") : buffer
  %response_format = buffer.constant utf8("response_format") : buffer
  %template_kwargs = buffer.constant utf8("chat_template_kwargs") : buffer
  %c1 = scalar.constant 1 : i64
  %c2 = scalar.constant 2 : i64
  %c3 = scalar.constant 3 : i64
  %c4 = scalar.constant 4 : i64
  %c5 = scalar.constant 5 : i64
  %c10 = scalar.constant 10 : i64
  %c11 = scalar.constant 11 : i64
  %c12 = scalar.constant 12 : i64
  %c13 = scalar.constant 13 : i64
  %c14 = scalar.constant 14 : i64
  %c15 = scalar.constant 15 : i64
  %c16 = scalar.constant 16 : i64
  %m1 = func.call @chat_equal(%key, %temperature) : (buffer, buffer) -> (i1)
  %m2 = func.call @chat_equal(%key, %top_p) : (buffer, buffer) -> (i1)
  %m3 = func.call @chat_equal(%key, %top_k) : (buffer, buffer) -> (i1)
  %m4 = func.call @chat_equal(%key, %seed) : (buffer, buffer) -> (i1)
  %m5 = func.call @chat_equal(%key, %tool_choice) : (buffer, buffer) -> (i1)
  %m10 = func.call @chat_equal(%key, %n) : (buffer, buffer) -> (i1)
  %m11 = func.call @chat_equal(%key, %frequency) : (buffer, buffer) -> (i1)
  %m12 = func.call @chat_equal(%key, %presence) : (buffer, buffer) -> (i1)
  %m13 = func.call @chat_equal(%key, %repetition) : (buffer, buffer) -> (i1)
  %m14 = func.call @chat_equal(%key, %min_p) : (buffer, buffer) -> (i1)
  %m15 = func.call @chat_equal(%key, %logprobs) : (buffer, buffer) -> (i1)
  %s1 = func.call @chat_equal(%key, %stop) : (buffer, buffer) -> (i1)
  %s2 = func.call @chat_equal(%key, %top_logprobs) : (buffer, buffer) -> (i1)
  %s3 = func.call @chat_equal(%key, %logit_bias) : (buffer, buffer) -> (i1)
  %s4 = func.call @chat_equal(%key, %response_format) : (buffer, buffer) -> (i1)
  %s5 = func.call @chat_equal(%key, %template_kwargs) : (buffer, buffer) -> (i1)
  %t1 = scalar.ori %s1, %s2 : i1
  %t2 = scalar.ori %s3, %s4 : i1
  %null_only = scalar.ori %t1, %t2 : i1
  %c17 = scalar.constant 17 : i64
  %k00 = scf.select %null_only, %c16, %c0 : i64
  %k0 = scf.select %s5, %c17, %k00 : i64
  %k1 = scf.select %m15, %c15, %k0 : i64
  %k2 = scf.select %m14, %c14, %k1 : i64
  %k3 = scf.select %m13, %c13, %k2 : i64
  %k4 = scf.select %m12, %c12, %k3 : i64
  %k5 = scf.select %m11, %c11, %k4 : i64
  %k6 = scf.select %m10, %c10, %k5 : i64
  %k7 = scf.select %m5, %c5, %k6 : i64
  %k8 = scf.select %m4, %c4, %k7 : i64
  %k9 = scf.select %m3, %c3, %k8 : i64
  %k10 = scf.select %m2, %c2, %k9 : i64
  %k11 = scf.select %m1, %c1, %k10 : i64
  func.return %k11 : i64
}

// The numeric default of an unsupported field, as F64.
func.def @chat_key_default(%class: i64) -> (f64) {
  %c0_f64 = scalar.constant 0.0 : f64
  %c1_f64 = scalar.constant 1.0 : f64
  %c10 = scalar.constant 10 : i64
  %c13 = scalar.constant 13 : i64
  %is_n = scalar.cmpi eq, %class, %c10 : i64
  %is_repetition = scalar.cmpi eq, %class, %c13 : i64
  %is_one = scalar.ori %is_n, %is_repetition : i1
  %value = scf.select %is_one, %c1_f64, %c0_f64 : f64
  func.return %value : f64
}

// Applies the sampling members of a JSON object to the 24-byte option record. A strict object (deployment defaults) accepts only the four sampling keys.
func.def @chat_sampling_overlay(%source: buffer, %strict: i1, %configuration: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c2_i64 = scalar.constant 2 : i64
  %c3_i64 = scalar.constant 3 : i64
  %c4_i64 = scalar.constant 4 : i64
  %c5_i64 = scalar.constant 5 : i64
  %c10_i64 = scalar.constant 10 : i64
  %c15_i64 = scalar.constant 15 : i64
  %c17_i64 = scalar.constant 17 : i64
  %string_type = scalar.constant 0 : i64
  %number_type = scalar.constant 1 : i64
  %false_type = scalar.constant 5 : i64
  %null_type = scalar.constant 6 : i64
  %object_type = scalar.constant 2 : i32
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %c0_f64 = scalar.constant 0.0 : f64
  %c1_f64 = scalar.constant 1.0 : f64
  %largest = scalar.constant 3.4028234663852886e+38 : f64
  %smallest = scalar.constant 1.1754943508222875e-38 : f64
  %limit = scalar.constant 2147483647 : i64
  %fields, %type, %count64 = func.call @members(%source) : (buffer) -> (buffer, i32, i64)
  %is_object = scalar.cmpi eq, %type, %object_type : i32
  func.call @chat_sampling_check(%is_object) : (i1)
  %bounded = scalar.assume %count64 [range(%count64, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %words = buffer.view %configuration[%origin] : buffer -> view<6xi32>
  %floats = buffer.view %configuration[%origin] : buffer -> view<6xf32>
  %seed_origin = index.constant 16 : offset
  %seed_view = buffer.view %configuration[%seed_origin] : buffer -> view<1xi64>
  %request = scalar.xori %strict, %true : i1
  %none = buffer.constant utf8("none") : buffer
  %unsupported = func.call @chat_error_unsupported_error() : () -> (buffer)
  %seen = scf.for %i = [%c0 to %extent step %c1](%mask = %c0_i64 : i64) -> (i64) {
    %key_begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %key = func.call @chat_decode(%source, %key_begin, %key_length) : (buffer, i64, i64) -> (buffer)
    %class = func.call @chat_key_class(%key) : (buffer) -> (i64)
    %is_null = scalar.cmpi eq, %value_type, %null_type : i64
    %known = scalar.cmpi ne, %class, %c0_i64 : i64
    %class_allowed = scalar.ori %known, %request : i1
    func.call @chat_sampling_check(%class_allowed) : (i1)
    %at_most_seed = scalar.cmpi ule, %class, %c4_i64 : i64
    %is_sampling = scalar.andi %known, %at_most_seed : i1
    %strict_class = scalar.ori %request, %is_sampling : i1
    func.call @chat_sampling_check(%strict_class) : (i1)
    %not_null = scalar.xori %is_null, %true : i1
    %null_allowed = scalar.ori %not_null, %request : i1
    func.call @chat_sampling_check(%null_allowed) : (i1)
    %bit = scalar.shli %c1_i64, %class : i64
    %seen_bits = scalar.andi %mask, %bit : i64
    %fresh = scalar.cmpi eq, %seen_bits, %c0_i64 : i64
    %at_most_choice = scalar.cmpi ule, %class, %c5_i64 : i64
    %tracked = scalar.andi %known, %at_most_choice : i1
    %untracked = scalar.xori %tracked, %true : i1
    %unique = scalar.ori %fresh, %untracked : i1
    func.call @chat_sampling_check(%unique) : (i1)
    scf.if %not_null {
      %is_number = scalar.cmpi eq, %value_type, %number_type : i64
      %is_temperature = scalar.cmpi eq, %class, %c1_i64 : i64
      %is_p = scalar.cmpi eq, %class, %c2_i64 : i64
      %is_k = scalar.cmpi eq, %class, %c3_i64 : i64
      %is_seed = scalar.cmpi eq, %class, %c4_i64 : i64
      %is_choice = scalar.cmpi eq, %class, %c5_i64 : i64
      %is_float = scalar.ori %is_temperature, %is_p : i1
      %is_integer = scalar.ori %is_k, %is_seed : i1
      %needs_number = scalar.ori %is_float, %is_integer : i1
      %number_missing = scalar.xori %is_number, %true : i1
      %bad_number = scalar.andi %needs_number, %number_missing : i1
      %number_ok = scalar.xori %bad_number, %true : i1
      func.call @chat_sampling_check(%number_ok) : (i1)
      scf.if %is_float {
        %value = func.call @parse_f64(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (f64)
        %is_zero = scalar.cmpf oeq, %value, %c0_f64 : f64
        %normal = scalar.cmpf oge, %value, %smallest : f64
        %finite = scalar.cmpf ole, %value, %largest : f64
        %nonnegative = scalar.ori %is_zero, %normal : i1
        %valid_temperature = scalar.andi %nonnegative, %finite : i1
        %probability = scalar.cmpf ole, %value, %c1_f64 : f64
        %valid_p = scalar.andi %normal, %probability : i1
        %valid = scf.select %is_temperature, %valid_temperature, %valid_p : i1
        func.call @chat_sampling_check(%valid) : (i1)
        %value32 = scalar.fptrunc %value : f64 to f32
        %slot = scf.select %is_temperature, %c0, %c1 : index
        view.store %value32, %floats[%slot] : f32, view<6xf32>
      }
      scf.if %is_integer {
        %value = func.call @parse_i64(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
        scf.if %is_seed {
          view.store %value, %seed_view[0] : i64, view<1xi64>
          %flags = view.load %words[3] : view<6xi32> -> i32
          %explicit = scalar.ori %flags, %c1_i32 : i32
          view.store %explicit, %words[3] : i32, view<6xi32>
        } else {
          %valid = scalar.cmpi ule, %value, %limit : i64
          func.call @chat_sampling_check(%valid) : (i1)
          %value32 = scalar.trunci %value : i64 to i32
          view.store %value32, %words[2] : i32, view<6xi32>
        }
      }
      scf.if %is_choice {
        %is_string = scalar.cmpi eq, %value_type, %string_type : i64
        %disabled = scf.if %is_string -> (i1) {
          %text = func.call @chat_decode(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
          %matches = func.call @chat_equal(%text, %none) : (buffer, buffer) -> (i1)
          scf.yield %matches : i1
        } else {
          scf.yield %false : i1
        }
        %flags = view.load %words[3] : view<6xi32> -> i32
        %forbid = scf.select %disabled, %c2_i32, %c0_i32 : i32
        %updated = scalar.ori %flags, %forbid : i32
        view.store %updated, %words[3] : i32, view<6xi32>
      }
      %is_unsupported = scalar.cmpi uge, %class, %c10_i64 : i64
      scf.if %is_unsupported {
        %is_logprobs = scalar.cmpi eq, %class, %c15_i64 : i64
        %above_logprobs = scalar.cmpi ugt, %class, %c15_i64 : i64
        %is_false = scalar.cmpi eq, %value_type, %false_type : i64
        %numeric_default = func.call @chat_key_default(%class) : (i64) -> (f64)
        %matches_default = scf.if %is_number -> (i1) {
          %value = func.call @parse_f64(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (f64)
          %same = scalar.cmpf oeq, %value, %numeric_default : f64
          scf.yield %same : i1
        } else {
          scf.yield %false : i1
        }
        %logprobs_default = scalar.andi %is_logprobs, %is_false : i1
        %default_ok = scalar.ori %matches_default, %logprobs_default : i1
        %not_null_only = scalar.xori %above_logprobs, %true : i1
        %default_accepted = scalar.andi %default_ok, %not_null_only : i1
        %is_kwargs = scalar.cmpi eq, %class, %c17_i64 : i64
        %is_kwargs_object = scalar.cmpi eq, %value_type, %c2_i64 : i64
        %kwargs_accepted = scalar.andi %is_kwargs, %is_kwargs_object : i1
        %acceptable = scalar.ori %default_accepted, %kwargs_accepted : i1
        func.call @chat_check(%acceptable, %unsupported) : (i1, buffer)
      }
    }
    %next_mask = scalar.ori %mask, %bit : i64
    scf.yield %next_mask : i64
  }
  func.return
}

func.def public @text_request_defaults_v1(%options: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_f32 = scalar.constant 1.0 : f32
  %configuration = buffer.alloca<private> align(8) %bytes : buffer
  buffer.fill %c0_i32, %configuration[%origin], %bytes : i32
  %floats = buffer.view %configuration[%origin] : buffer -> view<6xf32>
  view.store %c1_f32, %floats[0] : f32, view<6xf32>
  view.store %c1_f32, %floats[1] : f32, view<6xf32>
  %fields, %type, %count64 = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object_type = scalar.constant 2 : i32
  %is_object = scalar.cmpi eq, %type, %object_type : i32
  func.call @chat_sampling_check(%is_object) : (i1)
  %bounded = scalar.assume %count64 [range(%count64, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %sampling = buffer.constant utf8("sampling") : buffer
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %seen = scf.for %i = [%c0 to %extent step %c1](%before = %false : i1) -> (i1) {
    %key_begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %key = func.call @chat_decode(%options, %key_begin, %key_length) : (buffer, i64, i64) -> (buffer)
    %is_sampling = func.call @chat_equal(%key, %sampling) : (buffer, buffer) -> (i1)
    %unique = scalar.xori %before, %true : i1
    %valid = scalar.andi %is_sampling, %unique : i1
    func.call @chat_sampling_check(%valid) : (i1)
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value = func.call @chat_range(%options, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
    func.call @chat_sampling_overlay(%value, %true, %configuration) : (buffer, i1, buffer)
    scf.yield %true : i1
  }
  func.return %configuration : buffer
}

func.def public @text_request_options_v1(%defaults: buffer, %request: buffer, %nonce: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24 : offset
  %seed_origin = index.constant 16 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %false = scalar.constant false : i1
  %configuration = buffer.alloca<private> align(8) %bytes : buffer
  buffer.copy %defaults[%origin], %configuration[%origin], %bytes
  func.call @chat_sampling_overlay(%request, %false, %configuration) : (buffer, i1, buffer)
  %words = buffer.view %configuration[%origin] : buffer -> view<6xi32>
  %flags = view.load %words[3] : view<6xi32> -> i32
  %explicit_bit = scalar.andi %flags, %c1_i32 : i32
  %implicit = scalar.cmpi eq, %explicit_bit, %c0_i32 : i32
  scf.if %implicit {
    %seed = buffer.view %configuration[%seed_origin] : buffer -> view<1xi64>
    view.store %nonce, %seed[0] : i64, view<1xi64>
  }
  func.return %configuration : buffer
}

// The row table starts at byte 40 of the control state (library layout).
func.def public @text_bind_request_v1(%state: buffer, %row: i32, %options: buffer) {
  %table = index.constant 40 : offset
  %stride = index.constant 24 : offset
  %origin = index.constant 0 : offset
  %bounded_row = scalar.assume %row [range(%row, 0, 2147483647)] : i32
  %row_value = index.cast %bounded_row : i32 to index
  %row_offset = index.scale %row_value, %stride : index, offset -> offset
  %target = index.add %table, %row_offset : offset
  buffer.copy %options[%origin], %state[%target], %stride
  func.return
}

func.def public @text_chat_reasoning_v1() -> (i32, i32, i32) {
  %supported = scalar.constant 1 : i32
  %efforts = scalar.constant 63 : i32
  %default = scalar.constant 4 : i32
  func.return %supported, %efforts, %default : i32, i32, i32
}

func.def public @text_chat_image_limits_v1() -> (i64, i64, i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  func.return %c0, %c0, %c0, %c0, %c0 : i64, i64, i64, i64, i64
}

// Rendering.

func.def public @text_chat_begin_v1(%request: buffer, %tools: buffer) -> (buffer, i64) {
  %micro = func.call @chat_effort(%request) : (buffer) -> (i64)
  %declaration = func.call @chat_tool_declaration(%tools) : (buffer) -> (buffer)
  func.return %declaration, %micro : buffer, i64
}

// One text message per content part, or the single string content.
func.def @chat_text_parts(%token: buffer, %content: buffer, %parts: buffer, %part_count: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %marker = buffer.constant utf8("<|content_text|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %error = func.call @chat_error_parts_error() : () -> (buffer)
  %bounded = scalar.assume %part_count [range(%part_count, 0, 4096)] : i64
  %count = index.cast %bounded : i64 to index
  %records = buffer.view %parts[%origin] : buffer -> view<[%count]x6xi32>
  %fixed_a = func.call @chat_size_after(%origin, %token) : (offset, buffer) -> (offset)
  %fixed_b = func.call @chat_size_after(%fixed_a, %marker) : (offset, buffer) -> (offset)
  %fixed = func.call @chat_size_after(%fixed_b, %end_message) : (offset, buffer) -> (offset)
  %total = scf.for %i = [%c0 to %count step %c1](%sum = %origin : offset) -> (offset) {
    %kind = view.load %records[%i, 0] : view<[%count]x6xi32> -> i32
    %is_text = scalar.cmpi eq, %kind, %c0_i32 : i32
    func.call @chat_check(%is_text, %error) : (i1, buffer)
    %length32 = view.load %records[%i, 2] : view<[%count]x6xi32> -> i32
    %length64 = scalar.extui %length32 : i32 to i64
    %length64_ok = scalar.assume %length64 [range(%length64, 0, 9223372036854775807)] : i64
    %length = index.cast %length64_ok : i64 to offset
    %with_fixed = index.add %sum, %fixed : offset
    %next = index.add %with_fixed, %length : offset
    scf.yield %next : offset
  }
  %output = buffer.alloca<private> align(1) %total : buffer
  %end = scf.for %i = [%c0 to %count step %c1](%at = %origin : offset) -> (offset) {
    %begin32 = view.load %records[%i, 1] : view<[%count]x6xi32> -> i32
    %length32 = view.load %records[%i, 2] : view<[%count]x6xi32> -> i32
    %begin64 = scalar.extui %begin32 : i32 to i64
    %length64 = scalar.extui %length32 : i32 to i64
    %begin64_ok = scalar.assume %begin64 [range(%begin64, 0, 9223372036854775807)] : i64
    %begin = index.cast %begin64_ok : i64 to offset
    %length64_ok = scalar.assume %length64 [range(%length64, 0, 9223372036854775807)] : i64
    %length = index.cast %length64_ok : i64 to offset
    %a = func.call @chat_put(%output, %at, %token) : (buffer, offset, buffer) -> (offset)
    %b = func.call @chat_put(%output, %a, %marker) : (buffer, offset, buffer) -> (offset)
    buffer.copy %content[%begin], %output[%b], %length
    %c = index.add %b, %length : offset
    %d = func.call @chat_put(%output, %c, %end_message) : (buffer, offset, buffer) -> (offset)
    scf.yield %d : offset
  }
  func.return %output : buffer
}

func.def public @text_chat_message_v1(%raw: buffer, %role: buffer, %content: buffer, %parts: buffer, %frames: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer, i64) {
  %empty = buffer.constant utf8("") : buffer
  %c0_i64 = scalar.constant 0 : i64
  %string_type = scalar.constant 0 : i64
  %array_type = scalar.constant 3 : i64
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %user_role = buffer.constant utf8("user") : buffer
  %assistant_role = buffer.constant utf8("assistant") : buffer
  %system_role = buffer.constant utf8("system") : buffer
  %tool_role = buffer.constant utf8("tool") : buffer
  %user = func.call @chat_equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %assistant = func.call @chat_equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %system = func.call @chat_equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %tool = func.call @chat_equal(%role, %tool_role) : (buffer, buffer) -> (i1)
  %known_a = scalar.ori %user, %assistant : i1
  %known_b = scalar.ori %system, %tool : i1
  %known = scalar.ori %known_a, %known_b : i1
  %role_error = func.call @chat_error_message_error() : () -> (buffer)
  func.call @chat_check(%known, %role_error) : (i1, buffer)
  %bit = func.call @chat_state_header_bit() : () -> (i64)
  %emitted_bits = scalar.andi %state, %bit : i64
  %emitted = scalar.cmpi ne, %emitted_bits, %c0_i64 : i64
  %not_system = scalar.xori %system, %true : i1
  %not_emitted = scalar.xori %emitted, %true : i1
  %needs_header = scalar.andi %not_system, %not_emitted : i1
  %mask = scalar.constant 1048575 : i64
  %micro = scalar.andi %state, %mask : i64
  %header = func.call @chat_effort_header(%micro) : (i64) -> (buffer)
  %leading = scf.select %needs_header, %header, %empty : buffer
  %marker_user = buffer.constant utf8("<|message_user|>") : buffer
  %marker_model = buffer.constant utf8("<|message_model|>") : buffer
  %marker_system = buffer.constant utf8("<|message_system|>") : buffer
  %marker_tool = buffer.constant utf8("<|message_tool|>") : buffer
  %b0 = scf.select %tool, %marker_tool, %marker_user : buffer
  %b1 = scf.select %system, %marker_system, %b0 : buffer
  %base = scf.select %assistant, %marker_model, %b1 : buffer
  %name_key = buffer.constant utf8("name") : buffer
  %name = func.call @chat_string_member(%raw, %name_key) : (buffer, buffer) -> (buffer)
  %has_name = func.call @chat_nonempty(%name) : (buffer) -> (i1)
  %has_calls = func.call @chat_nonempty(%calls) : (buffer) -> (i1)
  %has_reasoning = func.call @chat_nonempty(%reasoning) : (buffer) -> (i1)
  %has_content = func.call @chat_nonempty(%content) : (buffer) -> (i1)
  %named_role = scalar.ori %tool, %assistant : i1
  %uses_name = scalar.andi %named_role, %has_name : i1
  %token_name = scf.select %uses_name, %name, %empty : buffer
  %token = func.call @chat_join(%base, %token_name, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %call_name = scalar.andi %assistant, %has_name : i1
  %call_conflict = scalar.andi %call_name, %has_calls : i1
  %no_call_conflict = scalar.xori %call_conflict, %true : i1
  %assistant_name_error = func.call @chat_error_assistant_name_error() : () -> (buffer)
  func.call @chat_check(%no_call_conflict, %assistant_name_error) : (i1, buffer)
  %tool_without_name = scalar.andi %tool, %has_name : i1
  %tool_named = scalar.xori %tool, %true : i1
  %tool_ok = scalar.ori %tool_without_name, %tool_named : i1
  %tool_name_error = func.call @chat_error_tool_name_error() : () -> (buffer)
  func.call @chat_check(%tool_ok, %tool_name_error) : (i1, buffer)
  %thinking_marker = buffer.constant utf8("<|content_thinking|>") : buffer
  %text_marker = buffer.constant utf8("<|content_text|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %end_sampling = buffer.constant utf8("<|content_model_end_sampling|>") : buffer
  %thought_enabled = scalar.andi %assistant, %has_reasoning : i1
  %thought_piece = scf.if %thought_enabled -> (buffer) {
    %value = func.call @chat_join(%token, %thinking_marker, %reasoning, %end_message, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %empty : buffer
  }
  %content_key = buffer.constant utf8("content") : buffer
  %content_type, %content_begin, %content_length = func.call @chat_member(%raw, %content_key) : (buffer, buffer) -> (i64, i64, i64)
  %is_string = scalar.cmpi eq, %content_type, %string_type : i64
  %is_array = scalar.cmpi eq, %content_type, %array_type : i64
  %quiet = scalar.ori %has_calls, %has_reasoning : i1
  %assistant_quiet = scalar.andi %assistant, %quiet : i1
  %not_quiet = scalar.xori %assistant_quiet, %true : i1
  %string_wanted = scalar.ori %has_content, %not_quiet : i1
  %string_included = scalar.andi %is_string, %string_wanted : i1
  %has_parts = scalar.cmpi ne, %part_count, %c0_i64 : i64
  %array_included = scalar.andi %is_array, %has_parts : i1
  %content_piece = scf.if %string_included -> (buffer) {
    %value = func.call @chat_join(%token, %text_marker, %content, %end_message, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    %value = scf.if %array_included -> (buffer) {
      %parts_text = func.call @chat_text_parts(%token, %content, %parts, %part_count) : (buffer, buffer, buffer, i64) -> (buffer)
      scf.yield %parts_text : buffer
    } else {
      scf.yield %empty : buffer
    }
    scf.yield %value : buffer
  }
  %call_piece = scf.select %assistant, %calls, %empty : buffer
  %end_piece = scf.select %assistant, %end_sampling, %empty : buffer
  %fragment = func.call @chat_join(%leading, %thought_piece, %content_piece, %call_piece, %end_piece, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %marked = scalar.ori %state, %bit : i64
  %next_state = scf.select %needs_header, %marked, %state : i64
  func.return %fragment, %next_state, %empty, %c0_i64 : buffer, i64, buffer, i64
}

func.def public @text_chat_end_v1(%state: i64) -> (buffer, i64) {
  %c0_i64 = scalar.constant 0 : i64
  %empty = buffer.constant utf8("") : buffer
  %bit = func.call @chat_state_header_bit() : () -> (i64)
  %emitted_bits = scalar.andi %state, %bit : i64
  %emitted = scalar.cmpi ne, %emitted_bits, %c0_i64 : i64
  %mask = scalar.constant 1048575 : i64
  %micro = scalar.andi %state, %mask : i64
  %header = func.call @chat_effort_header(%micro) : (i64) -> (buffer)
  %suffix = scf.select %emitted, %empty, %header : buffer
  func.return %suffix, %c0_i64 : buffer, i64
}

func.def @chat_error_effort_error() -> (buffer) {
  %text = buffer.constant utf8("reasoning_effort must be none, minimal, low, medium, high, xhigh or max, or a number in [0, 0.99] with at most six decimals") : buffer
  func.return %text : buffer
}

func.def @chat_error_kwargs_error() -> (buffer) {
  %text = buffer.constant utf8("chat_template_kwargs must be an object with only reasoning_effort and enable_thinking (true or false)") : buffer
  func.return %text : buffer
}

func.def @chat_error_effort_conflict_error() -> (buffer) {
  %text = buffer.constant utf8("reasoning_effort, chat_template_kwargs.reasoning_effort and chat_template_kwargs.enable_thinking must not conflict") : buffer
  func.return %text : buffer
}

func.def @chat_error_tool_error() -> (buffer) {
  %text = buffer.constant utf8("each tool must be an object with a string function name") : buffer
  func.return %text : buffer
}

func.def @chat_error_sampling_error() -> (buffer) {
  %text = buffer.constant utf8("sampling options must be temperature >= 0, top_p in (0, 1], top_k in [0, 2147483647] and an integer seed") : buffer
  func.return %text : buffer
}

func.def @chat_error_unsupported_error() -> (buffer) {
  %text = buffer.constant utf8("this request field is supported only with its default value") : buffer
  func.return %text : buffer
}

func.def @chat_error_message_error() -> (buffer) {
  %text = buffer.constant utf8("message role must be user, assistant, system or tool") : buffer
  func.return %text : buffer
}

func.def @chat_error_tool_name_error() -> (buffer) {
  %text = buffer.constant utf8("a tool message needs a name: the policy sees one message at a time and cannot look the function name up from tool_call_id") : buffer
  func.return %text : buffer
}

func.def @chat_error_assistant_name_error() -> (buffer) {
  %text = buffer.constant utf8("an assistant message with tool calls cannot have a name") : buffer
  func.return %text : buffer
}

func.def @chat_error_parts_error() -> (buffer) {
  %text = buffer.constant utf8("only text content parts are supported") : buffer
  func.return %text : buffer
}

func.def @chat_error_call_error() -> (buffer) {
  %text = buffer.constant utf8("tool call needs a name of 1 to 128 letters, digits, underscores, hyphens or periods and a JSON object of arguments") : buffer
  func.return %text : buffer
}

func.def @chat_error_generated_error() -> (buffer) {
  %text = buffer.constant utf8("the model produced a malformed tool call") : buffer
  func.return %text : buffer
}

// Tool calls.

func.def @chat_identifier(%text: buffer) -> (i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %length = buffer.length %text
  %count = index.cast %length : offset to index
  %c128 = index.constant 128 : offset
  %c0_offset = index.constant 0 : offset
  %nonempty = index.cmp ne, %length, %c0_offset : offset
  %bounded = index.cmp ule, %length, %c128 : offset
  %valid_length = scalar.andi %nonempty, %bounded : i1
  %case_bit = scalar.constant 32 : i32
  %a = scalar.constant 97 : i32
  %z = scalar.constant 122 : i32
  %digit_zero = scalar.constant 48 : i32
  %digit_nine = scalar.constant 57 : i32
  %underscore = scalar.constant 95 : i32
  %dash = scalar.constant 45 : i32
  %dot = scalar.constant 46 : i32
  %valid = scf.for %i = [%c0 to %count step %c1](%prior = %valid_length : i1) -> (i1) {
    %relative = index.cast %i : index to offset
    %byte = buffer.load.i8.u %text[%relative]
    %lower = scalar.ori %byte, %case_bit : i32
    %after_a = scalar.cmpi uge, %lower, %a : i32
    %before_z = scalar.cmpi ule, %lower, %z : i32
    %letter = scalar.andi %after_a, %before_z : i1
    %after_zero = scalar.cmpi uge, %byte, %digit_zero : i32
    %before_nine = scalar.cmpi ule, %byte, %digit_nine : i32
    %digit = scalar.andi %after_zero, %before_nine : i1
    %is_underscore = scalar.cmpi eq, %byte, %underscore : i32
    %is_dash = scalar.cmpi eq, %byte, %dash : i32
    %is_dot = scalar.cmpi eq, %byte, %dot : i32
    %punctuation_a = scalar.ori %is_underscore, %is_dash : i1
    %punctuation = scalar.ori %punctuation_a, %is_dot : i1
    %alphanumeric = scalar.ori %letter, %digit : i1
    %allowed = scalar.ori %alphanumeric, %punctuation : i1
    %next = scalar.andi %prior, %allowed : i1
    scf.yield %next : i1
  }
  func.return %valid : i1
}

// The model writes a call as a message named by the function whose payload is {"name":..,"args":{..}}; history uses the same text with sorted argument keys.
func.def public @text_render_tool_v1(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %origin = index.constant 0 : offset
  %c0_i64 = scalar.constant 0 : i64
  %c2_i32 = scalar.constant 2 : i32
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %error = func.call @chat_error_call_error() : () -> (buffer)
  %valid_name = func.call @chat_identifier(%name) : (buffer) -> (i1)
  func.call @chat_check(%valid_name, %error) : (i1, buffer)
  %trimmed = func.call @chat_trim(%arguments) : (buffer) -> (buffer)
  %has_arguments = func.call @chat_nonempty(%trimmed) : (buffer) -> (i1)
  %arguments_length = buffer.length %trimmed
  %arguments_length64 = index.cast %arguments_length : offset to i64
  %fields, %type, %count = scf.if %has_arguments -> (buffer, i32, i64) {
    %parsed_fields, %parsed_type, %parsed_count = func.call @members(%trimmed) : (buffer) -> (buffer, i32, i64)
    scf.yield %parsed_fields, %parsed_type, %parsed_count : buffer, i32, i64
  } else {
    %empty_fields = buffer.constant utf8("") : buffer
    scf.yield %empty_fields, %c2_i32, %c0_i64 : buffer, i32, i64
  }
  %is_object = scalar.cmpi eq, %type, %c2_i32 : i32
  func.call @chat_check(%is_object, %error) : (i1, buffer)
  %open = buffer.constant utf8("<|message_model|>") : buffer
  %kind = buffer.constant utf8("<|content_invoke_tool_json|>{\"name\":\"") : buffer
  %args_label = buffer.constant utf8("\",\"args\":") : buffer
  %close = buffer.constant utf8("}<|end_message|>") : buffer
  %empty_object = buffer.constant utf8("{}") : buffer
  %name_length = buffer.length %name
  %c6 = index.constant 6 : offset
  %c256 = index.constant 256 : offset
  %arguments_index = index.cast %arguments_length : offset to index
  %scaled = index.scale %arguments_index, %c6 : index, offset -> offset
  %with_name = index.add %scaled, %name_length : offset
  %with_name_again = index.add %with_name, %name_length : offset
  %capacity = index.add %with_name_again, %c256 : offset
  %output = buffer.alloca<private> align(1) %capacity : buffer
  %p0 = func.call @chat_put(%output, %origin, %open) : (buffer, offset, buffer) -> (offset)
  %p1 = func.call @chat_put(%output, %p0, %name) : (buffer, offset, buffer) -> (offset)
  %p2 = func.call @chat_put(%output, %p1, %kind) : (buffer, offset, buffer) -> (offset)
  %p3 = func.call @chat_put(%output, %p2, %name) : (buffer, offset, buffer) -> (offset)
  %p4 = func.call @chat_put(%output, %p3, %args_label) : (buffer, offset, buffer) -> (offset)
  %p5 = scf.if %has_arguments -> (offset) {
    %end = func.call @chat_put_object(%output, %p4, %trimmed, %c0_i64, %arguments_length64, %true, %false) : (buffer, offset, buffer, i64, i64, i1, i1) -> (offset)
    scf.yield %end : offset
  } else {
    %end = func.call @chat_put(%output, %p4, %empty_object) : (buffer, offset, buffer) -> (offset)
    scf.yield %end : offset
  }
  %p6 = func.call @chat_put(%output, %p5, %close) : (buffer, offset, buffer) -> (offset)
  %length = index.cast %p6 : offset to i64
  func.return %output, %length : buffer, i64
}

// Appends one call record built from a generated block. Returns the new position.
func.def @chat_emit_call(%output: buffer, %position: offset, %calls: i64, %name: buffer, %payload: buffer) -> (offset) {
  %c0_i64 = scalar.constant 0 : i64
  %c2_i32 = scalar.constant 2 : i32
  %c2_i64 = scalar.constant 2 : i64
  %error = func.call @chat_error_generated_error() : () -> (buffer)
  %name_key = buffer.constant utf8("name") : buffer
  %args_key = buffer.constant utf8("args") : buffer
  %absent = scalar.constant -1 : i64
  %fields, %type, %count = func.call @members(%payload) : (buffer) -> (buffer, i32, i64)
  %is_object = scalar.cmpi eq, %type, %c2_i32 : i32
  func.call @chat_check(%is_object, %error) : (i1, buffer)
  %payload_name = func.call @chat_string_member(%payload, %name_key) : (buffer, buffer) -> (buffer)
  %same_name = func.call @chat_equal(%payload_name, %name) : (buffer, buffer) -> (i1)
  %valid_name = func.call @chat_identifier(%name) : (buffer) -> (i1)
  %valid_header = scalar.andi %same_name, %valid_name : i1
  func.call @chat_check(%valid_header, %error) : (i1, buffer)
  %args_type, %args_begin, %args_length = func.call @chat_member(%payload, %args_key) : (buffer, buffer) -> (i64, i64, i64)
  %args_absent = scalar.cmpi eq, %args_type, %absent : i64
  %args_object = scalar.cmpi eq, %args_type, %c2_i64 : i64
  %args_valid = scalar.ori %args_absent, %args_object : i1
  func.call @chat_check(%args_valid, %error) : (i1, buffer)
  %empty_object = buffer.constant utf8("{}") : buffer
  %args_text = scf.if %args_object -> (buffer) {
    %slice = func.call @chat_range(%payload, %args_begin, %args_length) : (buffer, i64, i64) -> (buffer)
    %compact_text = func.call @compact(%slice) : (buffer) -> (buffer)
    scf.yield %compact_text : buffer
  } else {
    scf.yield %empty_object : buffer
  }
  %comma = buffer.constant utf8(",") : buffer
  %open = buffer.constant utf8("{\"type\":\"function\",\"function\":{\"name\":") : buffer
  %label = buffer.constant utf8(",\"arguments\":") : buffer
  %close = buffer.constant utf8("}}") : buffer
  %origin = index.constant 0 : offset
  %first = scalar.cmpi eq, %calls, %c0_i64 : i64
  %p0 = scf.if %first -> (offset) {
    scf.yield %position : offset
  } else {
    %next = func.call @chat_put(%output, %position, %comma) : (buffer, offset, buffer) -> (offset)
    scf.yield %next : offset
  }
  %p1 = func.call @chat_put(%output, %p0, %open) : (buffer, offset, buffer) -> (offset)
  %name_length = buffer.length %name
  %p2 = func.call @chat_put_quoted(%output, %p1, %name, %origin, %name_length) : (buffer, offset, buffer, offset, offset) -> (offset)
  %p3 = func.call @chat_put(%output, %p2, %label) : (buffer, offset, buffer) -> (offset)
  %args_size = buffer.length %args_text
  %p4 = func.call @chat_put_quoted(%output, %p3, %args_text, %origin, %args_size) : (buffer, offset, buffer, offset, offset) -> (offset)
  %p5 = func.call @chat_put(%output, %p4, %close) : (buffer, offset, buffer) -> (offset)
  func.return %p5 : offset
}

// The suffix starts at the first message that may be a call. Blocks of other kinds are skipped. An unfinished final call is omitted when the response was truncated.
func.def public @text_parse_tools_v1(%schemas: buffer, %response: buffer, %truncated: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %model = buffer.constant utf8("<|message_model|>") : buffer
  %prefix = buffer.constant utf8("<|content_") : buffer
  %tool_marker = buffer.constant utf8("<|content_invoke_tool_json|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %open_list = buffer.constant utf8("[") : buffer
  %close_list = buffer.constant utf8("]") : buffer
  %length = buffer.length %response
  %model_length = buffer.length %model
  %tool_length = buffer.length %tool_marker
  %end_length = buffer.length %end_message
  %c12 = index.constant 12 : offset
  %c256 = index.constant 256 : offset
  %length_index = index.cast %length : offset to index
  %scaled = index.scale %length_index, %c12 : index, offset -> offset
  %capacity = index.add %scaled, %c256 : offset
  %output = buffer.alloca<private> align(1) %capacity : buffer
  %start = func.call @chat_put(%output, %origin, %open_list) : (buffer, offset, buffer) -> (offset)
  %cursor_end, %position, %calls = scf.while(%cursor = %origin : offset, %at = %start : offset, %count = %c0_i64 : i64) -> (offset, offset, i64) {
    %more = index.cmp ult, %cursor, %length : offset
    scf.condition %more, %cursor, %at, %count : i1, offset, offset, i64
  } do(%cursor: offset, %at: offset, %count: i64) {
    %block = func.call @chat_find_marker(%response, %cursor, %model) : (buffer, offset, buffer) -> (offset)
    %found = index.cmp ult, %block, %length : offset
    %next_cursor, %next_at, %next_count = scf.if %found -> (offset, offset, i64) {
      %header_begin = index.add %block, %model_length : offset
      %type_begin = func.call @chat_find_marker(%response, %header_begin, %prefix) : (buffer, offset, buffer) -> (offset)
      %is_tool = func.call @chat_marker_at(%response, %type_begin, %tool_marker) : (buffer, offset, buffer) -> (i1)
      %cursor_a, %at_a, %count_a = scf.if %is_tool -> (offset, offset, i64) {
        %payload_begin = index.add %type_begin, %tool_length : offset
        %payload_end = func.call @chat_find_marker(%response, %payload_begin, %end_message) : (buffer, offset, buffer) -> (offset)
        %complete = index.cmp ult, %payload_end, %length : offset
        %not_truncated = scalar.cmpi eq, %truncated, %c0_i64 : i64
        %accept = scalar.ori %complete, %not_truncated : i1
        %resume = index.add %payload_end, %end_length : offset
        %after = scf.select %complete, %resume, %length : offset
        %cursor_b, %at_b, %count_b = scf.if %accept -> (offset, offset, i64) {
          %name_size = index.sub %type_begin, %header_begin : offset
          %name_size64 = index.cast %name_size : offset to i64
          %header_begin64 = index.cast %header_begin : offset to i64
          %name = func.call @chat_range(%response, %header_begin64, %name_size64) : (buffer, i64, i64) -> (buffer)
          %payload_size = index.sub %payload_end, %payload_begin : offset
          %payload_size64 = index.cast %payload_size : offset to i64
          %payload_begin64 = index.cast %payload_begin : offset to i64
          %payload = func.call @chat_range(%response, %payload_begin64, %payload_size64) : (buffer, i64, i64) -> (buffer)
          %written = func.call @chat_emit_call(%output, %at, %count, %name, %payload) : (buffer, offset, i64, buffer, buffer) -> (offset)
          %incremented = scalar.addi %count, %c1_i64 : i64
          scf.yield %after, %written, %incremented : offset, offset, i64
        } else {
          scf.yield %length, %at, %count : offset, offset, i64
        }
        scf.yield %cursor_b, %at_b, %count_b : offset, offset, i64
      } else {
        %block_end = func.call @chat_find_marker(%response, %header_begin, %end_message) : (buffer, offset, buffer) -> (offset)
        %block_complete = index.cmp ult, %block_end, %length : offset
        %block_resume = index.add %block_end, %end_length : offset
        %skip_to = scf.select %block_complete, %block_resume, %length : offset
        scf.yield %skip_to, %at, %count : offset, offset, i64
      }
      scf.yield %cursor_a, %at_a, %count_a : offset, offset, i64
    } else {
      scf.yield %length, %at, %count : offset, offset, i64
    }
    scf.yield %next_cursor, %next_at, %next_count : offset, offset, i64
  }
  %end = func.call @chat_put(%output, %position, %close_list) : (buffer, offset, buffer) -> (offset)
  %end64 = index.cast %end : offset to i64
  %exact = func.call @chat_range(%output, %c0_i64, %end64) : (buffer, i64, i64) -> (buffer)
  func.return %exact : buffer
}

// Output channels. State 0 waits for a message, 1 is inside a reasoning message and 2 inside a text message. Text before any message marker is plain content.
// A message whose header is followed by anything but the thinking or text marker is a tool call. It is never consumed, so the caller passes it to parse_tools.
func.def public @text_output_next_v1(%response: buffer, %previous: i64, %state: i64, %phase: i32) -> (i64, i64, i64, i64) {
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c2_i64 = scalar.constant 2 : i64
  %c0_i32 = scalar.constant 0 : i32
  %model = buffer.constant utf8("<|message_model|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %prefix = buffer.constant utf8("<|content_") : buffer
  %thinking = buffer.constant utf8("<|content_thinking|>") : buffer
  %text = buffer.constant utf8("<|content_text|>") : buffer
  %true = scalar.constant true : i1
  %streaming = scalar.cmpi eq, %phase, %c0_i32 : i32
  %at_value = scalar.assume %previous [range(%previous, 0, 9223372036854775807)] : i64
  %at = index.cast %at_value : i64 to offset
  %model_length = buffer.length %model
  %end_length = buffer.length %end_message
  %idle = scalar.cmpi eq, %state, %c0_i64 : i64
  %in_thinking = scalar.cmpi eq, %state, %c1_i64 : i64
  %in_text = scalar.cmpi eq, %state, %c2_i64 : i64
  %in_message = scalar.ori %in_thinking, %in_text : i1
  %at_model = func.call @chat_marker_at(%response, %at, %model) : (buffer, offset, buffer) -> (i1)
  %at_end = func.call @chat_marker_at(%response, %at, %end_message) : (buffer, offset, buffer) -> (i1)
  %header_begin = index.add %at, %model_length : offset
  %type_begin = func.call @chat_find_marker(%response, %header_begin, %prefix) : (buffer, offset, buffer) -> (offset)
  %is_thinking = func.call @chat_marker_at(%response, %type_begin, %thinking) : (buffer, offset, buffer) -> (i1)
  %is_text = func.call @chat_marker_at(%response, %type_begin, %text) : (buffer, offset, buffer) -> (i1)
  %thinking_length = buffer.length %thinking
  %text_length = buffer.length %text
  %thinking_end = index.add %type_begin, %thinking_length : offset
  %text_end = index.add %type_begin, %text_length : offset
  %thinking_end64 = index.cast %thinking_end : offset to i64
  %text_end64 = index.cast %text_end : offset to i64
  %after_end = index.add %at, %end_length : offset
  %after_end64 = index.cast %after_end : offset to i64
  %stop = func.call @chat_until(%response, %end_message, %at, %streaming) : (buffer, buffer, offset, i1) -> (offset)
  %stop64 = index.cast %stop : offset to i64
  %progress = index.cmp ugt, %stop, %at : offset
  %a_header = scalar.andi %idle, %at_model : i1
  %a_thinking = scalar.andi %a_header, %is_thinking : i1
  %a_text = scalar.andi %a_header, %is_text : i1
  %not_model = scalar.xori %at_model, %true : i1
  %idle_plain = scalar.andi %idle, %not_model : i1
  %a_stray_end = scalar.andi %idle_plain, %at_end : i1
  %not_end = scalar.xori %at_end, %true : i1
  %idle_text = scalar.andi %idle_plain, %not_end : i1
  %a_plain = scalar.andi %idle_text, %progress : i1
  %a_close = scalar.andi %in_message, %at_end : i1
  %message_text = scalar.andi %in_message, %not_end : i1
  %a_content = scalar.andi %message_text, %progress : i1
  %channel = scf.select %in_thinking, %c2_i64, %c1_i64 : i64
  %kind_0 = scf.select %a_content, %channel, %c1_i64 : i64
  %end_0 = scf.select %a_content, %stop64, %previous : i64
  %state_0 = scf.select %a_content, %state, %state : i64
  %kind_1 = scf.select %a_plain, %c1_i64, %kind_0 : i64
  %end_1 = scf.select %a_plain, %stop64, %end_0 : i64
  %state_1 = scf.select %a_plain, %c2_i64, %state_0 : i64
  %kind_2 = scf.select %a_close, %c0_i64, %kind_1 : i64
  %end_2 = scf.select %a_close, %after_end64, %end_1 : i64
  %state_2 = scf.select %a_close, %c0_i64, %state_1 : i64
  %kind_3 = scf.select %a_stray_end, %c0_i64, %kind_2 : i64
  %end_3 = scf.select %a_stray_end, %after_end64, %end_2 : i64
  %state_3 = scf.select %a_stray_end, %c0_i64, %state_2 : i64
  %kind_4 = scf.select %a_text, %c0_i64, %kind_3 : i64
  %end_4 = scf.select %a_text, %text_end64, %end_3 : i64
  %state_4 = scf.select %a_text, %c2_i64, %state_3 : i64
  %kind_5 = scf.select %a_thinking, %c0_i64, %kind_4 : i64
  %end_5 = scf.select %a_thinking, %thinking_end64, %end_4 : i64
  %state_5 = scf.select %a_thinking, %c1_i64, %state_4 : i64
  %visible = scalar.ori %a_content, %a_plain : i1
  %begin = scf.select %visible, %previous, %end_5 : i64
  func.return %kind_5, %begin, %end_5, %state_5 : i64, i64, i64, i64
}

// Canonical history: what the template renders for this assistant turn. State is reusable only if the generated bytes are exactly that text.
func.def public @text_complete_text_v1(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %origin = index.constant 0 : offset
  %c0_i64 = scalar.constant 0 : i64
  %c0_i32 = scalar.constant 0 : i32
  %true = scalar.constant true : i1
  %empty = buffer.constant utf8("") : buffer
  %model = buffer.constant utf8("<|message_model|>") : buffer
  %thinking = buffer.constant utf8("<|content_thinking|>") : buffer
  %text = buffer.constant utf8("<|content_text|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %terminal = buffer.constant utf8("<|content_model_end_sampling|>") : buffer
  %has_reasoning = func.call @chat_nonempty(%reasoning) : (buffer) -> (i1)
  %has_content = func.call @chat_nonempty(%content) : (buffer) -> (i1)
  %has_tools = func.call @chat_nonempty(%tools) : (buffer) -> (i1)
  %quiet = scalar.ori %has_reasoning, %has_tools : i1
  %not_quiet = scalar.xori %quiet, %true : i1
  %wants_text = scalar.ori %has_content, %not_quiet : i1
  %thought = scf.if %has_reasoning -> (buffer) {
    %value = func.call @chat_join(%model, %thinking, %reasoning, %end_message, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %empty : buffer
  }
  %answer = scf.if %wants_text -> (buffer) {
    %value = func.call @chat_join(%model, %text, %content, %end_message, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %empty : buffer
  }
  %canonical = func.call @chat_join(%prompt, %thought, %answer, %tools, %terminal, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %prompt_length = buffer.length %prompt
  %canonical_length = buffer.length %canonical
  %terminal_length = buffer.length %terminal
  %response_length = buffer.length %response
  %generated_end = index.sub %canonical_length, %terminal_length : offset
  %generated_length = index.sub %generated_end, %prompt_length : offset
  %same_length = index.cmp eq, %generated_length, %response_length : offset
  %identical = scf.if %same_length -> (i1) {
    %order = buffer.compare %canonical[%prompt_length], %response[%origin], %response_length
    %equal = scalar.cmpi eq, %order, %c0_i32 : i32
    scf.yield %equal : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  %closed = scalar.cmpi eq, %final_state, %c0_i64 : i64
  %reusable = scalar.andi %closed, %identical : i1
  %flag = scalar.extui %reusable : i1 to i32
  func.return %canonical, %flag : buffer, i32
}

// The session suffix. An open boundary means the previous turn did not end with its terminal token, so the suffix first writes it. User text becomes one user message.
func.def public @text_prepare_input_v1(%text: buffer, %markers: buffer, %marker_count: i64, %format: i32, %boundary: i32, %capacity: i64) -> (buffer, i64, buffer) {
  %c0 = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %measure = scalar.constant -1 : i64
  %limit = scalar.constant 2305843009213693950 : i64
  %empty = buffer.constant utf8("") : buffer
  %mode_error = buffer.constant utf8("unsupported input format, turn boundary or media markers") : buffer
  %capacity_error = buffer.constant utf8("input token capacity is out of range") : buffer
  %valid_format = scalar.cmpi ule, %format, %c1_i32 : i32
  %valid_boundary = scalar.cmpi ule, %boundary, %c2_i32 : i32
  %no_markers = scalar.cmpi eq, %marker_count, %c0_i64 : i64
  %valid_a = scalar.andi %valid_format, %valid_boundary : i1
  %valid_modes = scalar.andi %valid_a, %no_markers : i1
  func.call @chat_check(%valid_modes, %mode_error) : (i1, buffer)
  %measuring = scalar.cmpi eq, %capacity, %measure : i64
  %within = scalar.cmpi ule, %capacity, %limit : i64
  %valid_capacity = scalar.ori %within, %measuring : i1
  func.call @chat_check(%valid_capacity, %capacity_error) : (i1, buffer)
  %user = scalar.cmpi eq, %format, %c1_i32 : i32
  %open = scalar.cmpi eq, %boundary, %c1_i32 : i32
  %terminal = buffer.constant utf8("<|content_model_end_sampling|>") : buffer
  %user_prefix = buffer.constant utf8("<|message_user|><|content_text|>") : buffer
  %end_message = buffer.constant utf8("<|end_message|>") : buffer
  %leading = scf.select %open, %terminal, %empty : buffer
  %prefix = scf.select %user, %user_prefix, %empty : buffer
  %suffix = scf.select %user, %end_message, %empty : buffer
  %rendered = func.call @chat_join(%leading, %prefix, %text, %suffix, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %bounded_probe = scalar.addi %capacity, %c1_i64 : i64
  %probe = scf.select %measuring, %measure, %bounded_probe : i64
  %tokens, %count = func.call @encode(%rendered, %c0_i32, %probe) : (buffer, i32, i64) -> (buffer, i64)
  %fits = scalar.cmpi ule, %count, %capacity : i64
  %output = scf.select %fits, %tokens, %empty : buffer
  %spans = buffer.alloca<private> align(4) %c0 : buffer
  func.return %output, %count, %spans : buffer, i64, buffer
}
