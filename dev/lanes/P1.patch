+#!/usr/bin/env bash
+# usage: p1_mkvar.sh <r9700|strix> <name> <package dir> [prefill_capacity]   (GPU box) Builds ~/inkling/optP1/var-<gpu>-<name>: hard-link copy of the inkV materialized preset, program files replaced by the ones of <package dir>.
+set -eu
+G=${1:?gpu}; N=${2:?name}; PK=$(readlink -f "${3:?package dir}"); PC=${4:-512}
+B=$HOME/inkling/inkV/mat-$G; D=$HOME/inkling/optP1/var-$G-$N
+P=$(case $G in r9700) echo chat-r9700 ;; strix) echo chat ;; esac)
+rm -rf "$D"; cp -al "$B" "$D"
+(cd "$D/program" && find . -type f | while read -r f; do if [ -f "$PK/$f" ]; then if ! cmp -s "$f" "$PK/$f"; then rm "$f"; cp "$PK/$f" "$f"; fi; else echo "missing in package: $f" >&2; fi; done)
+python3 - "$D/model.json" "$P" "$PC" <<'PY'
+import json, sys
+p, pre, pc = sys.argv[1], sys.argv[2], int(sys.argv[3])
+d = json.load(open(p))
+d["presets"][pre]["execution"]["prefill_capacity"] = pc
+json.dump(d, open(p + ".new", "w"), indent=1)
+PY
+mv "$D/model.json.new" "$D/model.json"
+echo "$D prefill_capacity=$PC"
