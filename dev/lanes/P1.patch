+G=${1:?gpu}; A=${2:?}; B=${3:?}; MET=${4:?}; REPS=${5:-3}; R=${6:-1}
+H=$(cd "$(dirname "$0")" && pwd)
+export INKV=$HOME/inkling/optP1; mkdir -p $INKV
+for r in $(seq $R); do
+for s in A B B A; do
+  d=$A; [ $s = B ] && d=$B
+  while :; do
+    flock -x ~/hrx-pr1/gpu.lock bash "$H/ab_run.sh" $G "$d" "$(basename $d).$s.$(date +%s)" "$MET" "$REPS"; rc=$?
+    [ $rc = 3 ] || break
+    sleep 20
+  done
+done
+done
