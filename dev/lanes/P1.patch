+#!/usr/bin/env bash
+# usage: p1_greedy_run.sh <r9700|strix> <model dir> <out json>   (run under the GPU lock) serves the model dir, runs p1_greedy.py, stops the server by PID.
+G=${1:?gpu}; M=${2:?dir}; OUT=${3:?out}
+case $G in
+  r9700) PRESET=chat-r9700; PORT=18194; DEV='amdgpu://GPU-e0880c05003c324d?completion_spin_ns=4294967295' ;;
+  strix) PRESET=chat; PORT=18195; DEV='amdgpu://id/000000e2000000808e270f2b0bbb4e00?completion_spin_ns=4294967295' ;;
+esac
+HERE=$(cd "$(dirname "$0")" && pwd); T=$HOME/loom/.tools/bin/python
+export LOOM_ROOT=$HOME/loom PYTHONDONTWRITEBYTECODE=1
+. $HOME/loom/.venv/bin/activate
+( exec nohup loom-serve --device="$DEV" --model="$M" --preset="$PRESET" --pool_backing=fixed --listen=127.0.0.1:$PORT --workers=8 > "$OUT.serve.log" 2>&1 < /dev/null ) &
+PID=$!
+for _ in $(seq 1800); do kill -0 $PID 2>/dev/null || { echo "loom-serve died"; tail -5 "$OUT.serve.log"; exit 1; }; curl -s -m 2 localhost:$PORT/v1/status 2>/dev/null | grep -q '"registration": *"ready"' && break; sleep 0.5; done
+$T -I "$HERE/p1_greedy.py" $PORT thinkingmachines/Inkling-2-Mini "$OUT"
+curl -s -m 10 localhost:$PORT/v1/status > "$OUT.status.json"
+kill -TERM $PID; for _ in $(seq 120); do kill -0 $PID 2>/dev/null || break; sleep 1; done
