+++ scripts/p1_greedy.py	2026-11-21 23:24:57.492078700 -0800
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""usage: p1_greedy.py <port> <model id> <out.json>   Greedy 64-token replies for oracle prompts A, B, C and two long prompts (about 3k and 9k tokens, several chunks). Compare two files with route_check.py --diff."""
+import http.client, json, os, sys
+sys.path.insert(0, os.environ.get("SKILLS_BENCH", os.path.expanduser("~/inkling/loom-skills/skills/loom-benchmark/scripts")))
+from bench_common import doc
+
+port, model, out = int(sys.argv[1]), sys.argv[2], sys.argv[3]
+here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "oracle", "prompts")
+if not os.path.isdir(here):
+    here = os.path.expanduser("~/inkling/optP1/oracle_prompts")
+
+
+def ask(text, n=64):
+    c = http.client.HTTPConnection("127.0.0.1", port, timeout=1800)
+    body = {"model": model, "max_tokens": n, "temperature": 0, "messages": [{"role": "user", "content": text}]}
+    c.request("POST", "/v1/chat/completions", json.dumps(body), {"Content-Type": "application/json"})
+    d = json.loads(c.getresponse().read())
+    m = d["choices"][0]["message"]
+    return {"usage": d["usage"], "finish": d["choices"][0]["finish_reason"], "reasoning": m.get("reasoning_content") or "", "content": m.get("content") or ""}
+
+
+res = {n: ask(open(os.path.join(here, f), encoding="utf-8").read().strip()) for n, f in (("A", "A.txt"), ("B", "B.txt"), ("C", "C_user.txt"))}
+res["L3k"] = ask("Summarize this documentation in one sentence.\n\n" + doc(2000)[:12000])
+res["L9k"] = ask("Summarize this documentation in one sentence.\n\n" + doc(8000))
+json.dump(res, open(out, "w"), indent=1)
+for k, v in res.items():
+    print(k, v["usage"], v["finish"], repr((v["reasoning"] + v["content"])[:60]))
