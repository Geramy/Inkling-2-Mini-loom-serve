+++ package_QV/kernel/dense/gemm_kquant.loom	2026-11-22 12:52:37.686484600 -0800
@@ -0,0 +1,186 @@
+// GEMM for Q4_K, Q5_K and Q6_K weights with matrix ops. Weights and activations are rounded to F16, the sums are in F32.
