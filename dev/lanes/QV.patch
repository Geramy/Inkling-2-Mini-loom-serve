+#!/usr/bin/env bash
+# usage: qv_mkvar.sh <r9700|strix> <name> <package dir> <gguf path> <dense_type> <kq_attn> <kq_head> [prefill_capacity]   (GPU box)
+# Builds ~/inkling/optQV/var-<gpu>-<name>: copy of the private materialized preset (~/inkling/optQV/mat-<gpu>, copied from inkV without the weights), program files taken from <package dir>
+# (new files are added to the library list), weights symlinked from <gguf path>, variant config set.
+set -eu
+G=${1:?gpu}; N=${2:?name}; PK=$(readlink -f "${3:?package dir}"); GG=$(readlink -f "${4:?gguf}"); DT=${5:?}; KA=${6:?}; KH=${7:?}; PC=${8:-2048}
+B=$HOME/inkling/optQV/mat-$G; D=$HOME/inkling/optQV/var-$G-$N
+P=$(case $G in r9700) echo chat-r9700 ;; strix) echo chat ;; esac)
+rm -rf "$D"; cp -r "$B" "$D"
+(cd "$D/program" && find . -type f | while read -r f; do if [ -f "$PK/$f" ]; then if ! cmp -s "$f" "$PK/$f"; then rm "$f"; cp "$PK/$f" "$f"; fi; else echo "missing in package: $f" >&2; fi; done)
+rm -f "$D"/parameter/*; ln -s "$GG" "$D/parameter/$(basename "$GG")"
+python3 - "$D" "$PK" "$P" "$PC" "$DT" "$KA" "$KH" "$(basename "$GG")" <<"PY"
+import json, os, shutil, sys
+d, pk, pre, pc, dt, ka, kh, gg = sys.argv[1:]
+src = d + "/model.json"
+m = json.load(open(src))
+have = {x["path"] for x in m["programs"]["source"]["libraries"]} | {x["path"] for x in m["programs"]["source"]["inputs"]}
+card = json.load(open(pk + "/card.json"))["programs"]["source"]
+for rel in card["inputs"] + card["libraries"]:
+    p = "program/" + rel
+    dst = os.path.join(d, p)
+    if not os.path.exists(dst):
+        os.makedirs(os.path.dirname(dst), exist_ok=True)
+        shutil.copyfile(os.path.join(pk, rel), dst)
+    if p not in have:
+        m["programs"]["source"]["libraries"].append({"path": p, "origin": "@document/" + p})
+m["programs"]["source"]["libraries"] = [x for x in m["programs"]["source"]["libraries"] if os.path.exists(os.path.join(d, x["path"]))]
+v = m["variants"]["ud-q4-k-xl"]["services"]["chat"]
+v["config"] = {"inkling.dense_type": int(dt)}
+if int(ka) or int(kh):
+    v["config"].update({"inkling.kq_attn": int(ka), "inkling.kq_head": int(kh)})
+v["parameters"]["model"]["files"][0]["path"] = "parameter/" + gg
+v["parameters"]["model"]["files"][0].pop("origin", None)
+m["presets"][pre]["execution"]["prefill_capacity"] = int(pc)
+os.unlink(src)
+json.dump(m, open(src, "w"), indent=1)
+PY
+rm -f "$D/model.json.lock"
+echo "$D dense=$DT kq_attn=$KA kq_head=$KH prefill_capacity=$PC"
