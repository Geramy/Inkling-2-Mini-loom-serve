+template.def<@inkling.dense.weight.wmma16> device @inkling_dense_q5_k_wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>) where [eq(%wtype, 5)] {
+  %c1 = index.constant 1 : index
