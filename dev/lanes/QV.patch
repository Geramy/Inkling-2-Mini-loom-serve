+func.def public inline @inkling_dense_kq_decode16(%is_q5k: i1, %header: vector<4xi32>, %codes: vector<2xi32>, %high_bits: vector<2xi32>, %k: index) -> (vector<8xf16>, vector<8xf16>) {
