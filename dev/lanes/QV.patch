+#!/usr/bin/env python3
+# usage: qv_ppl.py <port> <base.kld> <chunks> [--model inkling-2-mini]   (run on the box; server from the capture route with capture id 31, width 200064)
+# Perplexity of the Loom path on the chunks that llama-perplexity used for its KL-divergence base file (the tokens are stored in that file): per chunk of n_ctx tokens, the rows
+# n_ctx/2 .. n_ctx-2 predict the next token, as in llama-perplexity. The logits of the capture route are already soft-capped.
+import argparse, base64, json, struct, sys, urllib.request
+import numpy as np
+
+ap = argparse.ArgumentParser()
+ap.add_argument("port"); ap.add_argument("kld"); ap.add_argument("chunks", type=int); ap.add_argument("--model", default="inkling-2-mini")
+a = ap.parse_args()
+with open(a.kld, "rb") as f:
+    assert f.read(8) == b"_logits_"
+    n_ctx, n_vocab, n_chunk = struct.unpack("<Iii", f.read(12))
+    tokens = np.frombuffer(f.read(4 * n_ctx * n_chunk), dtype=np.int32).reshape(n_chunk, n_ctx)
+width, valid = 200064, 200058
+
+
+def rows_of(ids):
+    body = {"model": a.model, "position": 0, "token_ids": [int(t) for t in ids], "options": {}}
+    req = urllib.request.Request(f"http://127.0.0.1:{a.port}/v1/sequences", json.dumps(body).encode(), {"Content-Type": "application/json"})
+    out, event = [], None
+    with urllib.request.urlopen(req) as resp:
+        for raw in resp:
+            line = raw.decode().rstrip("\n")
+            if line.startswith("event:"):
+                event = line[6:].strip()
+            elif line.startswith("data:") and event == "chunk":
+                out.append(np.frombuffer(base64.b64decode(json.loads(line[5:])["data"]), dtype=np.float32).reshape(-1, width)[:, :valid].astype(np.float64))
+    return np.concatenate(out, axis=0)
+
+
+tot, cnt, hist = 0.0, 0, []
+for c in range(min(a.chunks, n_chunk)):
+    r = rows_of(tokens[c])
+    first = n_ctx // 2
+    x = r[first:n_ctx - 1]
+    m = x.max(axis=1, keepdims=True)
+    lse = (m[:, 0] + np.log(np.exp(x - m).sum(axis=1)))
+    nll = lse - x[np.arange(x.shape[0]), tokens[c][first + 1:n_ctx]]
+    tot += nll.sum(); cnt += nll.size
+    hist.append(float(np.exp(tot / cnt)))
+    print(f"chunk {c + 1} running PPL {hist[-1]:.4f}", flush=True)
+print(json.dumps({"chunks": len(hist), "ppl": hist[-1], "running": hist}))
