+func.def public inline @inkling_dense_kq_affine_dot16(%codes: vector<4xi32>, %x: vector<16xf32>, %scale: f32, %bias: f32) -> (f32) {
+  %zero = scalar.constant 0.0 : f32
+  %q_i8 = vector.bitcast %codes : vector<4xi32> to vector<16xi8>
+  %q = vector.uitofp %q_i8 : vector<16xi8> to vector<16xf32>
+  %products = vector.mulf %q, %x : vector<16xf32>
+  %dot = vector.reduce<addf> %products, %zero : vector<16xf32>, f32
+  %sum = vector.reduce<addf> %x, %zero : vector<16xf32>, f32
+  %scaled_sum = scalar.mulf %bias, %sum : f32
+  %result = scalar.fmaf %scale, %dot, %scaled_sum : f32
+  func.return %result : f32
+}
