+func.def public inline @inkling_dense_kq_dot(%is_q5k: i1, %header: vector<4xi32>, %codes: vector<4xi32>, %qh: vector<4xi32>, %p: index, %x_lo: vector<16xf32>, %x_hi: vector<16xf32>) -> (f32) {
