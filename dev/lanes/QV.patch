+#!/usr/bin/env bash
+# Copies package_QV/ and scripts_QV/ (plus the unchanged shared scripts it calls) to the box work tree ~/inkling/optQV (package/ and scripts/)
+# and points the dense tests at it. package_T10b/ goes to ~/inkling/optQV/package_T10b (base arm of the A/B runs).
+set -euo pipefail
+cd "$(dirname "$0")/.."
+BOX=${BOX:-user@gpu-box}
+tar cf - package_QV scripts_QV package_T10b scripts/ab_run.sh scripts/ab_session.py scripts/gen_kernel_decls.py | ssh "$BOX" 'cd ~/inkling/optQV && tar xmf - && rm -rf package && cp -r package_QV package && cp -r scripts_QV/. scripts/ && sed -i "s#inkling/inkF/package#inkling/optQV/package#; s#/tmp/inkF_t#/tmp/qv_t#" package/test/dense/dtest.py package/test/dense/test_*.py'
--- /dev/null	2026-11-22 15:50:52.000000000 -0800
+++ scripts_QV/qv_patch.sh	2026-11-22 14:56:53.359111700 -0800
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Writes lanes/QV.patch: package_QV against package_T10b, gen_hooks.py against scripts_T10b, and the new lane scripts as new files.
+cd "$(dirname "$0")/.."
+{
+  diff -ruN -x __pycache__ package_T10b package_QV
+  diff -uN scripts_T10b/gen_hooks.py scripts_QV/gen_hooks.py
+  for f in qv_quantize.sh qv_mkvar.sh qv_ab.sh qv_greedy.sh qv_greedy_run.sh qv_greedy.py qv_compare.sh qv_reg.sh qv_ppl.py qv_ppl_run.sh qv_arm.sh sync_qv.sh qv_patch.sh; do diff -uN /dev/null scripts_QV/$f; done
+} > lanes/QV.patch
+wc -l lanes/QV.patch
