+#!/bin/bash
+# usage: qv_quantize.sh <name> <attn type> <lm_head type> [--dry-run]   e.g. qv_quantize.sh V1 q6_k q6_k
+# Makes ~/models/inkling2-mini/custom/Inkling-2-Mini-<name>.gguf from UD-Q8_K_XL (BF16 attention and lm_head are the source) with the oracle build (mainline 418fe97 + PR 32704),
+# built with: cmake -S ~/inkling/inkB/src -B ~/inkling/optQV/build -DGGML_NATIVE=ON -DCMAKE_BUILD_TYPE=Release -DGGML_HIP=OFF -DGGML_VULKAN=OFF -DGGML_HRX=OFF; cmake --build ... --target llama-quantize
+# Unchanged: NVFP4 experts of layers 0-19 (and their .scale tensors), the Q8_0 experts of layers 20-23 (their down tensors have K = 1152, not a multiple of 256),
+# token_embd Q8_0 (as in UD-Q4_K_XL), sink and conv projections BF16, router F32, loop tensors and norms as in the source (the loop controllers stay BF16).
+set -e
+Q=${QUANTIZE:-$HOME/inkling/optQV/build/bin/llama-quantize}
+SRC=${SRC:-$HOME/models/inkling2-mini/Mainline_Support/Inkling-2-Mini-UD-Q8_K_XL.gguf}
+OUT=$HOME/models/inkling2-mini/custom/Inkling-2-Mini-$1.gguf
+mkdir -p "$(dirname "$OUT")"
+nice -n 19 "$Q" $4 --allow-requantize --pure \
+ --tensor-type 'attn_(q|k|v|gate|output|rel)\.weight='$2 \
+ --tensor-type 'attn_sink_proj\.weight=bf16' \
+ --tensor-type '_conv_proj\.weight=bf16' \
+ --tensor-type 'ffn_gate_inp\.weight=f32' \
+ --tensor-type 'blk\.(1?[0-9])\.ffn_(gate_up|down)_exps\.weight=nvfp4' \
+ --tensor-type 'blk\.2[0-3]\.ffn_(gate_up|down)_exps\.weight=q8_0' \
+ --output-tensor-type $3 --token-embedding-type q8_0 \
+ "$SRC" "$OUT" q8_0 8
