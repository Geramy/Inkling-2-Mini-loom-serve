+#!/usr/bin/env bash
+# usage: qv_ppl_run.sh <r9700|strix> <custom-v1|custom-v2x|custom-v3x|ud-q4-k-xl> <chunks> <out json>   (GPU box) capture route (card preset capture-<variant> of ~/inkling/optQV/cardcap/package/card.json, capture id 31) under a shared GPU lock.
+G=${1:?gpu}; VAR=${2:?variant}; N=${3:?chunks}; OUT=${4:?out}
+exec flock -s ~/hrx-pr1/gpu.lock bash -c '
+G=$1; VAR=$2; N=$3; OUT=$4
+ROOT=$HOME/inkling/optQV
+case $G in gfx1201|r9700) A=gfx1201; PORT=18198;; *) A=gfx1151; PORT=18199;; esac
+RUN=$ROOT/run-ppl-$G; mkdir -p $RUN; ln -sfn $ROOT/cardcap/package $RUN/pkg
+cat > $RUN/model.json <<JSON
+{"name": "inkling-2-mini", "device": "gpu", "pool": "main", "model": {"path": "pkg/card.json", "preset": "capture-$VAR"}, "definition": {"kind": "sequence"}}
+JSON
+export PATH=$HOME/inkling/tools/QV-venv/bin:$PATH
+( exec nohup loom-serve --devices="$ROOT/cardcap/package/devices/$A.json" --model="$RUN/model.json" --listen=127.0.0.1:$PORT --workers=4 > "$OUT.serve.log" 2>&1 < /dev/null ) &
+PID=$!
+for _ in $(seq 1800); do kill -0 $PID 2>/dev/null || { echo "serve died"; tail -5 "$OUT.serve.log"; exit 1; }; curl -s -m 2 localhost:$PORT/v1/status 2>/dev/null | grep -q "\"registration\": *\"ready\"" && break; sleep 0.5; done
+python3 -I $ROOT/scripts/qv_ppl.py $PORT $ROOT/kld/base.kld $N > "$OUT"
+tail -2 "$OUT" | cut -c1-300
+kill -TERM $PID; for _ in $(seq 120); do kill -0 $PID 2>/dev/null || break; sleep 1; done
+' _ "$G" "$VAR" "$N" "$OUT"
--- /dev/null	2026-11-22 15:50:51.000000000 -0800
+++ scripts_QV/qv_arm.sh	2026-11-22 14:56:52.946776000 -0800
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# usage: qv_arm.sh <gpu> <dir> <metrics> <reps> <sessions>   (GPU box) single-arm sessions of one model dir (exclusive lock each, retry while another server runs); appends to ~/inkling/optQV/ab_log.jsonl
+G=${1:?gpu}; D=${2:?}; MET=${3:?}; REPS=${4:-3}; N=${5:-2}
+H=$(cd "$(dirname "$0")" && pwd)
+export INKV=$HOME/inkling/optQV
+for s in $(seq $N); do
+  while :; do
+    flock -x ~/hrx-pr1/gpu.lock bash "$H/ab_run.sh" $G "$D" "$(basename $D).A.$(date +%s)" "$MET" "$REPS"; rc=$?
+    [ $rc = 3 ] || break
+    sleep 20
+  done
+done
