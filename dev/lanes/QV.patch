+  %scale_hi, %bias_hi = template.apply<@inkling.dense.kq.affine>(%header, %group_hi) : (vector<4xi32>, index) -> (f32, f32)
+  %dot_lo = func.call @inkling_dense_kq_affine_dot16(%q_lo, %x_lo, %scale_lo, %bias_lo) : (vector<4xi32>, vector<16xf32>, f32, f32) -> (f32)
