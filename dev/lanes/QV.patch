+        %q4_raw = index.add %q_local, %c4 : index
+        %q4_off = index.assume %q4_raw [range(%q4_raw, 4, 32)] : index
+        %header4 = vector.load %w4[%wb, %c0] : view<[%n_wb]x36xi32> -> vector<4xi32>
