+#!/usr/bin/env python3
+"""Prints the table of a probe results file: a64_sum.py <results.jsonl>"""
+import json, sys
+
+for line in open(sys.argv[1]):
+    r = json.loads(line)
+    t = r["timing"]
+    keys = [k for k in t if k not in ("p50",)]
+    print(f"{r['name']:28s} p50={t['p50'] / 1e3:9.1f}us useful={r['useful'] / t['p50']:7.2f} GB/s span={r['span'] / t['p50']:7.2f} GB/s", {k: (round(v / 1e3, 1) if isinstance(v, (int, float)) else v) for k, v in t.items() if k != "p50"})
