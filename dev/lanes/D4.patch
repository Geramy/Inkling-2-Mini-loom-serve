diff -ruN pa2/scripts/ab_greedy.sh pb2/scripts/ab_greedy.sh
--- pa2/scripts/ab_greedy.sh	1969-12-31 16:00:00.000000000 -0800
+++ pb2/scripts/ab_greedy.sh	2026-11-21 21:08:55.099743800 -0800
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# usage: ab_greedy.sh <r9700|strix> <model dir> <out json>   (box; run under flock -s) serves a variant and writes greedy_check.py output
+set -u
+G=${1:?gpu}; M=${2:?dir}; OUT=${3:?out}
+V=$HOME/inkling/optD4; HERE=$(cd "$(dirname "$0")" && pwd)
+case $G in
+  r9700) PRESET=chat-r9700; PORT=18192; DEV='amdgpu://GPU-e0880c05003c324d?completion_spin_ns=4294967295' ;;
+  strix) PRESET=chat; PORT=18193; DEV='amdgpu://id/000000e2000000808e270f2b0bbb4e00?completion_spin_ns=4294967295' ;;
+esac
+URL=http://127.0.0.1:$PORT; T=$HOME/loom/.tools/bin/python
+export LOOM_ROOT=$HOME/loom PYTHONDONTWRITEBYTECODE=1
+. "$HOME/loom/.venv/bin/activate"
+( exec nohup loom-serve --device="$DEV" --model="$M" --preset="$PRESET" --pool_backing=fixed --listen=127.0.0.1:$PORT --workers=8 > "$V/ablogs/greedy.$$.log" 2>&1 < /dev/null ) &
+PID=$!
+stopit() { if tr '\0' ' ' < /proc/$PID/cmdline 2>/dev/null | grep -q loom-serve; then kill -TERM $PID; for _ in $(seq 120); do kill -0 $PID 2>/dev/null || break; sleep 1; done; fi; }
+trap stopit EXIT
+for _ in $(seq 1800); do
+  kill -0 $PID 2>/dev/null || { echo "loom-serve died"; exit 1; }
+  curl -s -m 2 $URL/v1/status 2>/dev/null | grep -q '"registration": *"ready"' && break
+  curl -s -m 2 $URL/v1/status 2>/dev/null | grep -q '"registration": *"failed"' && { echo "registration failed"; exit 1; }
+  sleep 0.5
+done
+$T -I "$HERE/greedy_check.py" $URL thinkingmachines/Inkling-2-Mini "$OUT"
