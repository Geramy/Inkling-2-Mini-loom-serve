diff -ruN pa2/scripts/greedy_check.py pb2/scripts/greedy_check.py
--- pa2/scripts/greedy_check.py	1969-12-31 16:00:00.000000000 -0800
+++ pb2/scripts/greedy_check.py	2026-11-21 21:08:55.095745000 -0800
@@ -0,0 +1,19 @@
+"""usage: greedy_check.py URL MODEL OUT.json   Greedy 64 token outputs for the oracle prompts A, B, C and for 8k and 32k character documents."""
+import json
+import os
+import sys
+
+sys.path.insert(0, os.environ.get("SKILLS_BENCH", os.path.expanduser("~/inkling/loom-skills/skills/loom-benchmark/scripts")))
+from bench_common import doc, stream, thinking_extra
+
+url, model, out = sys.argv[1:4]
+P = os.path.expanduser("~/inkling/optD4/prompts")
+ESSAY = "Write a long, detailed essay discussing this documentation.\n\n"
+cases = {"A": open(f"{P}/A.txt").read(), "B": open(f"{P}/B.txt").read(), "C": open(f"{P}/C_user.txt").read(),
+         "L8k": ESSAY + doc(8000), "L32k": ESSAY + doc(32000)}
+res = {}
+for k, text in cases.items():
+    s = stream(url, model, [{"role": "user", "content": text}], 64, extra=thinking_extra("off"), timeout=900)
+    res[k] = dict(text=s["text"], tokens=s["tokens"], prompt_tokens=s["prompt_tokens"])
+    print(k, s["prompt_tokens"], s["tokens"], flush=True)
+json.dump(res, open(out, "w"), indent=1)
diff -ruN pa2/scripts/greedy_lp.py pb2/scripts/greedy_lp.py
--- pa2/scripts/greedy_lp.py	1969-12-31 16:00:00.000000000 -0800
+++ pb2/scripts/greedy_lp.py	2026-11-21 21:08:55.106411300 -0800
@@ -0,0 +1,19 @@
+"""usage: greedy_lp.py URL MODEL OUT.json   32k character document, greedy 40 tokens with top-2 logprobs per token."""
+import json
+import os
+import sys
+import requests
+
+sys.path.insert(0, os.environ.get("SKILLS_BENCH", os.path.expanduser("~/inkling/loom-skills/skills/loom-benchmark/scripts")))
+from bench_common import doc, thinking_extra
+
+url, model, out = sys.argv[1:4]
+body = {"model": model, "messages": [{"role": "user", "content": "Write a long, detailed essay discussing this documentation.\n\n" + doc(32000)}],
+        "max_tokens": 40, "temperature": 0, "logprobs": True, "top_logprobs": 2}
+body.update(thinking_extra("off") or {})
+r = requests.post(url + "/v1/chat/completions", json=body, timeout=900)
+j = r.json()
+lp = j["choices"][0].get("logprobs") or {}
+rows = [(c["token"], c["logprob"], [(t["token"], t["logprob"]) for t in c.get("top_logprobs", [])]) for c in lp.get("content", [])]
+json.dump(dict(text=j["choices"][0]["message"].get("content"), rows=rows, status=r.status_code), open(out, "w"), indent=1)
+print(r.status_code, len(rows))
