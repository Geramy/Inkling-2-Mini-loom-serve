+                break
+            if "failed" in json.dumps(st):
+                print("registration failed", json.dumps(st)[:600]); sys.exit(2)
+        except Exception:
+            pass
+        if time.time() - t0 > 900:
+            print("registration timeout"); sys.exit(2)
+        time.sleep(1)
