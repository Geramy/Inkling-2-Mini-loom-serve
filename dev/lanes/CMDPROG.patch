+#!/usr/bin/env bash
+# usage: m30_greedy.sh <r9700|strix> <model dir> <out.json> [venv dir]   (box; run under flock -s) One serve session, oracle prompts A, B, C (and long documents when GREEDY_LONG=1) greedy 64 tokens, stop by PID.
+set -u
+G=${1:?gpu}; M=${2:?dir}; OUT=${3:?out}; VD=${4:-$HOME/inkling/tools/M30-venv}
+V=$HOME/inkling/optCMD; HERE=$(cd "$(dirname "$0")" && pwd)
+case $G in
+  r9700) PRESET=chat-r9700; PORT=18190; DEV='amdgpu://GPU-e0880c05003c324d?completion_spin_ns=4294967295' ;;
+  strix) PRESET=chat; PORT=18191; DEV='amdgpu://id/000000e2000000808e270f2b0bbb4e00?completion_spin_ns=4294967295' ;;
+esac
+URL=http://127.0.0.1:$PORT; T=$HOME/loom/.tools/bin/python
+export LOOM_ROOT=${ABROOT:-$HOME/loom030} PYTHONDONTWRITEBYTECODE=1 GREEDY_LONG=${GREEDY_LONG:-0}
+if pgrep -x 'loom-serve|llama-server|llama-bench' | grep -q .; then echo "another server runs"; exit 3; fi
+. "$VD/bin/activate"; mkdir -p "$V/ablogs"
+TAG=$(basename "$OUT" .json)
+( exec nohup loom-serve --device="$DEV" --model="$M" --preset="$PRESET" --pool_backing=fixed --listen=127.0.0.1:$PORT --workers=8 > "$V/ablogs/$TAG.serve.log" 2>&1 < /dev/null ) &
+PID=$!
+stopit() { if tr '\0' ' ' < /proc/$PID/cmdline 2>/dev/null | grep -q loom-serve; then kill -TERM $PID; for _ in $(seq 120); do kill -0 $PID 2>/dev/null || break; sleep 1; done; fi; }
+trap stopit EXIT
+for _ in $(seq 1800); do
+  kill -0 $PID 2>/dev/null || { echo "loom-serve died"; tail -8 "$V/ablogs/$TAG.serve.log"; exit 1; }
+  S=$(curl -s -m 2 $URL/v1/status 2>/dev/null); echo "$S" | grep -q '"registration": *"ready"' && break; echo "$S" | grep -q '"registration": *"failed"' && break; sleep 0.5
+done
+if curl -s -m 2 $URL/v1/status | grep -q '"registration": *"failed"'; then echo "registration failed"; curl -s $URL/v1/status | head -c 1500; exit 4; fi
+$T -I "$HERE/greedy_check.py" $URL thinkingmachines/Inkling-2-Mini "$OUT"
+stopit; trap - EXIT
diff -ruN scripts/mk_mat.py scripts_CMD/mk_mat.py
--- scripts/mk_mat.py	1969-12-31 16:00:00.000000000 -0800
+++ scripts_CMD/mk_mat.py	2026-11-24 12:50:38.977851300 -0800
@@ -0,0 +1,51 @@
+"""usage: mk_mat.py <name> <package dir> <preset> [base mat dir]   (box)
+Hard-link copy of the base materialized model dir (no weight copy). Program files of the package replace the ones of the copy.
+The preset gets the published values (prefix cache 16, transient bytes). The result is ~/inkling/optCMD/mat-<name>."""
+import json
+import os
+import shutil
+import subprocess
+import sys
+
+name, pkg, preset = sys.argv[1:4]
+home = os.path.expanduser("~")
+base = sys.argv[4] if len(sys.argv) > 4 else f"{home}/inkling/optCHAT/mat-r9700"
+dest = f"{home}/inkling/optCMD/mat-{name}"
+if os.path.exists(dest):
+    raise SystemExit(f"exists: {dest}")
+subprocess.check_call(["cp", "-al", base, dest])
+SKIP = ("card.json", "model.json")
+libs_new = []
+for root, _, files in os.walk(pkg):
+    for f in files:
+        rel = os.path.relpath(os.path.join(root, f), pkg)
+        if rel.startswith("test") or f in SKIP or not (f.endswith(".loom") or f.endswith(".json")):
+            continue
+        d = f"{dest}/program/{rel}"
+        src = os.path.join(root, f)
+        if not os.path.exists(d):
+            if not (rel.startswith("kernel/") or rel.startswith("lib/inkling/")) or not rel.endswith(".loom"):
+                continue
+            os.makedirs(os.path.dirname(d), exist_ok=True)
+            libs_new.append(rel)
+        elif open(d, "rb").read() == open(src, "rb").read():
+            continue
+        if os.path.exists(d):
+            os.remove(d)
+        shutil.copyfile(src, d)
+        print("replaced", rel)
+m = json.load(open(f"{dest}/model.json"))
+(old,) = m["presets"].keys()
+p = m["presets"].pop(old)
+p["execution"]["prefix_cache_capacity"] = 16
+p["memory"]["transient_bytes"] = 10800000000
+m["presets"][preset] = p
+libs = m["programs"]["source"]["libraries"]
+have = {e["path"] for e in libs}
+for rel in sorted(libs_new):
+    if f"program/{rel}" not in have:
+        libs.append({"path": f"program/{rel}", "origin": f"@document/program/{rel}"})
+        print("added to model.json:", rel)
+os.remove(f"{dest}/model.json")
+json.dump(m, open(f"{dest}/model.json", "w"), indent=1)
+print(dest)
diff -ruN scripts/prof_run.sh scripts_CMD/prof_run.sh
--- scripts/prof_run.sh	1969-12-31 16:00:00.000000000 -0800
+++ scripts_CMD/prof_run.sh	2026-11-24 13:44:58.234257900 -0800
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# usage: prof_run.sh <r9700|strix> <session> <mat dir> <out dir> [modes]   (GPU box; run under: flock -x ~/hrx-pr1/gpu.lock)
+# One profiled serve session with a raw HAL profile bundle (.irpf), the requests of profile_driver.py, a graceful stop by PID.
+set -u
+G=${1:?r9700|strix}; S=${2:?session}; M=${3:?mat}; O=${4:?out}; MODES=${5:-dispatch-events,queue-events,executable-metadata}
+HERE=$(cd "$(dirname "$0")" && pwd)
+case $G in
+  r9700) PRESET=chat-r9700; PORT=18190; DEV=amdgpu://GPU-e0880c05003c324d ;;
+  strix) PRESET=chat; PORT=18191; DEV=amdgpu://id/000000e2000000808e270f2b0bbb4e00 ;;
+  *) echo gpu; exit 2 ;;
+esac
+DEV="$DEV?completion_spin_ns=4294967295"
+URL=http://127.0.0.1:$PORT; T=$HOME/loom/.tools/bin/python
+export LOOM_ROOT=$HOME/loom030 PYTHONDONTWRITEBYTECODE=1
+mkdir -p "$O"
+if pgrep -x 'loom-serve|llama-server|llama-bench' | grep -q .; then echo "another server runs"; exit 3; fi
+. "$HOME/inkling/tools/M30-venv/bin/activate"
+( cd "$O"; exec nohup loom-serve --device="$DEV" --model="$M" --preset="$PRESET" --pool_backing=fixed --listen=127.0.0.1:$PORT --workers=8 \
+    --device_profiling_mode=$MODES --device_profiling_output="$O/$S.irpf" --device_profiling_flush_interval_ms=5 \
+    > "$O/$S.serve.log" 2>&1 < /dev/null ) &
+PID=$!
+stopit() { if tr '\0' ' ' < /proc/$PID/cmdline 2>/dev/null | grep -q loom-serve; then kill -TERM $PID; for _ in $(seq 120); do kill -0 $PID 2>/dev/null || break; sleep 1; done; fi; }
+trap stopit EXIT
+for _ in $(seq 1200); do
+  kill -0 $PID 2>/dev/null || { echo "serve died"; tail -5 "$O/$S.serve.log"; exit 1; }
+  ST=$(curl -s -m 2 $URL/v1/status 2>/dev/null); echo "$ST" | grep -q '"registration": *"ready"' && break; echo "$ST" | grep -q '"registration": *"failed"' && { echo registration failed; echo "$ST" | head -c 900; exit 4; }; sleep 0.5
+done
+$T -I "$HERE/profile_driver.py" $URL thinkingmachines/Inkling-2-Mini "$S" > "$O/$S.req.json" 2> "$O/$S.driver.err"; rc=$?
+stopit; trap - EXIT
+echo "$G $S driver rc=$rc stopped alive=$(kill -0 $PID 2>/dev/null && echo yes || echo no) dropped=$(grep -c 'dropped_records=[1-9]' "$O/$S.serve.log") bundle=$(ls -l "$O/$S.irpf" 2>/dev/null | awk '{print $5}')"
diff -ruN scripts/queue_seq.py scripts_CMD/queue_seq.py
--- scripts/queue_seq.py	1969-12-31 16:00:00.000000000 -0800
+++ scripts_CMD/queue_seq.py	2026-11-24 13:05:19.913183300 -0800
@@ -0,0 +1,24 @@
+"""Host queue events around steady steps. usage: queue_seq.py <bundle> [first_step_index] [count]"""
+import os
+import sys
+from collections import Counter
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import irpf
+
+b = irpf.load(sys.argv[1])
+first = int(sys.argv[2]) if len(sys.argv) > 2 else 100
+count = int(sys.argv[3]) if len(sys.argv) > 3 else 3
+NAMES = {1: "barrier", 2: "dispatch", 3: "execute", 4: "copy", 5: "fill", 6: "update", 7: "read", 8: "write", 9: "alloca", 10: "dealloca", 11: "host_call", 16: "transfer", 17: "timestamp"}
+q = sorted(b["queue"], key=lambda f: (f[5], f[4]))
+ex = [i for i, f in enumerate(q) if f[1] == 3]
+print("execute events", len(ex))
+lo = ex[first]
+hi = ex[min(first + count, len(ex) - 1)]
+t0 = q[lo][5]
+last = t0
+for f in q[lo - 12:hi + 6]:
+    ty = NAMES.get(f[1], f[1])
+    rdy = (f[17] - t0) / 1000 if f[17] else 0
+    print(f"{(f[5]-t0)/1000:10.1f} us  d={(f[5]-last)/1000:8.1f} {ty:9s} sub={f[6]} cb={f[7]} wait={f[10]} sig={f[11]} bar={f[12]} ops={f[13]} payload={f[16]} ready={rdy:.1f} dep={f[3]} flags={f[2]}")
+    last = f[5]
diff -ruN scripts/step_report.py scripts_CMD/step_report.py
--- scripts/step_report.py	1969-12-31 16:00:00.000000000 -0800
+++ scripts_CMD/step_report.py	2026-11-24 13:04:53.364820900 -0800
@@ -0,0 +1,119 @@
+"""Per-step device timeline report from a HAL profile bundle. usage: step_report.py <bundle> [out.json] [--skip N]
+Steps are submissions of the command buffer with the most dispatches per execute that repeats the most (the decode bucket).
+Gaps are start(next) - end(previous) inside one submission (device idle between dependent dispatches, 100 MHz ticks)."""
+import json
+import os
+import re
+import statistics
+import sys
+from collections import Counter, defaultdict
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import irpf
+
+path = sys.argv[1]
+out = sys.argv[2] if len(sys.argv) > 2 and not sys.argv[2].startswith("--") else None
+skip = int(sys.argv[sys.argv.index("--skip") + 1]) if "--skip" in sys.argv else 3
+fam_file = os.path.join(os.path.dirname(os.path.abspath(__file__)), "profile_families.json")
+FAM = [(n, re.compile(r)) for n, r in json.load(open(fam_file))]
+
+
+def fam(name):
+    for n, r in FAM:
+        if r.search(name):
+            return n
+    return "other"
+
+
+b = irpf.load(path)
+freq = next(iter(b["freq"].values()))
+tick_us = 1e6 / freq
+d = b["disp"]
+by_sub = defaultdict(list)
+for e in d:
+    by_sub[e[1]].append(e)
+cb_of = {s: v[0][2] for s, v in by_sub.items()}
+cb_cnt = Counter(cb_of.values())
+cb_len = {c: Counter(len(by_sub[s]) for s in by_sub if cb_of[s] == c).most_common(1)[0][0] for c in cb_cnt}
+print("command buffers: id -> (submissions, dispatches per step):", {c: (cb_cnt[c], cb_len[c]) for c in cb_cnt})
+sel = max(cb_cnt, key=lambda c: cb_cnt[c])
+subs = sorted(s for s in by_sub if cb_of[s] == sel and len(by_sub[s]) == cb_len[sel])
+subs = subs[skip:]
+print("steady steps:", len(subs), "dispatches/step:", cb_len[sel])
+name = lambda e: b["funcs"].get((e[3], e[5]), f"?{e[3]}:{e[5]}")
+steps = []
+site = defaultdict(lambda: {"dur": [], "gap": []})
+pair = defaultdict(lambda: [0, 0.0])
+hist_edges = [0, 0.05, 0.1, 0.2, 0.3, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 5.0, 10.0, 1e9]
+hist = Counter()
+prev_end = None
+inter = []
+for s in subs:
+    ev = sorted(by_sub[s], key=lambda e: (e[8], e[4]))
+    t0, t1 = ev[0][8], max(e[9] for e in ev)
+    busy = sum(e[9] - e[8] for e in ev) * tick_us
+    gaps = []
+    pe = ev[0][9]
+    for i in range(1, len(ev)):
+        g = (ev[i][8] - pe) * tick_us
+        gaps.append(g)
+        pe = max(pe, ev[i][9])
+        site[ev[i][4]]["gap"].append(g)
+        pair[(fam(name(ev[i - 1])), fam(name(ev[i])))][0] += 1
+        pair[(fam(name(ev[i - 1])), fam(name(ev[i])))][1] += g
+        for k in range(len(hist_edges) - 1):
+            if hist_edges[k] <= g < hist_edges[k + 1]:
+                hist[k] += 1
+                break
+    for e in ev:
+        site[e[4]]["dur"].append((e[9] - e[8]) * tick_us)
+        site[e[4]]["name"] = name(e)
+        site[e[4]]["wgc"] = tuple(e[6])
+    if prev_end is not None:
+        inter.append((t0 - prev_end) * tick_us)
+    prev_end = t1
+    steps.append({"wall": (t1 - t0) * tick_us, "busy": busy, "gap": sum(gaps)})
+med = lambda k: statistics.median(s[k] for s in steps)
+print(f"per step (median us): device wall {med('wall'):.0f}  kernel busy {med('busy'):.0f}  gaps {med('gap'):.0f} ({100*med('gap')/med('wall'):.1f}% of wall)")
+print(f"between steps (end of last dispatch to start of the first of the next), median us: {statistics.median(inter):.0f}  mean {statistics.mean(inter):.0f}")
+print("gap histogram (us bin: count/step):")
+n = len(steps)
+for k in range(len(hist_edges) - 1):
+    print(f"  {hist_edges[k]:>5}-{hist_edges[k+1]:<6} {hist[k]/n:8.1f}")
+# queue-level host events: period of EXECUTE submissions
+ex = sorted(q for q in b["queue"] if q[1] == 3)
+if len(ex) > skip + 2:
+    ht = [q[5] for q in ex][skip:]
+    per = [(ht[i + 1] - ht[i]) / 1000 for i in range(len(ht) - 1)]
+    print(f"host EXECUTE submit period (us) median {statistics.median(per):.0f}")
+# table per launch site grouped by kernel name
+rows = defaultdict(lambda: {"n": 0, "dur": 0.0, "gap": 0.0})
+for ci, v in site.items():
+    r = rows[v["name"]]
+    r["n"] += 1
+    r["dur"] += statistics.median(v["dur"])
+    r["gap"] += statistics.median(v["gap"]) if v["gap"] else 0
+    r["fam"] = fam(v["name"])
+print(f"{'kernel':34s} {'fam':12s} {'n/step':>6s} {'dev us':>8s} {'gap-before us':>13s}")
+tot = {"n": 0, "dur": 0.0, "gap": 0.0}
+for k, r in sorted(rows.items(), key=lambda kv: -kv[1]["dur"]):
+    print(f"{k:34s} {r['fam']:12s} {r['n']:6d} {r['dur']:8.1f} {r['gap']:13.1f}")
+    for x in tot:
+        tot[x] += r[x]
+print(f"{'TOTAL':34s} {'':12s} {tot['n']:6d} {tot['dur']:8.1f} {tot['gap']:13.1f}")
+print("family gaps (prev family -> next family): count/step, sum us/step, mean us")
+for (a, c), (cnt, sg) in sorted(pair.items(), key=lambda kv: -kv[1][1])[:20]:
+    print(f"  {a:12s} -> {c:12s} {cnt/n:7.1f} {sg/n:8.1f} {sg/cnt:6.2f}")
+famrows = defaultdict(lambda: [0, 0.0, 0.0])
+for k, r in rows.items():
+    f = r["fam"]
+    famrows[f][0] += r["n"]
+    famrows[f][1] += r["dur"]
+    famrows[f][2] += r["gap"]
+print("by family: launches/step, device us, gap-before us")
+for f, v in sorted(famrows.items(), key=lambda kv: -kv[1][1]):
+    print(f"  {f:12s} {v[0]:5d} {v[1]:8.1f} {v[2]:8.1f}")
+if out:
+    json.dump({"steps": steps, "inter": inter, "rows": {k: v for k, v in rows.items()}, "hist": dict(hist), "pairs": {f"{a}>{c}": v for (a, c), v in pair.items()},
+               "sites": {str(ci): {"name": v["name"], "wgc": v["wgc"], "dur": statistics.median(v["dur"]), "gap": statistics.median(v["gap"]) if v["gap"] else 0}
+                         for ci, v in site.items()}}, open(out, "w"))
diff -ruN scripts/step_timeline.py scripts_CMD/step_timeline.py
--- scripts/step_timeline.py	1969-12-31 16:00:00.000000000 -0800
+++ scripts_CMD/step_timeline.py	2026-11-24 13:45:47.866167800 -0800
@@ -0,0 +1,24 @@
+"""Dispatch timeline of one steady decode step. usage: step_timeline.py <bundle> [step index] [first dispatch] [count]"""
+import os
+import sys
+from collections import Counter, defaultdict
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import irpf
+
+b = irpf.load(sys.argv[1])
+step = int(sys.argv[2]) if len(sys.argv) > 2 else 50
+first = int(sys.argv[3]) if len(sys.argv) > 3 else 0
+count = int(sys.argv[4]) if len(sys.argv) > 4 else 40
+tick_us = 1e6 / next(iter(b["freq"].values()))
+by = defaultdict(list)
+for e in b["disp"]:
+    by[e[1]].append(e)
+cbs = Counter(v[0][2] for v in by.values())
+sel = cbs.most_common(1)[0][0]
+subs = sorted(s for s, v in by.items() if v[0][2] == sel and len(v) > 500)
+ev = sorted(by[subs[step]], key=lambda e: (e[8], e[4]))
+t0 = ev[0][8]
+for e in ev[first:first + count]:
+    nm = b["funcs"].get((e[3], e[5]), "?")
+    print(f"{(e[8]-t0)*tick_us:9.2f} +{(e[9]-e[8])*tick_us:7.2f}  ci={e[4]:4d} {nm:28s} wg={tuple(e[6])}")
