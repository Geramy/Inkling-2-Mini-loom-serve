--- scripts/bytes_table.py	1969-12-31 16:00:00.000000000 -0800
+++ scripts_CMD/bytes_table.py	2026-11-24 13:12:25.627662000 -0800
@@ -0,0 +1,47 @@
+"""Per-kernel bandwidth table from step_report.py JSON. usage: bytes_table.py <step.json> <ceiling GB/s> [label]
+Expected bytes per decode step (Q4_K_XL, short context) come from docs/ROOFLINE.md and docs/cost_model_output.txt; HAL counters are not available (profile.c:633)."""
+import json
+import sys
+from collections import defaultdict
+
+d = json.load(open(sys.argv[1]))
+ceil = float(sys.argv[2])
+S = d["sites"]
+# (kernel name, wgc x filter) -> (family label, expected MB per step)
+EXP = {
+    "inkling_experts_gate_up": ("experts gate_up", 1231.1),
+    "inkling_experts_down": ("experts down", 616.2),
+    "inkling_experts_down_w64": ("experts down", 616.2),
+    "inkling_gemv_attn_group": ("attn q/rel/gate/k/v/sink group", 1015.4),
+    "inkling_router_logits": ("router logits F32", 56.6),
+}
+CTRL = ("inkling_ctrl_down_msg", "inkling_ctrl_apply_z")
+rows = defaultdict(lambda: [0, 0.0, 0.0])
+for k, v in S.items():
+    n = v["name"]
+    if n == "inkling_gemv_q8_0":
+        lab, mb = ("lm_head Q8_0", 492.1) if v["wgc"][0] > 1000 else ("attn o_proj Q8_0", 361.0)
+    elif n in EXP:
+        lab, mb = EXP[n]
+    elif n in CTRL:
+        lab, mb = "loop controllers (down_msg + apply_z)", 227.4
+    else:
+        lab, mb = n.replace("inkling_", ""), None
+    r = rows[lab]
+    r[0] += 1
+    r[1] += v["dur"]
+    r[2] = mb if mb is not None else 0.0
+tot_us = sum(r[1] for r in rows.values())
+print(f"| kernel family | launches/step | device us/step | expected MB/step | achieved GB/s | % of {ceil:.0f} GB/s |")
+print("|---|---|---|---|---|---|")
+order = sorted(rows.items(), key=lambda kv: -kv[1][1])
+other_n = other_us = 0
+for lab, (n, us, mb) in order:
+    if mb:
+        gbs = mb * 1e6 / (us * 1e-6) / 1e9
+        print(f"| {lab} | {n} | {us:.0f} | {mb:.1f} | {gbs:.0f} | {100*gbs/ceil:.0f} % |")
+    else:
+        other_n += n
+        other_us += us
+        print(f"| {lab} (latency bound) | {n} | {us:.0f} | < 15 total | n/a | n/a |")
+print(f"| TOTAL | {sum(r[0] for r in rows.values())} | {tot_us:.0f} | 3994 | {3994e6/(tot_us*1e-6)/1e9:.0f} | {100*3994e6/(tot_us*1e-6)/1e9/ceil:.0f} % |")
