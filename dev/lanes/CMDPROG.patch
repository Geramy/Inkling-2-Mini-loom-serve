+#!/usr/bin/env bash
+# usage: lsync.sh [gen]   (laptop) copies package_CMD and scripts_CMD over the box work dir; with gen runs the generators there and copies dispatch back
+cd "$(dirname "$0")/.."
+BOX=user@gpu-box
+ssh $BOX 'mkdir -p ~/inkling/optCMD/package ~/inkling/optCMD/scripts'
+tar cf - package_CMD | ssh $BOX 'cd ~/inkling/optCMD && tar xmf - --strip-components=1 -C package'
+tar cf - scripts_CMD | ssh $BOX 'cd ~/inkling/optCMD && tar xmf - --strip-components=1 -C scripts && chmod +x scripts/*.sh'
+if [ "${1:-}" = gen ]; then
+  ssh $BOX 'cd ~/inkling/optCMD && python3 scripts/gen_kernel_decls.py && python3 scripts/gen_hooks.py'
+  ssh $BOX 'cd ~/inkling/optCMD/package && tar cf - dispatch' | tar xf - -C package_CMD
+fi
