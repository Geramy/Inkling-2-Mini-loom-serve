+#!/usr/bin/env bash
+# usage: abba_cmd.sh <r9700|strix> <tag> <metrics> <reps> <order> <label=matdir>...   (box) One fresh server per arm in the given order (ABBA), each arm under the exclusive lock. Results: ~/inkling/optCMD/ab_log.jsonl
+G=${1:?gpu}; X=${2:?tag}; MET=${3:?}; REPS=${4:?}; ORDER=${5:?}; shift 5
+V=$HOME/inkling/optCMD; H=$V/scripts; export INKV=$V
+declare -A DIR
+for a in "$@"; do DIR[${a%%=*}]=${a#*=}; done
+for ((i=0;i<${#ORDER};i++)); do
+  s=${ORDER:$i:1}
+  bash $H/locked.sh bash $H/ab_run.sh $G "${DIR[$s]}" "$X.$G.$s.$i" "$MET" "$REPS"
