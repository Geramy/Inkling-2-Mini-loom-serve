+  %c16 = index.constant 16 : index
+  %zero4 = vector.splatf 0.0 : vector<4xf32>
+  %init = vector.fragment<init> %zero4 shape [%c16, %c16] : vector<4xf32>
+  template.return %init : vector<4xf32>
+}
+
+
+template.decl @inkling.mma64.k64_4x4(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<4xf32>, %acc01: vector<4xf32>, %acc02: vector<4xf32>, %acc03: vector<4xf32>, %acc10: vector<4xf32>, %acc11: vector<4xf32>, %acc12: vector<4xf32>, %acc13: vector<4xf32>, %acc20: vector<4xf32>, %acc21: vector<4xf32>, %acc22: vector<4xf32>, %acc23: vector<4xf32>, %acc30: vector<4xf32>, %acc31: vector<4xf32>, %acc32: vector<4xf32>, %acc33: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
+
