diff -ruN scripts/mk_mat.sh scripts_M30/mk_mat.sh
--- scripts/mk_mat.sh	1969-12-31 16:00:00.000000000 -0800
+++ scripts_M30/mk_mat.sh	2026-11-22 17:05:49.859601900 -0800
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# usage: mk_mat.sh <name> <package dir> [base mat dir] [base package dir]   (box) Hard-link copy of the base materialized model dir with the program files that differ from the base package replaced. No weight copy.
+set -eu
+N=${1:?name}; P=${2:?package}; V=$HOME/inkling/M30
+B=${3:-$HOME/inkling/optD2/mat-base}; BP=${4:-$V/package_T10b}
+D=$V/mat-$N
+[ -d "$D" ] && { echo "exists: $D"; exit 1; }
+cp -al "$B" "$D"
+( cd "$P" && find . -type f \( -name '*.loom' -o -name '*.json' \) -not -path './test/*' -not -name card.json -not -name model.json ) | while read -r f; do
+  f=${f#./}
+  if [ ! -f "$BP/$f" ] || ! cmp -s "$P/$f" "$BP/$f"; then
+    mkdir -p "$(dirname "$D/program/$f")"
+    rm -f "$D/program/$f"; cp "$P/$f" "$D/program/$f"; echo "replaced $f"
+  fi
+done
+echo "$D"
+# new program files: add them to the program library list of the materialized model.json (the file is a hard link: write a new one)
+python3 - "$D" "$P" "$BP" <<'PY'
+import json, os, sys
+D, P, BP = sys.argv[1:4]
+m = json.load(open(f"{D}/model.json"))
+libs = m["programs"]["source"]["libraries"]
+have = {e["path"] for e in libs}
+new = []
+for root, _, files in os.walk(P):
+    for f in files:
+        rel = os.path.relpath(os.path.join(root, f), P)
+        if rel.endswith(".loom") and not rel.startswith("test") and not os.path.exists(os.path.join(BP, rel)) and f"program/{rel}" not in have:
+            new.append(rel)
+after = {"lib/inkling/targets_w64.loom": "program/lib/inkling/dense_targets.loom", "kernel/experts/down_w64.loom": "program/kernel/experts/down.loom"}
+for rel in sorted(new):
+    anchor = after.get(rel)
+    idx = next((i for i, e in enumerate(libs) if e["path"] == anchor), len(libs) - 1) + 1
+    libs.insert(idx, {"path": f"program/{rel}", "origin": f"@document/program/{rel}"})
+    print("added to model.json:", rel)
+os.remove(f"{D}/model.json")
+json.dump(m, open(f"{D}/model.json", "w"), indent=1)
+PY
