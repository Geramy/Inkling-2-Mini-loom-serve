diff -ruN scripts/apply_lane.pl scripts_M30/apply_lane.pl
--- scripts/apply_lane.pl	1969-12-31 16:00:00.000000000 -0800
+++ scripts_M30/apply_lane.pl	2026-11-22 16:51:38.609371700 -0800
@@ -0,0 +1,19 @@
+#!/usr/bin/perl
+# usage: perl apply_lane.pl lane_index.patch [-n]   (laptop, run in the project folder) applies a converted lane patch onto package_M30 and scripts_M30; generated dispatch files are skipped (regenerate them); -n is a dry run
+use strict;
+my ($file, $dry) = @ARGV;
+open(my $f, "<", $file) or die; local $/; my $all = <$f>; close $f;
+my @sec = split(/(?=^--- \S+\t[^\n]*\n\+\+\+ )/m, $all);
+my $bad = 0;
+for my $s (@sec) {
+  $s =~ s/^diff -ruN [^\n]*\n//mg;
+  next unless $s =~ /^\+\+\+ (\S+)/m;
+  my $b = $1;
+  my $t = $b; $t =~ s#^(?:b/)?package(?:_\w+)?/#package_M30/#; $t =~ s#^(?:b/)?scripts(?:_\w+)?/#scripts_M30/#;
+  if ($t =~ m#^package_M30/dispatch/(?!capture_layout)#) { print "skip generated $t\n"; next; }
+  $s =~ s#^--- \S+#--- $t#m; $s =~ s#^\+\+\+ \S+#+++ $t#m;
+  open(my $o, ">", "/tmp/m30_sec.patch") or die; print $o $s; close $o;
+  my $r = system("patch -p0 --no-backup-if-mismatch -s -N " . ($dry ? "--dry-run " : "") . "< /tmp/m30_sec.patch");
+  if ($r) { print "FAILED $t\n"; $bad++ } else { print "ok $t\n" }
+}
+print "failures: $bad\n";
diff -ruN scripts/capture_job.sh scripts_M30/capture_job.sh
--- scripts/capture_job.sh	1969-12-31 16:00:00.000000000 -0800
+++ scripts_M30/capture_job.sh	2026-11-22 17:14:42.731329700 -0800
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# usage: capture_job.sh <r9700|strix> <package dir> <visit...>   (GPU box; run under: flock -x ~/hrx-pr1/gpu.lock)
+# Per visit: starts a sequence server (capture id 99 at that visit, Q8_K_XL weights) from the package dir (serve.sh route), runs capture_all.py against the oracle dumps (prompt A; prompt B whole, 3 chunks, 256+rest, prefill then decode; the 1332 token prompt in 512+rest, 3 chunks, prefill then decode), stops the server by PID. Output lines go to $OUT (default capture_<gpu>.txt in the package parent).
+set -u
+G=${1:?gpu}; PK=${2:?pkg}; shift 2
+case $G in r9700) ARCH=gfx1201; PORT=18290 ;; strix) ARCH=gfx1151; PORT=18291 ;; esac
+R=$(dirname "$PK"); GG=$HOME/models/inkling2-mini/Mainline_Support/Inkling-2-Mini-UD-Q8_K_XL.gguf
+OUT=${OUT:-$R/capture_$G.txt}; T=$R/scripts_integ1; DB=$HOME/inkling/inkB/oracle/dumps; DL=$HOME/inkling/inkE/oracle_long
+TOTAL=$(python3 -c "import json;print(json.load(open('$PK/dispatch/capture_layout.json'))['total'])")
+CV=${CVENV:-$HOME/inkling/tools/M30-venv}; . $CV/bin/activate
+for V in "$@"; do
+  if pgrep -x 'loom-serve|llama-server|llama-bench' | grep -q .; then echo "another server runs"; exit 3; fi
+  RUN=$R/run-sequence-$ARCH; rm -f $RUN/pid
+  INKLING_ROOT=$R INKLING_MODE=sequence INKLING_CAPTURE=99,$V,0,$TOTAL INKLING_GGUF=$GG LOOM_VENV=$CV INKLING_CONTEXT=4096 INKLING_PREFILL=${PREFILL:-2048} INKLING_ROWS=2 \
+    nohup bash $R/scripts/serve.sh $ARCH $PORT > $R/serve-capture-$ARCH.log 2>&1 < /dev/null &
+  sleep 3; PID=$(cat $RUN/pid)
+  ok=0
+  for _ in $(seq 1200); do
+    kill -0 $PID 2>/dev/null || { echo "visit $V: server died"; tail -3 $R/serve-capture-$ARCH.log; break; }
+    s=$(curl -s -m 2 localhost:$PORT/v1/status | grep -o '"registration": *"[a-z_]*"'); case "$s" in *ready*) ok=1; break;; *failed*) echo "visit $V: registration failed"; curl -s localhost:$PORT/v1/status | head -c 800; break;; esac; sleep 0.5
+  done
+  if [ $ok = 1 ]; then
+    run() { python scripts/capture_all.py $PORT "$@" --gguf $GG --layout $PK/dispatch/capture_layout.json 2>&1 | grep -E "^visit|nmse|RESULT|FAIL|Error|rror" | sed "s/^/[$G v$V $LABEL] /"; }
+    cd $R
+    for spec in "A:$DB/Q8_K_XL_A:" "B1:$DB/Q8_K_XL_B:" "B3:$DB/Q8_K_XL_B:--chunks 103,103,102" "Brest:$DB/Q8_K_XL_B:--chunks 256,52" "Bdec:$DB/Q8_K_XL_B:--chunks 304,1,1,1,1" "L1:$DL/Q8_K_XL_L1:" "L1024:$DL/Q8_K_XL_L1:--chunks 1024,308" "L512:$DL/Q8_K_XL_L1:--chunks 512,512,308" "L3:$DL/Q8_K_XL_L1:--chunks 444,444,444" "Ldec:$DL/Q8_K_XL_L1:--chunks 1328,1,1,1,1"; do
+      LABEL=${spec%%:*}; rest=${spec#*:}; dump=${rest%%:*}; fl=${rest#*:}
+      [ -n "${ONLY:-}" ] && ! echo ",$ONLY," | grep -q ",$LABEL," && continue
+      run $dump $V $fl
+    done
+  fi >> $OUT
+  kill -TERM $PID 2>/dev/null; for _ in $(seq 120); do kill -0 $PID 2>/dev/null || break; sleep 1; done
+done
+echo "capture job done: $*"
