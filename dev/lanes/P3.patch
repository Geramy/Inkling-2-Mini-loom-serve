+// Prefill attention over blocks of 64 key positions. One workgroup: 16 query rows of the three heads of one KV head, so one K and V tile serves 48 rows.
+func.def public inline @inkling_attn_pf_row(%rel0: index, %r: index, %len: index, %begin: index, %pos0: index) -> (i1, index, index) {
+  %rel = index.add %rel0, %r : index
+  %valid = index.cmp ult, %rel, %len : index
+  %token0 = index.add %begin, %rel : index
+  %token = scf.select %valid, %token0, %begin : index
+  %qpos = index.add %pos0, %rel : index
+  func.return %valid, %token, %qpos : i1, index, index
+}
