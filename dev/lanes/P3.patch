+  %rrow2 = index.add %rrow, %c2 : index
+  %rrow3 = index.add %rrow, %c3 : index
+  %r0 = vector.load %r_view[%rrow, %c0] : view<48x16xf32> -> vector<16xf32>
+  %r1 = vector.load %r_view[%rrow1, %c0] : view<48x16xf32> -> vector<16xf32>
+  %r2 = vector.load %r_view[%rrow2, %c0] : view<48x16xf32> -> vector<16xf32>
