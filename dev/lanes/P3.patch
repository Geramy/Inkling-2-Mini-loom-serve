+func.def public inline @inkling_attn_pf_sink(%sink: buffer, %cap: index, %head: index, %v0: i1, %v1: i1, %v2: i1, %v3: i1, %t0: index, %t1: index, %t2: index, %t3: index) -> (vector<4xf32>) {
