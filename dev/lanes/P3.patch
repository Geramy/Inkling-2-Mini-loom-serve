+    %x = view.load %sink_view[%t0b, %h] : view<[%cap]x24xf32> -> f32
+    scf.yield %x : f32
+  } else {
+    scf.yield %zero_f : f32
+  }
+  %s1 = scf.if %v1 -> (f32) {
+    %x = view.load %sink_view[%t1b, %h] : view<[%cap]x24xf32> -> f32
+    scf.yield %x : f32
+  } else {
+    scf.yield %zero_f : f32
+  }
+  %s2 = scf.if %v2 -> (f32) {
+    %x = view.load %sink_view[%t2b, %h] : view<[%cap]x24xf32> -> f32
+    scf.yield %x : f32
