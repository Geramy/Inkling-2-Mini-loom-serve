+  %scale4 = vector.splat %scale : vector<4xf32>
+  %empty_scores = vector.splatf -1e+30 : vector<[%packets]x4xf32>
+  %empty_masks = vector.splati 0 : vector<[%packets]x4xi1>
+  %score_view = buffer.view %scores[%origin] : buffer -> view<64x48xf32>
+  %prob_view = buffer.view %probs[%origin] : buffer -> view<64x16xf16>
+  %r_view = buffer.view %r_stage[%origin] : buffer -> view<48x16xf32>
