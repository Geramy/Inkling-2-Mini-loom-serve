+func.def public inline @inkling_attn_pf_page(%is_global: i1, %map: buffer, %map_origin: offset, %max_blocks: index, %kv_origin: offset, %slot_ring: offset, %block: index) -> (offset) {
+  %c16 = index.constant 16 : index
+  %c262144 = index.constant 262144 : offset
+  %map_view = buffer.view %map[%map_origin] : buffer -> view<[%max_blocks]xi32>
+  %bb = index.assume %block [range(%block, 0, 16777215), lt(%block, %max_blocks)] : index
+  %page_off = scf.if %is_global -> (offset) {
+    %page_word = view.load %map_view[%bb] : view<[%max_blocks]xi32> -> i32
+    %page = index.cast %page_word : i32 to index
+    %page_ok = index.assume %page [range(%page, 0, 2147483647)] : index
+    %page_bytes = index.scale %page_ok, %c262144 : index, offset -> offset
+    %at = index.add %kv_origin, %page_bytes : offset
+    scf.yield %at : offset
+  } else {
+    %ring = index.rem %bb, %c16 : index
+    %ring_bytes = index.scale %ring, %c262144 : index, offset -> offset
+    %at = index.add %slot_ring, %ring_bytes : offset
+    scf.yield %at : offset
+  }
+  func.return %page_off : offset
+}
