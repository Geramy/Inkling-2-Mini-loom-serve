+      %prod_view_a = buffer.view %kv_stage[%zero] : buffer -> view<16x128xf32>
+      %prod_view_b = buffer.view %score_stage[%zero] : buffer -> view<16x128xf32>
+      %prod_view_c = buffer.view %q_stage[%zero] : buffer -> view<16x128xf32>
+      vector.fragment.store<result> %acc_a0, %prod_view_a[%c0, %col0] shape [%m, %n] : vector<[%matrix_elements]xf32>, view<16x128xf32>
+      vector.fragment.store<result> %acc_a1, %prod_view_a[%c0, %col1] shape [%m, %n] : vector<[%matrix_elements]xf32>, view<16x128xf32>
+      vector.fragment.store<result> %acc_b0, %prod_view_b[%c0, %col0] shape [%m, %n] : vector<[%matrix_elements]xf32>, view<16x128xf32>
+      vector.fragment.store<result> %acc_b1, %prod_view_b[%c0, %col1] shape [%m, %n] : vector<[%matrix_elements]xf32>, view<16x128xf32>
+      vector.fragment.store<result> %acc_c0, %prod_view_c[%c0, %col0] shape [%m, %n] : vector<[%matrix_elements]xf32>, view<16x128xf32>
+      vector.fragment.store<result> %acc_c1, %prod_view_c[%c0, %col1] shape [%m, %n] : vector<[%matrix_elements]xf32>, view<16x128xf32>
+      %is_lane0 = index.cmp eq, %lane, %c0 : index
+      scf.if %is_lane0 {
+        func.call @inkling_attn_pf_ml(%scale_stage, %row0, %max_a, %sum_a) : (buffer, index, vector<4xf32>, vector<4xf32>) -> ()
+        func.call @inkling_attn_pf_ml(%scale_stage, %row0_b, %max_b, %sum_b) : (buffer, index, vector<4xf32>, vector<4xf32>) -> ()
+        func.call @inkling_attn_pf_ml(%scale_stage, %row0_c, %max_c, %sum_c) : (buffer, index, vector<4xf32>, vector<4xf32>) -> ()
+      }
+      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
+      scf.for %hh = [%c0 to %c3 step %c1] unroll {
+        %head = index.madd %kvh, %c3, %hh : index
+        %is_a = index.cmp eq, %hh, %c0 : index
+        %is_b = index.cmp eq, %hh, %c1 : index
+        scf.for %e = [%tid to %c2048 step %threads] {
+          %local_row0 = index.div %e, %c128 : index
+          %local_row = index.assume %local_row0 [range(%local_row0, 0, 15)] : index
+          %d0 = index.rem %e, %c128 : index
+          %d = index.assume %d0 [range(%d0, 0, 127)] : index
+          %valid, %token0, %qpos_r = func.call @inkling_attn_pf_row(%rel0, %local_row, %len, %begin, %pos0) : (index, index, index, index, index) -> (i1, index, index)
+          %token = index.assume %token0 [range(%token0, 0, 32767), lt(%token0, %cap)] : index
+          %value_a = view.load %prod_view_a[%local_row, %d] : view<16x128xf32> -> f32
+          %value_b = view.load %prod_view_b[%local_row, %d] : view<16x128xf32> -> f32
+          %value_c = view.load %prod_view_c[%local_row, %d] : view<16x128xf32> -> f32
+          %value_ab = scf.select %is_b, %value_b, %value_c : f32
+          %value = scf.select %is_a, %value_a, %value_ab : f32
+          %ml_row = index.madd %hh, %c16, %local_row : index
+          %ml_row_a = index.assume %ml_row [range(%ml_row, 0, 47)] : index
+          %l_row = view.load %ml_view[%ml_row_a, 1] : view<48x2xf32> -> f32
+          scf.if %valid {
+            %inv = scalar.divf %one_f, %l_row : f32
+            %gcol0 = index.madd %head, %c128, %d : index
+            %gcol = index.assume %gcol0 [range(%gcol0, 0, 3071)] : index
+            %g = view.load %gate_view[%token, %gcol] : view<[%cap]x3072xf32> -> f32
+            %sg_val = scalar.logisticf %g : f32
+            %normalized = scalar.mulf %value, %inv : f32
+            %result = scalar.mulf %normalized, %sg_val : f32
+            view.store %result, %out_view[%token, %gcol] : f32, view<[%cap]x3072xf32>
+          }
+        }
+      }
+    }
+  }
+  kernel.return
+}
