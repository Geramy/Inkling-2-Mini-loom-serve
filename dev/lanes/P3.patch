+  %leader = index.cmp ult, %lane, %c16 : index
+  scf.if %leader {
+    %row1 = index.add %row0, %c1 : index
+    %row2 = index.add %row0, %c2 : index
+    %row3 = index.add %row0, %c3 : index
+    %sc0 = vector.extract %old_scale[0] : vector<4xf32> -> f32
+    %sc1 = vector.extract %old_scale[1] : vector<4xf32> -> f32
+    %sc2 = vector.extract %old_scale[2] : vector<4xf32> -> f32
+    %sc3 = vector.extract %old_scale[3] : vector<4xf32> -> f32
+    %lane_c = index.assume %lane [range(%lane, 0, 15)] : index
+    view.store %sc0, %scale_view[%row0, %lane_c] : f32, view<48x16xf32>
+    view.store %sc1, %scale_view[%row1, %lane_c] : f32, view<48x16xf32>
+    view.store %sc2, %scale_view[%row2, %lane_c] : f32, view<48x16xf32>
+    view.store %sc3, %scale_view[%row3, %lane_c] : f32, view<48x16xf32>
+  }
+  func.return
+}
