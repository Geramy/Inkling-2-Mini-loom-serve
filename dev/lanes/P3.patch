+      %v = scf.if %from_act -> (vector<8xf16>) {
+        %rel = index.sub %kpos, %pos0 : index
+        %tok0 = index.add %begin, %rel : index
+        %tok = index.assume %tok0 [range(%tok0, 0, 32767), lt(%tok0, %cap)] : index
