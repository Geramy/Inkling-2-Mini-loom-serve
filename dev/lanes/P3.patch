+func.def public inline @inkling_attn_pf_softmax(%key_origin: index, %lane: index, %width: index, %qpos: vector<4xi32>, %qvalid: vector<4xi1>, %r_stage: buffer, %rrow: index, %rel_bias: buffer, %is_global: i1, %score_col: index, %prob_col: index, %current_max: vector<4xf32>, %current_sum: vector<4xf32>, %scores: buffer, %probs: buffer) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>) {
