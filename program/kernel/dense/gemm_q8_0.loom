// GEMM for Q8_0 weights with matrix ops. Weights and activations are rounded to F16, the sums are in F32.
// Same launch list as the GEMV kernels. K must be a multiple of 64. Workgroups past the live row count exit at once.
// y[r][n] = act(sum_k W[n][k] * x[r][k]) for r < T, n < n_rows.

template.decl @inkling.dense.mma.k64_2x2(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)

template.decl @inkling.dense.mma.k64_4x2(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>, %acc20: vector<8xf32>, %acc21: vector<8xf32>, %acc30: vector<8xf32>, %acc31: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)

template.decl @inkling.dense.mma.zero_acc() -> (vector<8xf32>)

template.decl @inkling.dense.q8_0.block(%weight: buffer, %w_span: index, %block_base: index) -> (i16, vector<8xi16>, vector<8xi16>)

template.decl @inkling.dense.q8_0.decode32_f16(%d_bits: i16, %q0: vector<8xi16>, %q1: vector<8xi16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

func.decl @inkling_dense_live_rows(%control: buffer, %count_origin: offset) -> (index)

func.decl @inkling_dense_col_origin(%origin: offset, %col: index, %last: index, %stride: index) -> (offset)

func.decl @inkling_dense_mm_wmma_load_input8_clamped(%input: buffer, %col_origin: offset, %k_size: index, %index: index) -> (vector<8xf32>)

func.decl @inkling_dense_mm_wmma_store(%dst: buffer, %d_origin: offset, %d_stride: index, %col0: index, %live: index, %last_live: index, %row0: index, %n_rows: index, %acc: vector<8xf32>, %act: index, %cap: f32)

func.def public inline @inkling_dense_mmw_q8_0_loads(%weight: buffer, %w_span: index, %w_block_base: index, %input: buffer, %x_col_origin: offset, %k_size: index, %x_base: index, %k: index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>) {
  %c8 = index.constant 8 : index
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c32 : index
  %block_offset = index.mul %block, %c17 : index
  %block_base = index.add %w_block_base, %block_offset : index
  %d, %q0, %q1 = template.apply<@inkling.dense.q8_0.block>(%weight, %w_span, %block_base) : (buffer, index, index) -> (i16, vector<8xi16>, vector<8xi16>)
  %x_index0 = index.add %x_base, %k_bounded : index
  %x_index1 = index.add %x_index0, %c8 : index
  %x0 = func.call @inkling_dense_mm_wmma_load_input8_clamped(%input, %x_col_origin, %k_size, %x_index0) : (buffer, offset, index, index) -> (vector<8xf32>)
  %x1 = func.call @inkling_dense_mm_wmma_load_input8_clamped(%input, %x_col_origin, %k_size, %x_index1) : (buffer, offset, index, index) -> (vector<8xf32>)
  func.return %d, %q0, %q1, %x0, %x1 : i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>
}

func.def public inline @inkling_dense_mmw_q8_0_loads128(%weight: buffer, %w_span: index, %w_block_base: index, %input: buffer, %x_col_origin: offset, %k_size: index, %x_base: index, %k: index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %d, %q0, %q1, %x0, %x1 = func.call @inkling_dense_mmw_q8_0_loads(%weight, %w_span, %w_block_base, %input, %x_col_origin, %k_size, %x_base, %k) : (buffer, index, index, buffer, offset, index, index, index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>)
  %x_index0 = index.add %x_base, %k : index
  %x_index2 = index.add %x_index0, %c16 : index
  %x_index3 = index.add %x_index2, %c8 : index
  %x2 = func.call @inkling_dense_mm_wmma_load_input8_clamped(%input, %x_col_origin, %k_size, %x_index2) : (buffer, offset, index, index) -> (vector<8xf32>)
  %x3 = func.call @inkling_dense_mm_wmma_load_input8_clamped(%input, %x_col_origin, %k_size, %x_index3) : (buffer, offset, index, index) -> (vector<8xf32>)
  func.return %d, %q0, %q1, %x0, %x1, %x2, %x3 : i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
}

// 128 weight rows and 64 input columns per workgroup. The loads of the next K step overlap the matrix ops.
kernel.def @inkling_gemm_q8_0(%n_rows: index, %cols_cap: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 256 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %rows_round = index.add %n_rows, %c127 : index
  %row_tiles = index.div %rows_round, %c128 : index
  %cols_round = index.add %cols_cap, %c63 : index
  %col_tiles = index.div %cols_round, %c64 : index
  kernel.launch.config workgroups(%row_tiles, %col_tiles, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%control: buffer, %count_origin: offset, %k_size_in: index, %n_rows_in: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %dst: buffer) {
  %k_size = index.assume %k_size_in [range(%k_size_in, 64, 16384), multiple_of(%k_size_in, 64)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c17 = index.constant 17 : index
  %c24 = index.constant 24 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c0_offset = index.constant 0 : offset
  %w_stage_bytes = index.constant 18432 : offset
  %x_stage_bytes = index.constant 9216 : offset
  %row_tile = kernel.workgroup.id<x> : index
  %col_tile = kernel.workgroup.id<y> : index
  %live = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %tile_col0 = index.mul %col_tile, %c64 : index
  %active = index.cmp ult, %tile_col0, %live : index
  scf.if %active {
    %t0 = kernel.workitem.id<x> : index
    %t = index.assume %t0 [range(%t0, 0, 255)] : index
    %s0 = kernel.subgroup.id : index
    %s = index.assume %s0 [range(%s0, 0, 7)] : index
    %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
    %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
    %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
    %w_view = buffer.view %w_stage[%c0_offset] : buffer -> view<128x72xf16>
    %x_view = buffer.view %x_stage[%c0_offset] : buffer -> view<64x72xf16>
    %last_live = index.sub %live, %c1 : index
    %blocks = index.div %k_size, %c32 : index
    %row_units = index.mul %blocks, %c17 : index
    %w_origin_bytes = index.cast %w_origin : offset to index
    %w_origin_halves = index.div %w_origin_bytes, %c2 : index
    %weight_halves = index.mul %n_rows, %row_units : index
    %w_span = index.add %w_origin_halves, %weight_halves : index
    %tile_row0 = index.mul %row_tile, %c128 : index

    %w_local = index.div %t, %c2 : index
    %w_part = index.rem %t, %c2 : index
    %w_row = index.add %tile_row0, %w_local : index
    %w_offset = index.mul %w_row, %row_units : index
    %w_part_offset = index.mul %w_part, %c17 : index
    %w_base = index.add %w_origin_halves, %w_offset : index
    %w_block_base = index.add %w_base, %w_part_offset : index
    %w_k0 = index.mul %w_part, %c32 : index
    %w_k1 = index.add %w_k0, %c8 : index
    %w_k2 = index.add %w_k0, %c16 : index
    %w_k3 = index.add %w_k0, %c24 : index

    %x_local = index.div %t, %c4 : index
    %x_part = index.rem %t, %c4 : index
    %x_col = index.add %tile_col0, %x_local : index
    %x_col_origin = func.call @inkling_dense_col_origin(%x_origin, %x_col, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %x_k0 = index.mul %x_part, %c16 : index
    %x_k1 = index.add %x_k0, %c8 : index

    %sub_col_group = index.rem %s, %c2 : index
    %sub_row_group = index.div %s, %c2 : index
    %sub_col0 = index.mul %sub_col_group, %c32 : index
    %sub_row0 = index.mul %sub_row_group, %c32 : index

    %init = template.apply<@inkling.dense.mma.zero_acc>() : () -> (vector<8xf32>)
    %d_first, %q0_first, %q1_first, %x0_first, %x1_first = func.call @inkling_dense_mmw_q8_0_loads(%weight_noalias, %w_span, %w_block_base, %input_noalias, %x_col_origin, %k_size, %x_k0, %c0) : (buffer, index, index, buffer, offset, index, index, index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>)
    %xh0_first = vector.fptrunc %x0_first : vector<8xf32> to vector<8xf16>
    %xh1_first = vector.fptrunc %x1_first : vector<8xf32> to vector<8xf16>
    %acc00, %acc01, %acc10, %acc11, %d_last, %q0_last, %q1_last, %xh0_last, %xh1_last = scf.for %k0 = [%c0 to %k_size step %c64](%a00 = %init : vector<8xf32>, %a01 = %init : vector<8xf32>, %a10 = %init : vector<8xf32>, %a11 = %init : vector<8xf32>, %d = %d_first : i16, %q0 = %q0_first : vector<8xi16>, %q1 = %q1_first : vector<8xi16>, %xh0 = %xh0_first : vector<8xf16>, %xh1 = %xh1_first : vector<8xf16>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, i16, vector<8xi16>, vector<8xi16>, vector<8xf16>, vector<8xf16>) {
      %v0, %v1, %v2, %v3 = template.apply<@inkling.dense.q8_0.decode32_f16>(%d, %q0, %q1) : (i16, vector<8xi16>, vector<8xi16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)
      vector.store %v0, %w_view[%w_local, %w_k0] : vector<8xf16>, view<128x72xf16>
      vector.store %v1, %w_view[%w_local, %w_k1] : vector<8xf16>, view<128x72xf16>
      vector.store %v2, %w_view[%w_local, %w_k2] : vector<8xf16>, view<128x72xf16>
      vector.store %v3, %w_view[%w_local, %w_k3] : vector<8xf16>, view<128x72xf16>
      vector.store %xh0, %x_view[%x_local, %x_k0] : vector<8xf16>, view<64x72xf16>
      vector.store %xh1, %x_view[%x_local, %x_k1] : vector<8xf16>, view<64x72xf16>
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      // The loads past K read valid memory. Their values are not used.
      %k_next = index.add %k0, %c64 : index
      %dn, %q0n, %q1n, %x0n, %x1n = func.call @inkling_dense_mmw_q8_0_loads(%weight_noalias, %w_span, %w_block_base, %input_noalias, %x_col_origin, %k_size, %x_k0, %k_next) : (buffer, index, index, buffer, offset, index, index, index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>)
      scf.schedule.fence
      %n00, %n01, %n10, %n11 = template.apply<@inkling.dense.mma.k64_2x2>(%x_stage, %w_stage, %sub_col0, %sub_row0, %a00, %a01, %a10, %a11) : (buffer, buffer, index, index, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
      scf.schedule.fence
      %xh0n = vector.fptrunc %x0n : vector<8xf32> to vector<8xf16>
      %xh1n = vector.fptrunc %x1n : vector<8xf32> to vector<8xf16>
      // The next K step overwrites the stages.
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %n00, %n01, %n10, %n11, %dn, %q0n, %q1n, %xh0n, %xh1n : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, i16, vector<8xi16>, vector<8xi16>, vector<8xf16>, vector<8xf16>
    }

    %out_col0 = index.add %tile_col0, %sub_col0 : index
    %out_col1 = index.add %out_col0, %c16 : index
    %out_row0 = index.add %tile_row0, %sub_row0 : index
    %out_row1 = index.add %out_row0, %c16 : index
    func.call @inkling_dense_mm_wmma_store(%dst_noalias, %d_origin, %d_stride, %out_col0, %live, %last_live, %out_row0, %n_rows, %acc00, %act, %cap) : (buffer, offset, index, index, index, index, index, index, vector<8xf32>, index, f32)
    func.call @inkling_dense_mm_wmma_store(%dst_noalias, %d_origin, %d_stride, %out_col0, %live, %last_live, %out_row1, %n_rows, %acc01, %act, %cap) : (buffer, offset, index, index, index, index, index, index, vector<8xf32>, index, f32)
    func.call @inkling_dense_mm_wmma_store(%dst_noalias, %d_origin, %d_stride, %out_col1, %live, %last_live, %out_row0, %n_rows, %acc10, %act, %cap) : (buffer, offset, index, index, index, index, index, index, vector<8xf32>, index, f32)
    func.call @inkling_dense_mm_wmma_store(%dst_noalias, %d_origin, %d_stride, %out_col1, %live, %last_live, %out_row1, %n_rows, %acc11, %act, %cap) : (buffer, offset, index, index, index, index, index, index, vector<8xf32>, index, f32)
  }
  kernel.return
}

// Same as inkling_gemm_q8_0 with 128 input columns per workgroup. The wider tile reads the weights fewer times.
kernel.def @inkling_gemm_wide_q8_0(%n_rows: index, %cols_cap: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 256 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %rows_round = index.add %n_rows, %c127 : index
  %row_tiles = index.div %rows_round, %c128 : index
  %cols_round = index.add %cols_cap, %c127 : index
  %col_tiles = index.div %cols_round, %c128 : index
  kernel.launch.config workgroups(%row_tiles, %col_tiles, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%control: buffer, %count_origin: offset, %k_size_in: index, %n_rows_in: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %dst: buffer) {
  %k_size = index.assume %k_size_in [range(%k_size_in, 64, 16384), multiple_of(%k_size_in, 64)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c17 = index.constant 17 : index
  %c24 = index.constant 24 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c0_offset = index.constant 0 : offset
  %w_stage_bytes = index.constant 18432 : offset
  %x_stage_bytes = index.constant 18432 : offset
  %row_tile = kernel.workgroup.id<x> : index
  %col_tile = kernel.workgroup.id<y> : index
  %live = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %tile_col0 = index.mul %col_tile, %c128 : index
  %active = index.cmp ult, %tile_col0, %live : index
  scf.if %active {
    %t0 = kernel.workitem.id<x> : index
    %t = index.assume %t0 [range(%t0, 0, 255)] : index
    %s0 = kernel.subgroup.id : index
    %s = index.assume %s0 [range(%s0, 0, 7)] : index
    %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
    %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
    %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
    %w_view = buffer.view %w_stage[%c0_offset] : buffer -> view<128x72xf16>
    %x_view = buffer.view %x_stage[%c0_offset] : buffer -> view<128x72xf16>
    %last_live = index.sub %live, %c1 : index
    %blocks = index.div %k_size, %c32 : index
    %row_units = index.mul %blocks, %c17 : index
    %w_origin_bytes = index.cast %w_origin : offset to index
    %w_origin_halves = index.div %w_origin_bytes, %c2 : index
    %weight_halves = index.mul %n_rows, %row_units : index
    %w_span = index.add %w_origin_halves, %weight_halves : index
    %tile_row0 = index.mul %row_tile, %c128 : index

    %w_local = index.div %t, %c2 : index
    %w_part = index.rem %t, %c2 : index
    %w_row = index.add %tile_row0, %w_local : index
    %w_offset = index.mul %w_row, %row_units : index
    %w_part_offset = index.mul %w_part, %c17 : index
    %w_base = index.add %w_origin_halves, %w_offset : index
    %w_block_base = index.add %w_base, %w_part_offset : index
    %w_k0 = index.mul %w_part, %c32 : index
    %w_k1 = index.add %w_k0, %c8 : index
    %w_k2 = index.add %w_k0, %c16 : index
    %w_k3 = index.add %w_k0, %c24 : index

    %x_local = index.div %t, %c2 : index
    %x_part = index.rem %t, %c2 : index
    %x_col = index.add %tile_col0, %x_local : index
    %x_col_origin = func.call @inkling_dense_col_origin(%x_origin, %x_col, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
    %x_k0 = index.mul %x_part, %c32 : index
    %x_k1 = index.add %x_k0, %c8 : index
    %x_k2 = index.add %x_k0, %c16 : index
    %x_k3 = index.add %x_k0, %c24 : index

    %sub_col_group = index.rem %s, %c2 : index
    %sub_row_group = index.div %s, %c2 : index
    %sub_col0 = index.mul %sub_col_group, %c64 : index
    %sub_row0 = index.mul %sub_row_group, %c32 : index

    %init = template.apply<@inkling.dense.mma.zero_acc>() : () -> (vector<8xf32>)
    %d_first, %q0_first, %q1_first, %x0_first, %x1_first, %x2_first, %x3_first = func.call @inkling_dense_mmw_q8_0_loads128(%weight_noalias, %w_span, %w_block_base, %input_noalias, %x_col_origin, %k_size, %x_k0, %c0) : (buffer, index, index, buffer, offset, index, index, index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
    %xh0_first = vector.fptrunc %x0_first : vector<8xf32> to vector<8xf16>
    %xh1_first = vector.fptrunc %x1_first : vector<8xf32> to vector<8xf16>
    %xh2_first = vector.fptrunc %x2_first : vector<8xf32> to vector<8xf16>
    %xh3_first = vector.fptrunc %x3_first : vector<8xf32> to vector<8xf16>
    %acc00, %acc01, %acc10, %acc11, %acc20, %acc21, %acc30, %acc31, %d_last, %q0_last, %q1_last, %xh0_last, %xh1_last, %xh2_last, %xh3_last = scf.for %k0 = [%c0 to %k_size step %c64](%a00 = %init : vector<8xf32>, %a01 = %init : vector<8xf32>, %a10 = %init : vector<8xf32>, %a11 = %init : vector<8xf32>, %a20 = %init : vector<8xf32>, %a21 = %init : vector<8xf32>, %a30 = %init : vector<8xf32>, %a31 = %init : vector<8xf32>, %d = %d_first : i16, %q0 = %q0_first : vector<8xi16>, %q1 = %q1_first : vector<8xi16>, %xh0 = %xh0_first : vector<8xf16>, %xh1 = %xh1_first : vector<8xf16>, %xh2 = %xh2_first : vector<8xf16>, %xh3 = %xh3_first : vector<8xf16>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, i16, vector<8xi16>, vector<8xi16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>) {
      %v0, %v1, %v2, %v3 = template.apply<@inkling.dense.q8_0.decode32_f16>(%d, %q0, %q1) : (i16, vector<8xi16>, vector<8xi16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)
      vector.store %v0, %w_view[%w_local, %w_k0] : vector<8xf16>, view<128x72xf16>
      vector.store %v1, %w_view[%w_local, %w_k1] : vector<8xf16>, view<128x72xf16>
      vector.store %v2, %w_view[%w_local, %w_k2] : vector<8xf16>, view<128x72xf16>
      vector.store %v3, %w_view[%w_local, %w_k3] : vector<8xf16>, view<128x72xf16>
      vector.store %xh0, %x_view[%x_local, %x_k0] : vector<8xf16>, view<128x72xf16>
