// Output head helpers. The lm_head projection itself is inkling_gemv_* or inkling_gemm_* (see docs/KERNELS_dense.md section 4).
//
// Selection list (sel buffer at sel_origin): i32 n_sel, 3 reserved words, then n_sel pairs {span index, token row}.
// Plan packets (metadata buffer): header {span count, eos, ...} (16 bytes), then 9 i32 per span {length, position, source, row, input offset, input length, flags, ...}.
// Flag bit 0 selects the last token of a span.

func.decl @inkling_dense_row_origin(%origin: offset, %row: index, %stride: index) -> (offset)

func.decl @inkling_dense_rms_row(%width: index, %input: buffer, %src_origin: offset, %output: buffer, %dst_origin: offset, %weight: buffer, %weighted: i1, %epsilon: f32)

config.decl @inkling.packet_capacity : %value: index where [range(%value, 2, 2147483646)]

func.decl @inkling_packet_selection_origin(%capacity: index) -> (offset)

// Builds the selection list. all_rows 0: the selected tokens of the packet (header word 2, selection list). all_rows 1: every live token (capture runs).
kernel.def @inkling_head_select(%spans_cap: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%spans_cap: index, %all_rows: index, %metadata: buffer, %sel: buffer, %sel_origin: offset) {
  %cap = index.assume %spans_cap [range(%spans_cap, 1, 2147483646)] : index
  %packet_capacity = config.get @inkling.packet_capacity : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %b0 = index.constant 0 : offset
  %header = buffer.view %metadata[%b0] : buffer -> view<3xi32>
  %live32 = view.load %header[0] : view<3xi32> -> i32
  %chosen32 = view.load %header[2] : view<3xi32> -> i32
  %every = index.cmp ne, %all_rows, %c0 : index
  %count32 = scf.select %every, %live32, %chosen32 : i32
  %count_raw = index.cast %count32 : i32 to index
  %count = index.min %count_raw, %cap : index
  %selection_origin = func.call @inkling_packet_selection_origin(%packet_capacity) : (index) -> (offset)
  %selections = buffer.view %metadata[%selection_origin] : buffer -> view<[%packet_capacity]xi32>
  %b16 = index.constant 16 : offset
  %sel_header = buffer.view %sel[%sel_origin] : buffer -> view<4xi32>
  %list_origin = index.add %sel_origin, %b16 : offset
  %list = buffer.view %sel[%list_origin] : buffer -> view<[%cap]x2xi32>
  scf.for %k = [%c0 to %count step %c1] {
    %k_in = index.assume %k [range(%k, 0, %cap)] : index
    %k_pk = index.assume %k [range(%k, 0, %packet_capacity)] : index
    %picked = view.load %selections[%k_pk] : view<[%packet_capacity]xi32> -> i32
    %k32 = index.cast %k_in : index to i32
    %row = scf.select %every, %k32, %picked : i32
    view.store %k32, %list[%k_in, 0] : i32, view<[%cap]x2xi32>
    view.store %row, %list[%k_in, 1] : i32, view<[%cap]x2xi32>
  }
  %n = index.cast %count : index to i32
  view.store %n, %sel_header[0] : i32, view<4xi32>
  kernel.return
}

// x_sel[k] = rms_norm(cur[row_k]) * weight for k < n_sel. Also sets the padding entries of logits row k to -inf.
kernel.def @inkling_head_norm(%spans_cap: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%spans_cap, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%sel: buffer, %sel_origin: offset, %spans_cap: index, %width: index, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %epsilon: f32, %logit_valid: index, %logit_stride: index, %logits: buffer, %logits_origin: offset, %input: buffer, %weight: buffer, %output: buffer) {
  %cap = index.assume %spans_cap [range(%spans_cap, 1, 65536)] : index
  %slot = kernel.workgroup.id<x> : index
  %b0 = index.constant 0 : offset
  %b16 = index.constant 16 : offset
  %c0 = index.constant 0 : index
  %sel_header = buffer.view %sel[%sel_origin] : buffer -> view<4xi32>
  %n32 = view.load %sel_header[0] : view<4xi32> -> i32
  %n_sel = index.cast %n32 : i32 to index
  %live = index.cmp ult, %slot, %n_sel : index
  %in_cap = index.cmp ult, %slot, %cap : index
  %go = scalar.andi %live, %in_cap : i1
  scf.if %go {
    %slot_in = index.assume %slot [range(%slot, 0, %cap)] : index
    %list_origin = index.add %sel_origin, %b16 : offset
    %list = buffer.view %sel[%list_origin] : buffer -> view<[%cap]x2xi32>
    %row32 = view.load %list[%slot_in, 1] : view<[%cap]x2xi32> -> i32
    %row = index.cast %row32 : i32 to index
    %row_in = index.assume %row [range(%row, 0, 2147483646)] : index
    %src_origin = func.call @inkling_dense_row_origin(%x_origin, %row_in, %x_stride) : (offset, index, index) -> (offset)
    %dst_origin = func.call @inkling_dense_row_origin(%d_origin, %slot_in, %d_stride) : (offset, index, index) -> (offset)
    %true = scalar.constant true : i1
    func.call @inkling_dense_rms_row(%width, %input, %src_origin, %output, %dst_origin, %weight, %true, %epsilon) : (index, buffer, offset, buffer, offset, buffer, i1, f32)
    %t0 = kernel.workitem.id<x> : index
    %pad = index.sub %logit_stride, %logit_valid : index
    %is_pad = index.cmp ult, %t0, %pad : index
    scf.if %is_pad {
      %inf_bits = scalar.constant -8388608 : i32
      %bits = vector.from_elements %inf_bits : vector<1xi32>
      %as_float = vector.bitcast %bits : vector<1xi32> to vector<1xf32>
      %neg_inf = vector.extract %as_float[0] : vector<1xf32> -> f32
      %row_origin = func.call @inkling_dense_row_origin(%logits_origin, %slot_in, %logit_stride) : (offset, index, index) -> (offset)
      %stride_in = index.assume %logit_stride [range(%logit_stride, 8, 2147483647)] : index
      %view = buffer.view %logits[%row_origin] : buffer -> view<[%stride_in]xf32>
      %at = index.add %logit_valid, %t0 : index
      %at_in = index.assume %at [range(%at, 0, 2147483646)] : index
      %at_ok = index.cmp ult, %at_in, %stride_in : index
      scf.if %at_ok {
        view.store %neg_inf, %view[%at_in] : f32, view<[%stride_in]xf32>
      }
    }
  }
  kernel.return
}
