// RMS norms over token-packed F32 rows. The live row count is the first i32 at count_origin in the control buffer.
// Strides are in elements. Output may alias input.

func.decl @inkling_dense_live_rows(%control: buffer, %count_origin: offset) -> (index)

func.decl @inkling_dense_row_origin(%origin: offset, %row: index, %stride: index) -> (offset)

func.decl @inkling_dense_rms_scale(%sum: f32, %width: index, %epsilon: f32) -> (f32)

// One workgroup of 256 workitems for each row. Sum of squares, then scale, then optional weight.
func.def public inline @inkling_dense_rms_row(%width_in: index, %input: buffer, %src_origin: offset, %output: buffer, %dst_origin: offset, %weight: buffer, %weighted: i1, %epsilon: f32) {
  %width = index.assume %width_in [range(%width_in, 4, 2147483640)] : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %b0 = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %first = index.mul %t, %c4 : index
  %step = index.constant 1024 : index
  %src = buffer.view %input[%src_origin] : buffer -> view<[%width]xf32>
  %dst = buffer.view %output[%dst_origin] : buffer -> view<[%width]xf32>
  %scales = buffer.view %weight[%b0] : buffer -> view<[%width]xf32>
  %c3 = index.constant 3 : index
  %partial = scf.for %e = [%first to %width step %step](%acc = %zero : f32) -> (f32) {
    %eb = index.assume %e [range(%e, 0, 2147483640)] : index
    %last = index.add %eb, %c3 : index
    %fits = index.cmp ult, %last, %width : index
    %next = scf.if %fits -> (f32) {
      %x = vector.load %src[%eb] : view<[%width]xf32> -> vector<4xf32>
      %sq = vector.mulf %x, %x : vector<4xf32>
      %r = vector.reduce<addf> %sq, %acc : vector<4xf32>, f32
      scf.yield %r : f32
    } else {
      scf.yield %acc : f32
    }
    scf.yield %next : f32
  }
  %sum = kernel.workgroup.reduce<addf> %partial : f32
  %scale = func.call @inkling_dense_rms_scale(%sum, %width, %epsilon) : (f32, index, f32) -> (f32)
  %scale4 = vector.splat %scale : vector<4xf32>
  scf.for %e = [%first to %width step %step] {
    %eb = index.assume %e [range(%e, 0, 2147483640)] : index
    %last = index.add %eb, %c3 : index
    %fits = index.cmp ult, %last, %width : index
    scf.if %fits {
      %x = vector.load %src[%eb] : view<[%width]xf32> -> vector<4xf32>
      %y = vector.mulf %x, %scale4 : vector<4xf32>
      %out = scf.if %weighted -> (vector<4xf32>) {
        %w = vector.load %scales[%eb] : view<[%width]xf32> -> vector<4xf32>
        %yw = vector.mulf %y, %w : vector<4xf32>
        scf.yield %yw : vector<4xf32>
      } else {
        scf.yield %y : vector<4xf32>
      }
      vector.store %out, %dst[%eb] : vector<4xf32>, view<[%width]xf32>
    }
  }
  func.return
}


// Width 2304 with weights: the three loads of a workitem are issued together and the row is not read twice.
func.def public inline @inkling_dense_rms_row_e(%input: buffer, %src_origin: offset, %output: buffer, %dst_origin: offset, %weight: buffer, %epsilon: f32) {
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c1024 = index.constant 1024 : index
  %c2048 = index.constant 2048 : index
  %c2301 = index.constant 2301 : index
  %width = index.constant 2304 : index
  %b0 = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %e0 = index.mul %t, %c4 : index
  %e1 = index.add %e0, %c1024 : index
  %e2 = index.add %e0, %c2048 : index
  %fit2 = index.cmp ult, %e2, %c2301 : index
  %e2c = scf.select %fit2, %e2, %e0 : index
  %src = buffer.view %input[%src_origin] : buffer -> view<2304xf32>
  %dst = buffer.view %output[%dst_origin] : buffer -> view<2304xf32>
  %scales = buffer.view %weight[%b0] : buffer -> view<2304xf32>
  %x0 = vector.load %src[%e0] : view<2304xf32> -> vector<4xf32>
  %x1 = vector.load %src[%e1] : view<2304xf32> -> vector<4xf32>
  %x2 = vector.load %src[%e2c] : view<2304xf32> -> vector<4xf32>
  %w0 = vector.load %scales[%e0] : view<2304xf32> -> vector<4xf32>
  %w1 = vector.load %scales[%e1] : view<2304xf32> -> vector<4xf32>
  %w2 = vector.load %scales[%e2c] : view<2304xf32> -> vector<4xf32>
  %q0 = vector.mulf %x0, %x0 : vector<4xf32>
  %a0 = vector.reduce<addf> %q0, %zero : vector<4xf32>, f32
  %q1 = vector.mulf %x1, %x1 : vector<4xf32>
  %a1 = vector.reduce<addf> %q1, %a0 : vector<4xf32>, f32
  %q2 = vector.mulf %x2, %x2 : vector<4xf32>
  %r2 = vector.reduce<addf> %q2, %a1 : vector<4xf32>, f32
  %partial = scf.select %fit2, %r2, %a1 : f32
  %sum = kernel.workgroup.reduce<addf> %partial : f32
  %scale = func.call @inkling_dense_rms_scale(%sum, %width, %epsilon) : (f32, index, f32) -> (f32)
  %scale4 = vector.splat %scale : vector<4xf32>
  %y0 = vector.mulf %x0, %scale4 : vector<4xf32>
  %o0 = vector.mulf %y0, %w0 : vector<4xf32>
  vector.store %o0, %dst[%e0] : vector<4xf32>, view<2304xf32>
  %y1 = vector.mulf %x1, %scale4 : vector<4xf32>
  %o1 = vector.mulf %y1, %w1 : vector<4xf32>
  vector.store %o1, %dst[%e1] : vector<4xf32>, view<2304xf32>
  scf.if %fit2 {
    %y2 = vector.mulf %x2, %scale4 : vector<4xf32>
    %o2 = vector.mulf %y2, %w2 : vector<4xf32>
    vector.store %o2, %dst[%e2] : vector<4xf32>, view<2304xf32>
  }
  func.return
}

kernel.def @inkling_rms_norm(%rows: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %width: index, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %count = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %true = scalar.constant true : i1
    %src_origin = func.call @inkling_dense_row_origin(%x_origin, %row, %x_stride) : (offset, index, index) -> (offset)
    %dst_origin = func.call @inkling_dense_row_origin(%d_origin, %row, %d_stride) : (offset, index, index) -> (offset)
    %e_width = index.constant 2304 : index
    %is_e = index.cmp eq, %width, %e_width : index
    scf.if %is_e {
      func.call @inkling_dense_rms_row_e(%input, %src_origin, %output, %dst_origin, %weight, %epsilon) : (buffer, offset, buffer, offset, buffer, f32)
    } else {
      func.call @inkling_dense_rms_row(%width, %input, %src_origin, %output, %dst_origin, %weight, %true, %epsilon) : (index, buffer, offset, buffer, offset, buffer, i1, f32)
    }
  }
  kernel.return
}

// Three columns of one row block in one launch. Column c starts c * col_step bytes after origin and has its own weight.
kernel.def @inkling_rms_norm_cols(%rows: index) {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c3, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %width: index, %origin: offset, %col_step: offset, %epsilon: f32, %input: buffer, %w0: buffer, %w1: buffer, %w2: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %row = kernel.workgroup.id<x> : index
  %col = kernel.workgroup.id<y> : index
  %count = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %true = scalar.constant true : i1
    %col_bytes = index.scale %col, %col_step : index, offset -> offset
    %base = index.add %origin, %col_bytes : offset
    %row_origin = func.call @inkling_dense_row_origin(%base, %row, %width) : (offset, index, index) -> (offset)
    %is0 = index.cmp eq, %col, %c0 : index
    %is1 = index.cmp eq, %col, %c1 : index
    %weight = scf.if %is0 -> (buffer) {
      scf.yield %w0 : buffer
    } else {
      %w12 = scf.if %is1 -> (buffer) {
        scf.yield %w1 : buffer
      } else {
        scf.yield %w2 : buffer
      }
      scf.yield %w12 : buffer
    }
    %e_width = index.constant 2304 : index
    %is_e = index.cmp eq, %width, %e_width : index
    scf.if %is_e {
      func.call @inkling_dense_rms_row_e(%input, %row_origin, %output, %row_origin, %weight, %epsilon) : (buffer, offset, buffer, offset, buffer, f32)
    } else {
      func.call @inkling_dense_rms_row(%width, %input, %row_origin, %output, %row_origin, %weight, %true, %epsilon) : (index, buffer, offset, buffer, offset, buffer, i1, f32)
    }
  }
  kernel.return
}

kernel.def @inkling_rms_norm_plain(%rows: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %width: index, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %epsilon: f32, %input: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %count = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %false = scalar.constant false : i1
    %src_origin = func.call @inkling_dense_row_origin(%x_origin, %row, %x_stride) : (offset, index, index) -> (offset)
    %dst_origin = func.call @inkling_dense_row_origin(%d_origin, %row, %d_stride) : (offset, index, index) -> (offset)
    func.call @inkling_dense_rms_row(%width, %input, %src_origin, %output, %dst_origin, %input, %false, %epsilon) : (index, buffer, offset, buffer, offset, buffer, i1, f32)
  }
  kernel.return
}

// Normalizes each group of %group contiguous values (an attention head) of a row without weights.
// A subgroup owns a group. Rows are token-packed like the full-row kernels.
kernel.def @inkling_rms_norm_heads(%rows: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %width_in: index, %group_in: index, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %epsilon: f32, %input: buffer, %output: buffer) {
  %width = index.assume %width_in [range(%width_in, 4, 2147483640)] : index
  %group = index.assume %group_in [range(%group_in, 4, 65536), multiple_of(%group_in, 4)] : index
  %row = kernel.workgroup.id<x> : index
  %count = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %c0 = index.constant 0 : index
    %c3 = index.constant 3 : index
    %c4 = index.constant 4 : index
    %zero = scalar.constant 0.0 : f32
    %src_origin = func.call @inkling_dense_row_origin(%x_origin, %row, %x_stride) : (offset, index, index) -> (offset)
    %dst_origin = func.call @inkling_dense_row_origin(%d_origin, %row, %d_stride) : (offset, index, index) -> (offset)
    %src = buffer.view %input[%src_origin] : buffer -> view<[%width]xf32>
    %dst = buffer.view %output[%dst_origin] : buffer -> view<[%width]xf32>
    %wave0 = kernel.subgroup.id : index
    %lane0 = kernel.subgroup.lane.id : index
    %size = kernel.subgroup.size : index
    %waves = kernel.subgroup.count : index
    %lane_values = index.mul %lane0, %c4 : index
    %span = index.mul %size, %c4 : index
    %groups = index.div %width, %group : index
    scf.for %g = [%wave0 to %groups step %waves] {
      %base = index.mul %g, %group : index
      %start = index.add %base, %lane_values : index
      %end = index.add %base, %group : index
      %partial = scf.for %e = [%start to %end step %span](%acc = %zero : f32) -> (f32) {
        %eb = index.assume %e [range(%e, 0, 2147483640)] : index
    %last = index.add %eb, %c3 : index
        %fits = index.cmp ult, %last, %width : index
        %next = scf.if %fits -> (f32) {
          %x = vector.load %src[%eb] : view<[%width]xf32> -> vector<4xf32>
          %sq = vector.mulf %x, %x : vector<4xf32>
          %r = vector.reduce<addf> %sq, %acc : vector<4xf32>, f32
          scf.yield %r : f32
        } else {
          scf.yield %acc : f32
        }
        scf.yield %next : f32
      }
      %sum = kernel.subgroup.reduce<addf> %partial : f32
      %scale = func.call @inkling_dense_rms_scale(%sum, %group, %epsilon) : (f32, index, f32) -> (f32)
      %scale4 = vector.splat %scale : vector<4xf32>
      scf.for %e = [%start to %end step %span] {
        %eb = index.assume %e [range(%e, 0, 2147483640)] : index
    %last = index.add %eb, %c3 : index
        %fits = index.cmp ult, %last, %width : index
        scf.if %fits {
          %x = vector.load %src[%eb] : view<[%width]xf32> -> vector<4xf32>
          %y = vector.mulf %x, %scale4 : vector<4xf32>
          vector.store %y, %dst[%eb] : vector<4xf32>, view<[%width]xf32>
        }
      }
    }
  }
  kernel.return
}
