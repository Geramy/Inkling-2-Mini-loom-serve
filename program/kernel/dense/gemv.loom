// GEMV for 1 to 8 live rows with F32 activations. Weights are row-major rows of K values (K a multiple of 256, at most 4096).
// y[col][row] = act(sum_k W[row][k] * x[col][k]). Strides are in elements, origins in bytes. The live row count is the first i32 at count_origin.
// Weight types: 4 Q8_0, 3 BF16, 0 F32 (the codes of the weight motifs).
template.decl @inkling.dense.weight.offsets16(%wtype: index, %part: index) -> (index, index, index, index)

template.decl @inkling.dense.weight.part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)

template.decl @inkling.dense.weight.superblock(%wtype: index) -> (offset, offset, index)

func.decl @inkling_dense_live_rows(%control: buffer, %count_origin: offset) -> (index)

func.decl @inkling_dense_col_origin(%origin: offset, %col: index, %last: index, %stride: index) -> (offset)

func.decl @inkling_dense_epilogue(%value: f32, %act: index, %cap: f32) -> (f32)

func.decl @inkling_dense_store(%dst: buffer, %col_origin: offset, %n_rows: index, %row: index, %value: f32)

func.decl @inkling_dense_mv_xload(%use: i1, %input: buffer, %x_col_origin: offset, %sb: index, %o0: index, %o1: index, %o2: index, %o3: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)

func.decl @inkling_dense_mv_dot16(%use: i1, %w0: vector<4xf32>, %w1: vector<4xf32>, %w2: vector<4xf32>, %w3: vector<4xf32>, %x0: vector<4xf32>, %x1: vector<4xf32>, %x2: vector<4xf32>, %x3: vector<4xf32>) -> (f32)

template.decl @inkling.dense.gemv.xs_wg_per_unit() -> (index)

func.decl pure @inkling_dense_mv_xs_plan(%n_rows: index, %k_size: index, %per_unit: index) -> (index, index, index, index)

func.decl @inkling_dense_mv_xs_stage_index(%p: index, %col: index, %slot: index) -> (index)

config.decl @inkling.dense.gemv.cols : %value: index where [range(%value, 1, 8)]

config.decl @inkling.dense.gemv.xs_depth : %value: index where [range(%value, 1, 4)]


func.def public inline @inkling_dense_gemv_xs(%wtype: index, %n_rows_in: index, %k_size_in: index, %control: buffer, %count_origin: offset, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %dst: buffer) {
  %k_size = index.assume %k_size_in [range(%k_size_in, 256, 4096), multiple_of(%k_size_in, 256)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_tile = config.get @inkling.dense.gemv.cols : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c4096 = index.constant 4096 : index
  %stage_bytes = index.constant 16384 : offset
  %b0 = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %depth = config.get @inkling.dense.gemv.xs_depth : index
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %slot = index.div %t, %c16 : index
  %part = index.rem %t, %c16 : index
  %wg = kernel.workgroup.id<x> : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %stage_view = buffer.view %stage[%b0] : buffer -> view<4096xf32>
  %unit_bytes, %sb_bytes, %sb_units = template.apply<@inkling.dense.weight.superblock>(%wtype) : (index) -> (offset, offset, index)
  %per_unit = template.apply<@inkling.dense.gemv.xs_wg_per_unit>() : () -> (index)
  %n_sb, %rows_par, %n_pass, %n_wg = func.call pure @inkling_dense_mv_xs_plan(%n_rows, %k_size, %per_unit) : (index, index, index) -> (index, index, index, index)
  %row_off = index.div %slot, %n_sb : index
  %sb = index.rem %slot, %n_sb : index
  %slot_on = index.cmp ult, %row_off, %rows_par : index
  %pass0 = index.mul %wg, %n_pass : index
  %row0 = index.mul %pass0, %rows_par : index
  %wg_rows = index.mul %n_pass, %rows_par : index
  %row_end_raw = index.add %row0, %wg_rows : index
  %row_end = index.min %row_end_raw, %n_rows : index
  %last_row = index.sub %row_end, %c1 : index
  %n_live0 = func.call @inkling_dense_live_rows(%control, %count_origin) : (buffer, offset) -> (index)
  %n_live = index.min %n_live0, %n_tile : index
  %live_floor = index.max %n_live, %c1 : index
  %last_live = index.sub %live_floor, %c1 : index
  %xo0 = func.call @inkling_dense_col_origin(%x_origin, %c0, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo1 = func.call @inkling_dense_col_origin(%x_origin, %c1, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo2 = func.call @inkling_dense_col_origin(%x_origin, %c2, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo3 = func.call @inkling_dense_col_origin(%x_origin, %c3, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo4 = func.call @inkling_dense_col_origin(%x_origin, %c4, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo5 = func.call @inkling_dense_col_origin(%x_origin, %c5, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo6 = func.call @inkling_dense_col_origin(%x_origin, %c6, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %xo7 = func.call @inkling_dense_col_origin(%x_origin, %c7, %last_live, %x_stride) : (offset, index, index, index) -> (offset)
  %use0 = index.cmp ult, %c0, %n_tile : index
  %use1 = index.cmp ult, %c1, %n_tile : index
  %use2 = index.cmp ult, %c2, %n_tile : index
  %use3 = index.cmp ult, %c3, %n_tile : index
  %use4 = index.cmp ult, %c4, %n_tile : index
  %use5 = index.cmp ult, %c5, %n_tile : index
  %use6 = index.cmp ult, %c6, %n_tile : index
  %use7 = index.cmp ult, %c7, %n_tile : index
  %o0, %o1, %o2, %o3 = template.apply<@inkling.dense.weight.offsets16>(%wtype, %part) : (index, index) -> (index, index, index, index)
  %x00, %x01, %x02, %x03 = func.call @inkling_dense_mv_xload(%use0, %input_noalias, %xo0, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x10, %x11, %x12, %x13 = func.call @inkling_dense_mv_xload(%use1, %input_noalias, %xo1, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x20, %x21, %x22, %x23 = func.call @inkling_dense_mv_xload(%use2, %input_noalias, %xo2, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x30, %x31, %x32, %x33 = func.call @inkling_dense_mv_xload(%use3, %input_noalias, %xo3, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x40, %x41, %x42, %x43 = func.call @inkling_dense_mv_xload(%use4, %input_noalias, %xo4, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x50, %x51, %x52, %x53 = func.call @inkling_dense_mv_xload(%use5, %input_noalias, %xo5, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x60, %x61, %x62, %x63 = func.call @inkling_dense_mv_xload(%use6, %input_noalias, %xo6, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %x70, %x71, %x72, %x73 = func.call @inkling_dense_mv_xload(%use7, %input_noalias, %xo7, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, offset, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
  %row_blocks = index.div %k_size, %c256 : index
  %row_units = index.mul %row_blocks, %sb_units : index
  %sb_offset = index.scale %sb, %sb_bytes : index, offset -> offset
  %w_sb_byte = index.add %w_origin, %sb_offset : offset
  %in_tile = index.cmp ult, %part, %n_tile : index
  %writer = scf.select %slot_on, %in_tile, %false : i1
  %is1 = index.cmp eq, %part, %c1 : index
  %is2 = index.cmp eq, %part, %c2 : index
  %is3 = index.cmp eq, %part, %c3 : index
  %is4 = index.cmp eq, %part, %c4 : index
  %is5 = index.cmp eq, %part, %c5 : index
  %is6 = index.cmp eq, %part, %c6 : index
  %is7 = index.cmp eq, %part, %c7 : index
  scf.for %p = [%c0 to %n_pass step %c1] pipeline(%depth) {
    // A row past the end reads the last row. The final sum skips its partial.
    %pass = index.add %pass0, %p : index
    %pass_row = index.mul %pass, %rows_par : index
    %row_raw = index.add %pass_row, %row_off : index
    %row_in = index.cmp ult, %row_raw, %n_rows : index
    %row = scf.select %row_in, %row_raw, %last_row : index
    %w_row = index.mul %row, %row_units : index
    %w_row_byte = index.scale %w_row, %unit_bytes : index, offset -> offset
    %sb_byte = index.add %w_sb_byte, %w_row_byte : offset
    %d0, %d1, %d2, %d3, %q0, %q1, %q2, %q3 = template.apply<@inkling.dense.weight.part16>(%wtype, %weight_noalias, %sb_byte, %part) : (index, buffer, offset, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)
    %s0 = func.call @inkling_dense_mv_dot16(%use0, %d0, %d1, %d2, %d3, %x00, %x01, %x02, %x03) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s1 = func.call @inkling_dense_mv_dot16(%use1, %d0, %d1, %d2, %d3, %x10, %x11, %x12, %x13) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s2 = func.call @inkling_dense_mv_dot16(%use2, %d0, %d1, %d2, %d3, %x20, %x21, %x22, %x23) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s3 = func.call @inkling_dense_mv_dot16(%use3, %d0, %d1, %d2, %d3, %x30, %x31, %x32, %x33) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s4 = func.call @inkling_dense_mv_dot16(%use4, %d0, %d1, %d2, %d3, %x40, %x41, %x42, %x43) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s5 = func.call @inkling_dense_mv_dot16(%use5, %d0, %d1, %d2, %d3, %x50, %x51, %x52, %x53) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s6 = func.call @inkling_dense_mv_dot16(%use6, %d0, %d1, %d2, %d3, %x60, %x61, %x62, %x63) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %s7 = func.call @inkling_dense_mv_dot16(%use7, %d0, %d1, %d2, %d3, %x70, %x71, %x72, %x73) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
    %v1 = scf.select %is1, %s1, %s0 : f32
    %v2 = scf.select %is2, %s2, %v1 : f32
    %v3 = scf.select %is3, %s3, %v2 : f32
    %v4 = scf.select %is4, %s4, %v3 : f32
    %v5 = scf.select %is5, %s5, %v4 : f32
    %v6 = scf.select %is6, %s6, %v5 : f32
    %v7 = scf.select %is7, %s7, %v6 : f32
    scf.if %writer {
      %i_raw = func.call @inkling_dense_mv_xs_stage_index(%p, %part, %slot) : (index, index, index) -> (index)
      %i = index.assume %i_raw [range(%i_raw, 0, 4095)] : index
      %i_in = index.cmp ult, %i, %c4096 : index
      scf.if %i_in {
        view.store %v7, %stage_view[%i] : f32, view<4096xf32>
      }
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %n_out = index.mul %wg_rows, %n_tile : index
  scf.for %o_raw = [%t to %n_out step %c256] {
    %o = index.assume %o_raw [range(%o_raw, 0, 4095)] : index
    %row_local = index.div %o, %n_tile : index
    %col = index.rem %o, %n_tile : index
    %p = index.div %row_local, %rows_par : index
    %ro = index.rem %row_local, %rows_par : index
    %row = index.add %row0, %row_local : index
    %row_in = index.cmp ult, %row, %n_rows : index
    %col_in = index.cmp ult, %col, %n_live : index
    %st = scf.select %row_in, %col_in, %false : i1
    scf.if %st {
      %ro_slots = index.mul %ro, %n_sb : index
      %sum = scf.for %j = [%c0 to %n_sb step %c1](%acc = %zero : f32) -> (f32) {
        %slot_j = index.add %ro_slots, %j : index
        %i_raw = func.call @inkling_dense_mv_xs_stage_index(%p, %col, %slot_j) : (index, index, index) -> (index)
        %i = index.assume %i_raw [range(%i_raw, 0, 4095)] : index
        %i_in = index.cmp ult, %i, %c4096 : index
        %next = scf.if %i_in -> (f32) {
          %part_sum = view.load %stage_view[%i] : view<4096xf32> -> f32
          %a = scalar.addf %acc, %part_sum : f32
          scf.yield %a : f32
        } else {
          scf.yield %acc : f32
        }
        scf.yield %next : f32
      }
      %y = func.call @inkling_dense_epilogue(%sum, %act, %cap) : (f32, index, f32) -> (f32)
      %d_col = func.call @inkling_dense_col_origin(%d_origin, %col, %last_live, %d_stride) : (offset, index, index, index) -> (offset)
      func.call @inkling_dense_store(%dst_noalias, %d_col, %n_rows, %row, %y) : (buffer, offset, index, index, f32)
    }
  }
  func.return
}


kernel.def @inkling_gemv_q8_0(%n_rows: index, %k_size: index, %per_unit: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %n_sb, %rows_par, %n_pass, %n_wg = func.call pure @inkling_dense_mv_xs_plan(%n_rows, %k_size, %per_unit) : (index, index, index) -> (index, index, index, index)
  kernel.launch.config workgroups(%n_wg, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %wtype = index.constant 4 : index
  func.call @inkling_dense_gemv_xs(%wtype, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (index, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def @inkling_gemv_bf16(%n_rows: index, %k_size: index, %per_unit: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %n_sb, %rows_par, %n_pass, %n_wg = func.call pure @inkling_dense_mv_xs_plan(%n_rows, %k_size, %per_unit) : (index, index, index) -> (index, index, index, index)
  kernel.launch.config workgroups(%n_wg, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %wtype = index.constant 3 : index
  func.call @inkling_dense_gemv_xs(%wtype, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (index, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def @inkling_gemv_f32(%n_rows: index, %k_size: index, %per_unit: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %n_sb, %rows_par, %n_pass, %n_wg = func.call pure @inkling_dense_mv_xs_plan(%n_rows, %k_size, %per_unit) : (index, index, index) -> (index, index, index, index)
  kernel.launch.config workgroups(%n_wg, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%control: buffer, %count_origin: offset, %k_size: index, %n_rows: index, %w_origin: offset, %x_origin: offset, %x_stride: index, %d_origin: offset, %d_stride: index, %act: index, %cap: f32, %weight: buffer, %input: buffer, %output: buffer) {
  %wtype = index.constant 0 : index
  func.call @inkling_dense_gemv_xs(%wtype, %n_rows, %k_size, %control, %count_origin, %w_origin, %x_origin, %x_stride, %d_origin, %d_stride, %act, %cap, %weight, %input, %output) : (index, index, index, buffer, offset, offset, offset, index, offset, index, index, f32, buffer, buffer, buffer)
  kernel.return
}
