// Loop controller: z = down [rms(x); rms(m)], x' = x - tanh(forget z) x + tanh(gain z) m, then rms norm with weight.
// ctrl_down writes partial sums of z, ctrl_z adds them, ctrl_apply evaluates the two 64 to 2304 products.

config.decl @inkling.mix.ctrl_chunk : %value: index where [range(%value, 64, 512), multiple_of(%value, 64)]
config.decl @inkling.mix.ctrl_bf16 : %value: index where [range(%value, 0, 1)]
config.decl @inkling.mix.ctrl_tokens : %value: index where [range(%value, 1, 64)]

func.decl @inkling_mix_softmax(%lds: buffer, %q: index, %nb: index) -> (f32, f32)

func.decl @inkling_mix_coeff(%lds: buffer, %q: index, %s: index, %max_q: f32, %inv_q: f32, %single: i1) -> (f32)

func.decl @inkling_mix_axpy(%acc: vector<4xf32>, %c: f32, %x: vector<4xf32>) -> (vector<4xf32>)

func.def public inline @inkling_ctrl_weights4(%w: buffer, %elem: index, %bf16: i1) -> (vector<4xf32>) {
  %origin = index.constant 0 : offset
  %v = scf.if %bf16 -> (vector<4xf32>) {
    %view = buffer.view %w[%origin] : buffer -> view<294912xbf16>
    %raw = vector.load %view[%elem] : view<294912xbf16> -> vector<4xbf16>
    %wide = vector.extf %raw : vector<4xbf16> to vector<4xf32>
    scf.yield %wide : vector<4xf32>
  } else {
    %view = buffer.view %w[%origin] : buffer -> view<294912xf32>
    %x = vector.load %view[%elem] : view<294912xf32> -> vector<4xf32>
    scf.yield %x : vector<4xf32>
  }
  func.return %v : vector<4xf32>
}

func.def public inline @inkling_ctrl_pick(%c: index, %a: buffer, %b: buffer, %d: buffer) -> (buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %is1 = index.cmp eq, %c, %c1 : index
  %is0 = index.cmp eq, %c, %c0 : index
  %bd = scf.select %is1, %b, %d : buffer
  %r = scf.select %is0, %a, %bd : buffer
  func.return %r : buffer
}

func.def public inline @inkling_ctrl_f32(%buf: buffer, %elem: index) -> (f32) {
  %four = index.constant 4 : offset
  %bytes = index.scale %elem, %four : index, offset -> offset
  %view = buffer.view %buf[%bytes] : buffer -> view<1xf32>
  %v = view.load %view[0] : view<1xf32> -> f32
  func.return %v : f32
}

func.def public inline @inkling_ctrl_store(%buf: buffer, %elem: index, %v: f32) {
  %four = index.constant 4 : offset
  %bytes = index.scale %elem, %four : index, offset -> offset
  %view = buffer.view %buf[%bytes] : buffer -> view<1xf32>
  view.store %v, %view[0] : f32, view<1xf32>
  func.return
}

func.def public inline @inkling_ctrl_live(%spans: buffer) -> (index) {
  %origin = index.constant 0 : offset
  %header = buffer.view %spans[%origin] : buffer -> view<4xi32>
  %word = view.load %header[1] : view<4xi32> -> i32
  %live = index.cast %word : i32 to index
  func.return %live : index
}

kernel.def export("inkling_ctrl_down") @inkling_ctrl_down(%cap: index, %nc: index) {
  %one = index.constant 1 : index
  %chunk = config.get @inkling.mix.ctrl_chunk : index
  %tokens = config.get @inkling.mix.ctrl_tokens : index
  %full = index.constant 4608 : index
  %chunks = index.div %full, %chunk : index
  %cap_up = index.add %cap, %tokens : index
  %cap_dec = index.constant 1 : index
  %cap_m1 = index.sub %cap_up, %cap_dec : index
  %tiles = index.div %cap_m1, %tokens : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%chunks, %tiles, %nc) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %nc_in: index, %x_col0_in: index, %x_col_step_in: index, %m_col0_in: index, %col_stride_in: index, %spans: buffer, %x: buffer, %m: buffer, %down0: buffer, %down1: buffer, %down2: buffer, %part: buffer) {
  %x_col0 = index.assume %x_col0_in [range(%x_col0_in, 0, 3)] : index
  %x_col_step = index.assume %x_col_step_in [range(%x_col_step_in, 0, 1)] : index
  %m_col0 = index.assume %m_col0_in [range(%m_col0_in, 0, 3)] : index
  %col_stride = index.assume %col_stride_in [range(%col_stride_in, 0, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %embd = index.constant 2304 : index
  %full = index.constant 4608 : index
  %four = index.constant 4 : offset
  %chunk = config.get @inkling.mix.ctrl_chunk : index
  %tokens = config.get @inkling.mix.ctrl_tokens : index
  %bf16_cfg = config.get @inkling.mix.ctrl_bf16 : index
  %bf16 = index.cmp ne, %bf16_cfg, %c0 : index
  %f0 = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %kc = kernel.workgroup.id<x> : index
  %tile = kernel.workgroup.id<y> : index
  %c = kernel.workgroup.id<z> : index
  %tid = kernel.workitem.id<x> : index
  %live = func.call @inkling_ctrl_live(%spans) : (buffer) -> (index)
  %first_token = index.mul %tile, %tokens : index
  %tile_active = index.cmp ult, %first_token, %live : index
  scf.if %tile_active {
    %row = index.div %tid, %c4 : index
    %kl = index.rem %tid, %c4 : index
    %chunk_x = index.div %embd, %chunk : index
    %in_x = index.cmp ult, %kc, %chunk_x : index
    %x_col = index.madd %c, %x_col_step, %x_col0 : index
    %m_col = index.add %m_col0, %c : index
    %chunk_start = index.mul %kc, %chunk : index
    %m_start = index.sub %chunk_start, %embd : index
    %src = scf.select %in_x, %x, %m : buffer
    %col = scf.select %in_x, %x_col, %m_col : index
    %local = scf.select %in_x, %chunk_start, %m_start : index
    %col_base = index.mul %col, %col_stride : index
    %down = func.call @inkling_ctrl_pick(%c, %down0, %down1, %down2) : (index, buffer, buffer, buffer) -> (buffer)
    %row_base = index.mul %row, %full : index
    %w_base = index.add %row_base, %chunk_start : index
    %nj = index.div %chunk, %c16 : index
    %bank0 = vector.splatf 0.0 : vector<[%nj]x4xf32>
    %bank = scf.for %j = [%c0 to %nj step %c1](%b = %bank0 : vector<[%nj]x4xf32>) -> (vector<[%nj]x4xf32>) unroll {
      %vec = index.madd %j, %c4, %kl : index
      %e = index.mul %vec, %c4 : index
      %we = index.add %w_base, %e : index
      %w4 = func.call @inkling_ctrl_weights4(%down, %we, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
      %b_next = vector.insert %w4 into %b[%j] : vector<4xf32>, vector<[%nj]x4xf32>
      scf.yield %b_next : vector<[%nj]x4xf32>
    }
    %kcs = index.div %full, %chunk : index
    %writer = index.cmp eq, %kl, %c0 : index
    scf.for %tb = [%c0 to %tokens step %c1] {
      %token = index.add %first_token, %tb : index
      %token_live = index.cmp ult, %token, %live : index
      scf.if %token_live {
        %tok_base = index.madd %token, %embd, %col_base : index
        %in_base = index.add %tok_base, %local : index
        %in_bytes = index.scale %in_base, %four : index, offset -> offset
        %in_view = buffer.view %src[%in_bytes] : buffer -> view<512xf32>
        %acc = scf.for %j = [%c0 to %nj step %c1](%a = %zero4 : vector<4xf32>) -> (vector<4xf32>) unroll {
          %vec = index.madd %j, %c4, %kl : index
          %e = index.mul %vec, %c4 : index
          %xv = vector.load %in_view[%e] : view<512xf32> -> vector<4xf32>
          %w4 = vector.extract %bank[%j] : vector<[%nj]x4xf32> -> vector<4xf32>
          %s = vector.fmaf %w4, %xv, %a : vector<4xf32>
          scf.yield %s : vector<4xf32>
        }
        %lane = vector.reduce<addf> %acc, %f0 : vector<4xf32>, f32
        %sum = kernel.subgroup.reduce<addf> %lane {cluster_size = 4} : f32
        scf.if %writer {
          %pc = index.madd %c, %cap_in, %token : index
          %pk = index.madd %pc, %kcs, %kc : index
          %pe0 = index.madd %pk, %c64, %row : index
          %pe = index.assume %pe0 [range(%pe0, 0, 2147483640)] : index
          func.call @inkling_ctrl_store(%part, %pe, %sum) : (buffer, index, f32)
        }
      }
    }
  }
  kernel.return
}

kernel.def export("inkling_ctrl_z") @inkling_ctrl_z(%cap: index, %nc: index) {
  %one = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%cap, %nc, %one) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %nc_in: index, %x_col0_in: index, %x_col_step_in: index, %m_col0_in: index, %spans: buffer, %rinv_x: buffer, %rinv_m: buffer, %part: buffer, %z: buffer) {
  %x_col0 = index.assume %x_col0_in [range(%x_col0_in, 0, 3)] : index
  %x_col_step = index.assume %x_col_step_in [range(%x_col_step_in, 0, 1)] : index
  %m_col0 = index.assume %m_col0_in [range(%m_col0_in, 0, 3)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %embd = index.constant 2304 : index
  %full = index.constant 4608 : index
  %chunk = config.get @inkling.mix.ctrl_chunk : index
  %f0 = scalar.constant 0.0 : f32
  %token = kernel.workgroup.id<x> : index
  %c = kernel.workgroup.id<y> : index
  %o = kernel.workitem.id<x> : index
  %live = func.call @inkling_ctrl_live(%spans) : (buffer) -> (index)
  %active = index.cmp ult, %token, %live : index
  scf.if %active {
    %x_col = index.madd %c, %x_col_step, %x_col0 : index
    %m_col = index.add %m_col0, %c : index
    %rx_i0 = index.madd %x_col, %cap_in, %token : index
    %rm_i0 = index.madd %m_col, %cap_in, %token : index
    %rx_i = index.assume %rx_i0 [range(%rx_i0, 0, 2147483640)] : index
    %rm_i = index.assume %rm_i0 [range(%rm_i0, 0, 2147483640)] : index
    %rx = func.call @inkling_ctrl_f32(%rinv_x, %rx_i) : (buffer, index) -> (f32)
    %rm = func.call @inkling_ctrl_f32(%rinv_m, %rm_i) : (buffer, index) -> (f32)
    %kcs = index.div %full, %chunk : index
    %chunk_x = index.div %embd, %chunk : index
    %pc = index.madd %c, %cap_in, %token : index
    %pk0 = index.mul %pc, %kcs : index
    %zx = scf.for %k = [%c0 to %chunk_x step %c1](%a = %f0 : f32) -> (f32) unroll {
      %pk = index.add %pk0, %k : index
      %pe0 = index.madd %pk, %c64, %o : index
      %pe = index.assume %pe0 [range(%pe0, 0, 2147483640)] : index
      %p = func.call @inkling_ctrl_f32(%part, %pe) : (buffer, index) -> (f32)
      %s = scalar.addf %a, %p : f32
      scf.yield %s : f32
    }
    %zm = scf.for %k = [%chunk_x to %kcs step %c1](%a = %f0 : f32) -> (f32) unroll {
      %pk = index.add %pk0, %k : index
      %pe0 = index.madd %pk, %c64, %o : index
      %pe = index.assume %pe0 [range(%pe0, 0, 2147483640)] : index
      %p = func.call @inkling_ctrl_f32(%part, %pe) : (buffer, index) -> (f32)
      %s = scalar.addf %a, %p : f32
      scf.yield %s : f32
    }
    %zx_s = scalar.mulf %zx, %rx : f32
    %z_val = scalar.fmaf %zm, %rm, %zx_s : f32
    %zi0 = index.madd %pc, %c64, %o : index
    %zi = index.assume %zi0 [range(%zi0, 0, 2147483640)] : index
    func.call @inkling_ctrl_store(%z, %zi, %z_val) : (buffer, index, f32)
  }
  kernel.return
}

// Gates of one token and one output row: tanh(forget z) and tanh(gain z). The weight rows are in registers (8 lanes per row), z is read from zbuf.
func.def public inline @inkling_ctrl_gates(%zbuf: buffer, %z_base: index, %l: index, %f4a: vector<4xf32>, %f4b: vector<4xf32>, %g4a: vector<4xf32>, %g4b: vector<4xf32>) -> (f32, f32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %four = index.constant 4 : offset
  %f0 = scalar.constant 0.0 : f32
  %zi = index.mul %l, %c8 : index
  %zi1 = index.add %zi, %c4 : index
  %z_bytes = index.scale %z_base, %four : index, offset -> offset
  %z_view = buffer.view %zbuf[%z_bytes] : buffer -> view<64xf32>
  %z0 = vector.load %z_view[%zi] : view<64xf32> -> vector<4xf32>
  %z1 = vector.load %z_view[%zi1] : view<64xf32> -> vector<4xf32>
  %fa = vector.mulf %f4a, %z0 : vector<4xf32>
  %fb = vector.fmaf %f4b, %z1, %fa : vector<4xf32>
  %ga = vector.mulf %g4a, %z0 : vector<4xf32>
  %gb = vector.fmaf %g4b, %z1, %ga : vector<4xf32>
  %fl = vector.reduce<addf> %fb, %f0 : vector<4xf32>, f32
  %gl = vector.reduce<addf> %gb, %f0 : vector<4xf32>, f32
  %fs = kernel.subgroup.reduce<addf> %fl {cluster_size = 8} : f32
  %gs = kernel.subgroup.reduce<addf> %gl {cluster_size = 8} : f32
  %ft = scalar.tanhf<afn> %fs : f32
  %gt = scalar.tanhf<afn> %gs : f32
  func.return %ft, %gt : f32, f32
}

// x - tanh(forget z) x + tanh(gain z) m for one element.
func.def public inline @inkling_ctrl_mixed(%ft: f32, %gt: f32, %xe: f32, %me: f32) -> (f32) {
  %fx = scalar.mulf %ft, %xe : f32
  %gm = scalar.mulf %gt, %me : f32
  %d = scalar.subf %xe, %fx : f32
  %y = scalar.addf %d, %gm : f32
  func.return %y : f32
}

// The x and m elements of one (token, row) pair.
func.def public inline @inkling_ctrl_xm(%x: buffer, %m: buffer, %token: index, %o: index, %x_col: index, %m_col: index, %col_stride: index) -> (f32, f32) {
  %embd = index.constant 2304 : index
  %xo_base = index.madd %x_col, %col_stride, %o : index
  %xo = index.madd %token, %embd, %xo_base : index
  %mo_base = index.madd %m_col, %col_stride, %o : index
  %mo = index.madd %token, %embd, %mo_base : index
  %xe = func.call @inkling_ctrl_f32(%x, %xo) : (buffer, index) -> (f32)
  %me = func.call @inkling_ctrl_f32(%m, %mo) : (buffer, index) -> (f32)
  func.return %xe, %me : f32, f32
}

func.def public inline @inkling_ctrl_out(%out: buffer, %c: index, %token: index, %o: index, %col_stride: index, %y: f32) {
  %embd = index.constant 2304 : index
  %oo_base = index.madd %c, %col_stride, %o : index
  %oo = index.madd %token, %embd, %oo_base : index
  func.call @inkling_ctrl_store(%out, %oo, %y) : (buffer, index, f32)
  func.return
}

// One output row and one token: the gates are the dots of the two weight rows (in registers) with the 64 values of z (in LDS), then the element is written.
func.def public inline @inkling_ctrl_row_token(%zlds: buffer, %tb: index, %bankf: vector<16x4xf32>, %bankg: vector<16x4xf32>, %xe: f32, %me: f32, %out: buffer, %c: index, %token: index, %o: index, %col_stride: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %origin = index.constant 0 : offset
  %f0 = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %zv = buffer.view %zlds[%origin] : buffer -> view<4096xf32>
  %tb_base = index.mul %tb, %c64 : index
  %af, %ag = scf.for %j = [%c0 to %c16 step %c1](%pf = %zero4 : vector<4xf32>, %pg = %zero4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) unroll {
    %e = index.madd %j, %c4, %tb_base : index
    %z4 = vector.load %zv[%e] : view<4096xf32> -> vector<4xf32>
    %w_f = vector.extract %bankf[%j] : vector<16x4xf32> -> vector<4xf32>
    %w_g = vector.extract %bankg[%j] : vector<16x4xf32> -> vector<4xf32>
    %nf = vector.fmaf %w_f, %z4, %pf : vector<4xf32>
    %ng = vector.fmaf %w_g, %z4, %pg : vector<4xf32>
    scf.yield %nf, %ng : vector<4xf32>, vector<4xf32>
  }
  %fs = vector.reduce<addf> %af, %f0 : vector<4xf32>, f32
  %gs = vector.reduce<addf> %ag, %f0 : vector<4xf32>, f32
  %ft = scalar.tanhf<afn> %fs : f32
  %gt = scalar.tanhf<afn> %gs : f32
  %y = func.call @inkling_ctrl_mixed(%ft, %gt, %xe, %me) : (f32, f32, f32, f32) -> (f32)
  func.call @inkling_ctrl_out(%out, %c, %token, %o, %col_stride, %y) : (buffer, index, index, index, index, f32)
  func.return
}

// A workgroup owns 256 output rows and a tile of tokens (at most 64). The two weight rows of a thread stay in registers, the z values of the tile are staged in LDS, and every thread walks the tokens: no cross-lane reduction, one tanh pair per element, x, m and the output are read and written in rows of consecutive elements.
kernel.def export("inkling_ctrl_apply") @inkling_ctrl_apply(%cap: index, %nc: index) {
  %one = index.constant 1 : index
  %groups = index.constant 9 : index
  %tokens = config.get @inkling.mix.ctrl_tokens : index
  %cap_up = index.add %cap, %tokens : index
  %cap_dec = index.constant 1 : index
  %cap_m1 = index.sub %cap_up, %cap_dec : index
  %tiles = index.div %cap_m1, %tokens : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %tiles, %nc) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %nc_in: index, %x_col0_in: index, %x_col_step_in: index, %m_col0_in: index, %col_stride_in: index, %spans: buffer, %x: buffer, %m: buffer, %forget0: buffer, %forget1: buffer, %forget2: buffer, %gain0: buffer, %gain1: buffer, %gain2: buffer, %z: buffer, %out: buffer) {
  %x_col0 = index.assume %x_col0_in [range(%x_col0_in, 0, 3)] : index
  %x_col_step = index.assume %x_col_step_in [range(%x_col_step_in, 0, 1)] : index
  %m_col0 = index.assume %m_col0_in [range(%m_col0_in, 0, 3)] : index
  %col_stride = index.assume %col_stride_in [range(%col_stride_in, 0, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %origin = index.constant 0 : offset
  %four = index.constant 4 : offset
  %lds_bytes = index.constant 16384 : offset
  %f0 = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %zero_bank = vector.splatf 0.0 : vector<16x4xf32>
  %tokens = config.get @inkling.mix.ctrl_tokens : index
  %bf16_cfg = config.get @inkling.mix.ctrl_bf16 : index
  %bf16 = index.cmp ne, %bf16_cfg, %c0 : index
  %group = kernel.workgroup.id<x> : index
  %tile = kernel.workgroup.id<y> : index
  %c = kernel.workgroup.id<z> : index
  %tid = kernel.workitem.id<x> : index
  %live = func.call @inkling_ctrl_live(%spans) : (buffer) -> (index)
  %first_token = index.mul %tile, %tokens : index
  %tile_active = index.cmp ult, %first_token, %live : index
  scf.if %tile_active {
    %x_col = index.madd %c, %x_col_step, %x_col0 : index
    %m_col = index.add %m_col0, %c : index
    %o = index.madd %group, %c256, %tid : index
    %row = index.mul %o, %c64 : index
    %forget = func.call @inkling_ctrl_pick(%c, %forget0, %forget1, %forget2) : (index, buffer, buffer, buffer) -> (buffer)
    %gain = func.call @inkling_ctrl_pick(%c, %gain0, %gain1, %gain2) : (index, buffer, buffer, buffer) -> (buffer)
    %bankf = scf.for %j = [%c0 to %c16 step %c1](%b = %zero_bank : vector<16x4xf32>) -> (vector<16x4xf32>) unroll {
      %we = index.madd %j, %c4, %row : index
      %w4 = func.call @inkling_ctrl_weights4(%forget, %we, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
      %bn = vector.insert %w4 into %b[%j] : vector<4xf32>, vector<16x4xf32>
      scf.yield %bn : vector<16x4xf32>
    }
    %bankg = scf.for %j = [%c0 to %c16 step %c1](%b = %zero_bank : vector<16x4xf32>) -> (vector<16x4xf32>) unroll {
      %we = index.madd %j, %c4, %row : index
      %w4 = func.call @inkling_ctrl_weights4(%gain, %we, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
      %bn = vector.insert %w4 into %b[%j] : vector<4xf32>, vector<16x4xf32>
      scf.yield %bn : vector<16x4xf32>
    }
    %z_store = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
    %z_lds = buffer.view %z_store[%origin] : buffer -> view<4096xf32>
    %nvec = index.mul %tokens, %c16 : index
    scf.for %i = [%tid to %nvec step %c256] {
      %tb = index.div %i, %c16 : index
      %q = index.rem %i, %c16 : index
      %token = index.add %first_token, %tb : index
      %in_live = index.cmp ult, %token, %live : index
      %z4 = scf.if %in_live -> (vector<4xf32>) {
        %pc = index.madd %c, %cap_in, %token : index
        %zb = index.mul %pc, %c64 : index
        %z_bytes = index.scale %zb, %four : index, offset -> offset
        %z_view = buffer.view %z[%z_bytes] : buffer -> view<64xf32>
        %qe = index.mul %q, %c4 : index
        %v = vector.load %z_view[%qe] : view<64xf32> -> vector<4xf32>
        scf.yield %v : vector<4xf32>
      } else {
        scf.yield %zero4 : vector<4xf32>
      }
      %le = index.mul %i, %c4 : index
      vector.store %z4, %z_lds[%le] : vector<4xf32>, view<4096xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tokens_up = index.add %tokens, %c3 : index
    %quads = index.div %tokens_up, %c4 : index
    scf.for %g = [%c0 to %quads step %c1] {
      %tb0 = index.mul %g, %c4 : index
      %tb1 = index.add %tb0, %c1 : index
      %tb2 = index.add %tb1, %c1 : index
      %tb3 = index.add %tb2, %c1 : index
      %t0 = index.add %first_token, %tb0 : index
      %t1 = index.add %first_token, %tb1 : index
      %t2 = index.add %first_token, %tb2 : index
      %t3 = index.add %first_token, %tb3 : index
      %i0 = index.cmp ult, %tb0, %tokens : index
      %i1 = index.cmp ult, %tb1, %tokens : index
      %i2 = index.cmp ult, %tb2, %tokens : index
      %i3 = index.cmp ult, %tb3, %tokens : index
      %l0 = index.cmp ult, %t0, %live : index
      %l1 = index.cmp ult, %t1, %live : index
      %l2 = index.cmp ult, %t2, %live : index
      %l3 = index.cmp ult, %t3, %live : index
      %ok0 = scalar.andi %i0, %l0 : i1
      %ok1 = scalar.andi %i1, %l1 : i1
      %ok2 = scalar.andi %i2, %l2 : i1
      %ok3 = scalar.andi %i3, %l3 : i1
      %x0, %m0 = scf.if %ok0 -> (f32, f32) {
        %a, %b = func.call @inkling_ctrl_xm(%x, %m, %t0, %o, %x_col, %m_col, %col_stride) : (buffer, buffer, index, index, index, index, index) -> (f32, f32)
        scf.yield %a, %b : f32, f32
      } else {
        scf.yield %f0, %f0 : f32, f32
      }
      %x1, %m1 = scf.if %ok1 -> (f32, f32) {
        %a, %b = func.call @inkling_ctrl_xm(%x, %m, %t1, %o, %x_col, %m_col, %col_stride) : (buffer, buffer, index, index, index, index, index) -> (f32, f32)
        scf.yield %a, %b : f32, f32
      } else {
        scf.yield %f0, %f0 : f32, f32
      }
      %x2, %m2 = scf.if %ok2 -> (f32, f32) {
        %a, %b = func.call @inkling_ctrl_xm(%x, %m, %t2, %o, %x_col, %m_col, %col_stride) : (buffer, buffer, index, index, index, index, index) -> (f32, f32)
        scf.yield %a, %b : f32, f32
      } else {
        scf.yield %f0, %f0 : f32, f32
      }
      %x3, %m3 = scf.if %ok3 -> (f32, f32) {
        %a, %b = func.call @inkling_ctrl_xm(%x, %m, %t3, %o, %x_col, %m_col, %col_stride) : (buffer, buffer, index, index, index, index, index) -> (f32, f32)
        scf.yield %a, %b : f32, f32
      } else {
        scf.yield %f0, %f0 : f32, f32
      }
      scf.if %ok0 {
        func.call @inkling_ctrl_row_token(%z_store, %tb0, %bankf, %bankg, %x0, %m0, %out, %c, %t0, %o, %col_stride) : (buffer, index, vector<16x4xf32>, vector<16x4xf32>, f32, f32, buffer, index, index, index, index)
      }
      scf.if %ok1 {
        func.call @inkling_ctrl_row_token(%z_store, %tb1, %bankf, %bankg, %x1, %m1, %out, %c, %t1, %o, %col_stride) : (buffer, index, vector<16x4xf32>, vector<16x4xf32>, f32, f32, buffer, index, index, index, index)
      }
      scf.if %ok2 {
        func.call @inkling_ctrl_row_token(%z_store, %tb2, %bankf, %bankg, %x2, %m2, %out, %c, %t2, %o, %col_stride) : (buffer, index, vector<16x4xf32>, vector<16x4xf32>, f32, f32, buffer, index, index, index, index)
      }
      scf.if %ok3 {
        func.call @inkling_ctrl_row_token(%z_store, %tb3, %bankf, %bankg, %x3, %m3, %out, %c, %t3, %o, %col_stride) : (buffer, index, vector<16x4xf32>, vector<16x4xf32>, f32, f32, buffer, index, index, index, index)
      }
    }
  }
  kernel.return
}

// Decode form of ctrl_apply (one token per workgroup): sums the ctrl_down partials into z in the order of ctrl_z, so ctrl_z is not launched.
kernel.def export("inkling_ctrl_apply_z") @inkling_ctrl_apply_z(%cap: index, %nc: index) {
  %one = index.constant 1 : index
  %groups = index.constant 72 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %cap, %nc) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %nc_in: index, %x_col0_in: index, %x_col_step_in: index, %m_col0_in: index, %col_stride_in: index, %spans: buffer, %x: buffer, %m: buffer, %forget0: buffer, %forget1: buffer, %forget2: buffer, %gain0: buffer, %gain1: buffer, %gain2: buffer, %rinv_x: buffer, %rinv_m: buffer, %part: buffer, %out: buffer) {
  %x_col0 = index.assume %x_col0_in [range(%x_col0_in, 0, 3)] : index
  %x_col_step = index.assume %x_col_step_in [range(%x_col_step_in, 0, 1)] : index
  %m_col0 = index.assume %m_col0_in [range(%m_col0_in, 0, 3)] : index
  %col_stride = index.assume %col_stride_in [range(%col_stride_in, 0, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %embd = index.constant 2304 : index
  %full = index.constant 4608 : index
  %origin = index.constant 0 : offset
  %z_bytes = index.constant 256 : offset
  %f0 = scalar.constant 0.0 : f32
  %chunk = config.get @inkling.mix.ctrl_chunk : index
  %bf16_cfg = config.get @inkling.mix.ctrl_bf16 : index
  %bf16 = index.cmp ne, %bf16_cfg, %c0 : index
  %group = kernel.workgroup.id<x> : index
  %token = kernel.workgroup.id<y> : index
  %c = kernel.workgroup.id<z> : index
  %tid = kernel.workitem.id<x> : index
  %live = func.call @inkling_ctrl_live(%spans) : (buffer) -> (index)
  %active = index.cmp ult, %token, %live : index
  scf.if %active {
    %x_col = index.madd %c, %x_col_step, %x_col0 : index
    %m_col = index.add %m_col0, %c : index
    %o_local = index.div %tid, %c8 : index
    %l = index.rem %tid, %c8 : index
    %o = index.madd %group, %c32, %o_local : index
    %zi = index.mul %l, %c8 : index
    %zi1 = index.add %zi, %c4 : index
    %row = index.mul %o, %c64 : index
    %we = index.add %row, %zi : index
    %we1 = index.add %row, %zi1 : index
    %forget = func.call @inkling_ctrl_pick(%c, %forget0, %forget1, %forget2) : (index, buffer, buffer, buffer) -> (buffer)
    %gain = func.call @inkling_ctrl_pick(%c, %gain0, %gain1, %gain2) : (index, buffer, buffer, buffer) -> (buffer)
    %f4a = func.call @inkling_ctrl_weights4(%forget, %we, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
    %f4b = func.call @inkling_ctrl_weights4(%forget, %we1, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
    %g4a = func.call @inkling_ctrl_weights4(%gain, %we, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
    %g4b = func.call @inkling_ctrl_weights4(%gain, %we1, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
    %lane0 = index.cmp eq, %l, %c0 : index
    %xe, %me = scf.if %lane0 -> (f32, f32) {
      %a, %b = func.call @inkling_ctrl_xm(%x, %m, %token, %o, %x_col, %m_col, %col_stride) : (buffer, buffer, index, index, index, index, index) -> (f32, f32)
      scf.yield %a, %b : f32, f32
    } else {
      scf.yield %f0, %f0 : f32, f32
    }
    %z_store = buffer.alloca<workgroup> align(16) %z_bytes : buffer
    %z_lds = buffer.view %z_store[%origin] : buffer -> view<64xf32>
    %is_z = index.cmp ult, %tid, %c64 : index
    scf.if %is_z {
      %rx_i0 = index.madd %x_col, %cap_in, %token : index
      %rm_i0 = index.madd %m_col, %cap_in, %token : index
      %rx_i = index.assume %rx_i0 [range(%rx_i0, 0, 2147483640)] : index
      %rm_i = index.assume %rm_i0 [range(%rm_i0, 0, 2147483640)] : index
      %rx = func.call @inkling_ctrl_f32(%rinv_x, %rx_i) : (buffer, index) -> (f32)
      %rm = func.call @inkling_ctrl_f32(%rinv_m, %rm_i) : (buffer, index) -> (f32)
      %kcs = index.div %full, %chunk : index
      %chunk_x = index.div %embd, %chunk : index
      %pc = index.madd %c, %cap_in, %token : index
      %pk0 = index.mul %pc, %kcs : index
      %zx = scf.for %k = [%c0 to %chunk_x step %c1](%a = %f0 : f32) -> (f32) unroll {
        %pk = index.add %pk0, %k : index
        %pe0 = index.madd %pk, %c64, %tid : index
        %pe = index.assume %pe0 [range(%pe0, 0, 2147483640)] : index
        %p = func.call @inkling_ctrl_f32(%part, %pe) : (buffer, index) -> (f32)
        %s = scalar.addf %a, %p : f32
        scf.yield %s : f32
      }
      %zm = scf.for %k = [%chunk_x to %kcs step %c1](%a = %f0 : f32) -> (f32) unroll {
        %pk = index.add %pk0, %k : index
        %pe0 = index.madd %pk, %c64, %tid : index
        %pe = index.assume %pe0 [range(%pe0, 0, 2147483640)] : index
        %p = func.call @inkling_ctrl_f32(%part, %pe) : (buffer, index) -> (f32)
        %s = scalar.addf %a, %p : f32
        scf.yield %s : f32
      }
      %zx_s = scalar.mulf %zx, %rx : f32
      %z_val = scalar.fmaf %zm, %rm, %zx_s : f32
      view.store %z_val, %z_lds[%tid] : f32, view<64xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %ft, %gt = func.call @inkling_ctrl_gates(%z_store, %c0, %l, %f4a, %f4b, %g4a, %g4b) : (buffer, index, index, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32, f32)
    scf.if %lane0 {
      %y = func.call @inkling_ctrl_mixed(%ft, %gt, %xe, %me) : (f32, f32, f32, f32) -> (f32)
      func.call @inkling_ctrl_out(%out, %c, %token, %o, %col_stride, %y) : (buffer, index, index, index, index, f32)
    }
  }
  kernel.return
}

// Decode form of the message mix plus ctrl_down (one token per workgroup, 288 threads). Workgroups of the x half of the input run as ctrl_down. Workgroups of the m half first build the message column of the controller (the arithmetic of inkling_mix_states with nb 1, mode 0, one query) in LDS; the first of them writes the rms factor of the column, each writes its slice of the column for ctrl_apply_z.
kernel.def export("inkling_ctrl_down_msg") @inkling_ctrl_down_msg(%cap: index, %nc: index) {
  %one = index.constant 1 : index
  %chunk = config.get @inkling.mix.ctrl_chunk : index
  %full = index.constant 4608 : index
  %chunks = index.div %full, %chunk : index
  %threads = index.constant 288 : index
  kernel.launch.config workgroups(%chunks, %cap, %nc) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %nc_in: index, %x_col0_in: index, %x_col_step_in: index, %m_col0_in: index, %col_stride_in: index, %blocks_off: index, %cur_off: index, %spans: buffer, %x: buffer, %bank: buffer, %query: buffer, %down0: buffer, %down1: buffer, %down2: buffer, %msg: buffer, %rinv_m: buffer, %part: buffer) {
  %x_col0 = index.assume %x_col0_in [range(%x_col0_in, 0, 3)] : index
  %x_col_step = index.assume %x_col_step_in [range(%x_col_step_in, 0, 1)] : index
  %m_col0 = index.assume %m_col0_in [range(%m_col0_in, 0, 3)] : index
  %col_stride = index.assume %col_stride_in [range(%col_stride_in, 0, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c9 = index.constant 9 : index
  %c16 = index.constant 16 : index
  %c18 = index.constant 18 : index
  %c32 = index.constant 32 : index
  %c36 = index.constant 36 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %embd = index.constant 2304 : index
  %full = index.constant 4608 : index
  %origin = index.constant 0 : offset
  %four = index.constant 4 : offset
  %lds_bytes = index.constant 11520 : offset
  %f0 = scalar.constant 0.0 : f32
  %eps = scalar.constant 1.0e-6 : f32
  %inv_embd = scalar.constant 4.3402777777777777e-4 : f32
  %inv_scale = scalar.constant 2.0833333333333332e-2 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %chunk = config.get @inkling.mix.ctrl_chunk : index
  %bf16_cfg = config.get @inkling.mix.ctrl_bf16 : index
  %bf16 = index.cmp ne, %bf16_cfg, %c0 : index
  %kc = kernel.workgroup.id<x> : index
  %token = kernel.workgroup.id<y> : index
  %c = kernel.workgroup.id<z> : index
  %tid = kernel.workitem.id<x> : index
  %live = func.call @inkling_ctrl_live(%spans) : (buffer) -> (index)
  %active = index.cmp ult, %token, %live : index
  scf.if %active {
    %wave = index.div %tid, %c32 : index
    %lane = index.rem %tid, %c32 : index
    %chunk_x = index.div %embd, %chunk : index
    %in_x = index.cmp ult, %kc, %chunk_x : index
    %x_col = index.madd %c, %x_col_step, %x_col0 : index
    %m_col = index.add %m_col0, %c : index
    %chunk_start = index.mul %kc, %chunk : index
    %m_rel = index.sub %chunk_start, %embd : index
    %m_start0 = scf.select %in_x, %c0, %m_rel : index
    %m_start = index.assume %m_start0 [range(%m_start0, 0, 2304)] : index
    %down = func.call @inkling_ctrl_pick(%c, %down0, %down1, %down2) : (index, buffer, buffer, buffer) -> (buffer)
    %row_raw = index.div %tid, %c4 : index
    %c63 = index.constant 63 : index
    %row = index.min %row_raw, %c63 : index
    %kl = index.rem %tid, %c4 : index
    %dot_thread = index.cmp ult, %tid, %c256 : index
    %row_base = index.mul %row, %full : index
    %w_base = index.add %row_base, %chunk_start : index
    %nj = index.div %chunk, %c16 : index
    %bank0 = vector.splatf 0.0 : vector<[%nj]x4xf32>
    %wbank = scf.for %j = [%c0 to %nj step %c1](%b = %bank0 : vector<[%nj]x4xf32>) -> (vector<[%nj]x4xf32>) unroll {
      %vec = index.madd %j, %c4, %kl : index
      %e = index.mul %vec, %c4 : index
      %we = index.add %w_base, %e : index
      %w4 = func.call @inkling_ctrl_weights4(%down, %we, %bf16) : (buffer, index, i1) -> (vector<4xf32>)
      %b_next = vector.insert %w4 into %b[%j] : vector<4xf32>, vector<[%nj]x4xf32>
      scf.yield %b_next : vector<[%nj]x4xf32>
    }
    %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
    %lds_view = buffer.view %lds[%origin] : buffer -> view<2880xf32>
    %is_m = index.cmp uge, %kc, %chunk_x : index
    scf.if %is_m {
      %tok_e = index.mul %token, %embd : index
      %state_off0 = index.add %tok_e, %blocks_off : index
      %state_off1 = index.add %tok_e, %cur_off : index
      %wave_s = index.min %wave, %c1 : index
      %is_s1 = index.cmp eq, %wave_s, %c1 : index
      %state_off = scf.select %is_s1, %state_off1, %state_off0 : index
      %state_bytes = index.scale %state_off, %four : index, offset -> offset
      %state_view = buffer.view %bank[%state_bytes] : buffer -> view<2304xf32>
      %q_off = index.mul %m_col, %embd : index
      %qv = buffer.view %query[%origin] : buffer -> view<9216xf32>
      %lane4 = index.mul %lane, %c4 : index
      %wave_base = index.mul %wave, %c256 : index
      %e0_raw = index.add %wave_base, %lane4 : index
      %e0 = index.assume %e0_raw [range(%e0_raw, 0, 2172)] : index
      %e1 = index.add %e0, %c128 : index
      %sv0_bytes = index.scale %state_off0, %four : index, offset -> offset
      %sv1_bytes = index.scale %state_off1, %four : index, offset -> offset
      %sv0 = buffer.view %bank[%sv0_bytes] : buffer -> view<2304xf32>
      %sv1 = buffer.view %bank[%sv1_bytes] : buffer -> view<2304xf32>
      %px00 = vector.load %sv0[%e0] : view<2304xf32> -> vector<4xf32>
      %px01 = vector.load %sv0[%e1] : view<2304xf32> -> vector<4xf32>
      %px10 = vector.load %sv1[%e0] : view<2304xf32> -> vector<4xf32>
      %px11 = vector.load %sv1[%e1] : view<2304xf32> -> vector<4xf32>
      %score_wave = index.cmp ult, %wave, %c2 : index
      scf.if %score_wave {
        %ss, %d0 = scf.for %j = [%c0 to %c18 step %c1](%a = %zero4 : vector<4xf32>, %a0 = %zero4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) unroll {
          %packet = index.madd %j, %c32, %lane : index
          %e_raw = index.mul %packet, %c4 : index
          %e = index.assume %e_raw [range(%e_raw, 0, 2300)] : index
          %xs = vector.load %state_view[%e] : view<2304xf32> -> vector<4xf32>
          %qi_raw = index.add %q_off, %e : index
          %qi = index.assume %qi_raw [range(%qi_raw, 0, 9212)] : index
          %u0 = vector.load %qv[%qi] : view<9216xf32> -> vector<4xf32>
          %a_next = vector.fmaf %xs, %xs, %a : vector<4xf32>
          %n0 = vector.fmaf %xs, %u0, %a0 : vector<4xf32>
          scf.yield %a_next, %n0 : vector<4xf32>, vector<4xf32>
        }
        %ss_lane = vector.reduce<addf> %ss, %f0 : vector<4xf32>, f32
        %sumsq = kernel.subgroup.reduce<addf> %ss_lane {cluster_size = 32} : f32
        %mean = scalar.mulf %sumsq, %inv_embd : f32
        %biased = scalar.addf %mean, %eps : f32
        %rinv = scalar.rsqrtf %biased : f32
        %dot0_lane = vector.reduce<addf> %d0, %f0 : vector<4xf32>, f32
        %dot0 = kernel.subgroup.reduce<addf> %dot0_lane {cluster_size = 32} : f32
        %scale = scalar.mulf %rinv, %inv_scale : f32
        %lane0 = index.cmp eq, %lane, %c0 : index
        scf.if %lane0 {
          %s0 = scalar.mulf %dot0, %scale : f32
          %rslot = index.add %c36, %wave : index
          view.store %s0, %lds_view[%wave] : f32, view<2880xf32>
          view.store %rinv, %lds_view[%rslot] : f32, view<2880xf32>
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %max0, %inv0 = func.call @inkling_mix_softmax(%lds, %c0, %c1) : (buffer, index, index) -> (f32, f32)
      %no = index.constant 0 : index
      %single = index.cmp eq, %no, %c1 : index
      %cw0 = func.call @inkling_mix_coeff(%lds, %c0, %c0, %max0, %inv0, %single) : (buffer, index, index, f32, f32, i1) -> (f32)
      %cw1 = func.call @inkling_mix_coeff(%lds, %c0, %c1, %max0, %inv0, %single) : (buffer, index, index, f32, f32, i1) -> (f32)
      %ya0 = func.call @inkling_mix_axpy(%zero4, %cw0, %px00) : (vector<4xf32>, f32, vector<4xf32>) -> (vector<4xf32>)
      %ya1 = func.call @inkling_mix_axpy(%zero4, %cw0, %px01) : (vector<4xf32>, f32, vector<4xf32>) -> (vector<4xf32>)
      %y0 = func.call @inkling_mix_axpy(%ya0, %cw1, %px10) : (vector<4xf32>, f32, vector<4xf32>) -> (vector<4xf32>)
      %y1 = func.call @inkling_mix_axpy(%ya1, %cw1, %px11) : (vector<4xf32>, f32, vector<4xf32>) -> (vector<4xf32>)
      %yy0 = vector.mulf %y0, %y0 : vector<4xf32>
      %yy1 = vector.fmaf %y1, %y1, %yy0 : vector<4xf32>
      %t0 = vector.reduce<addf> %yy1, %f0 : vector<4xf32>, f32
      %z0 = kernel.subgroup.reduce<addf> %t0 {cluster_size = 32} : f32
      %ya = index.add %c64, %e0 : index
      %yb = index.add %c64, %e1 : index
      vector.store %y0, %lds_view[%ya] : vector<4xf32>, view<2880xf32>
      vector.store %y1, %lds_view[%yb] : vector<4xf32>, view<2880xf32>
      %lane0b = index.cmp eq, %lane, %c0 : index
      scf.if %lane0b {
        %pslot = index.add %c48, %wave : index
        view.store %z0, %lds_view[%pslot] : f32, view<2880xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %first_m = index.cmp eq, %kc, %chunk_x : index
      %t_is0 = index.cmp eq, %tid, %c0 : index
      %write_rinv = scalar.andi %first_m, %t_is0 : i1
      %total = scf.for %w = [%c0 to %c9 step %c1](%t = %f0 : f32) -> (f32) unroll {
        %ps = index.add %c48, %w : index
        %part_s = view.load %lds_view[%ps] : view<2880xf32> -> f32
        %t_next = scalar.addf %t, %part_s : f32
        scf.yield %t_next : f32
      }
      %m = scalar.mulf %total, %inv_embd : f32
      %mb = scalar.addf %m, %eps : f32
      %inv_out = scalar.rsqrtf %mb : f32
      scf.if %write_rinv {
        %cap_q = index.mul %cap_in, %c4 : index
        %rv = buffer.view %rinv_m[%origin] : buffer -> view<[%cap_q]xf32>
        %ri_raw = index.madd %m_col, %cap_in, %token : index
        %ri = index.assume %ri_raw [range(%ri_raw, 0, 2147483640), lt(%ri_raw, %cap_q)] : index
        view.store %inv_out, %rv[%ri] : f32, view<[%cap_q]xf32>
      }
      %slice_vecs = index.div %chunk, %c4 : index
      %slice_thread = index.cmp ult, %tid, %slice_vecs : index
      scf.if %slice_thread {
        %te = index.mul %tid, %c4 : index
        %ls0 = index.add %m_start, %te : index
        %ls_raw = index.add %ls0, %c64 : index
        %ls = index.assume %ls_raw [range(%ls_raw, 0, 2876)] : index
        %v = vector.load %lds_view[%ls] : view<2880xf32> -> vector<4xf32>
        %mo0 = index.madd %m_col, %col_stride, %tok_e : index
        %mo = index.add %mo0, %ls0 : index
        %mb2 = index.scale %mo, %four : index, offset -> offset
        %mv = buffer.view %msg[%mb2] : buffer -> view<4xf32>
        vector.store %v, %mv[%c0] : vector<4xf32>, view<4xf32>
      }
    }
    %col_base = index.mul %x_col, %col_stride : index
    %tok_base = index.madd %token, %embd, %col_base : index
    %x_base = index.add %tok_base, %chunk_start : index
    %l_base = index.add %m_start, %c64 : index
    %sum = scf.if %in_x -> (f32) {
      %in_bytes = index.scale %x_base, %four : index, offset -> offset
      %in_view = buffer.view %x[%in_bytes] : buffer -> view<512xf32>
      %acc = scf.for %j = [%c0 to %nj step %c1](%a = %zero4 : vector<4xf32>) -> (vector<4xf32>) unroll {
        %vec = index.madd %j, %c4, %kl : index
        %e = index.mul %vec, %c4 : index
        %xv = vector.load %in_view[%e] : view<512xf32> -> vector<4xf32>
        %w4 = vector.extract %wbank[%j] : vector<[%nj]x4xf32> -> vector<4xf32>
        %s = vector.fmaf %w4, %xv, %a : vector<4xf32>
        scf.yield %s : vector<4xf32>
      }
      %lane_sum = vector.reduce<addf> %acc, %f0 : vector<4xf32>, f32
      %r = kernel.subgroup.reduce<addf> %lane_sum {cluster_size = 4} : f32
      scf.yield %r : f32
    } else {
      %in_bytes = index.scale %l_base, %four : index, offset -> offset
      %in_view = buffer.view %lds[%in_bytes] : buffer -> view<512xf32>
      %acc = scf.for %j = [%c0 to %nj step %c1](%a = %zero4 : vector<4xf32>) -> (vector<4xf32>) unroll {
        %vec = index.madd %j, %c4, %kl : index
        %e = index.mul %vec, %c4 : index
        %xv = vector.load %in_view[%e] : view<512xf32> -> vector<4xf32>
        %w4 = vector.extract %wbank[%j] : vector<[%nj]x4xf32> -> vector<4xf32>
        %s = vector.fmaf %w4, %xv, %a : vector<4xf32>
        scf.yield %s : vector<4xf32>
      }
      %lane_sum = vector.reduce<addf> %acc, %f0 : vector<4xf32>, f32
      %r = kernel.subgroup.reduce<addf> %lane_sum {cluster_size = 4} : f32
      scf.yield %r : f32
    }
    %writer0 = index.cmp eq, %kl, %c0 : index
    %writer = scalar.andi %writer0, %dot_thread : i1
    scf.if %writer {
      %kcs = index.div %full, %chunk : index
      %pc = index.madd %c, %cap_in, %token : index
      %pk = index.madd %pc, %kcs, %kc : index
      %pe0 = index.madd %pk, %c64, %row : index
      %pe = index.assume %pe0 [range(%pe0, 0, 2147483640)] : index
      func.call @inkling_ctrl_store(%part, %pe, %sum) : (buffer, index, f32)
    }
  }
  kernel.return
}

kernel.def export("inkling_mix_norm") @inkling_mix_norm(%cap: index, %nc: index) {
  %one = index.constant 1 : index
  %threads = index.constant 192 : index
  kernel.launch.config workgroups(%cap, %nc, %one) workgroup_size(%threads, %one, %one) : index
} launch(%cap_in: index, %nc_in: index, %col_stride_in: index, %w_stride_in: index, %spans: buffer, %x: buffer, %w: buffer, %out: buffer) {
  %col_stride = index.assume %col_stride_in [range(%col_stride_in, 0, 2147483647)] : index
  %w_stride = index.assume %w_stride_in [range(%w_stride_in, 0, 2304)] : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c192 = index.constant 192 : index
  %embd = index.constant 2304 : index
  %four = index.constant 4 : offset
  %f0 = scalar.constant 0.0 : f32
  %eps = scalar.constant 1.0e-6 : f32
  %inv_embd = scalar.constant 4.3402777777777777e-4 : f32
  %token = kernel.workgroup.id<x> : index
  %col = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %live = func.call @inkling_ctrl_live(%spans) : (buffer) -> (index)
  %active = index.cmp ult, %token, %live : index
  scf.if %active {
    %base_e = index.mul %col, %col_stride : index
    %base = index.madd %token, %embd, %base_e : index
    %base_b = index.scale %base, %four : index, offset -> offset
    %xv = buffer.view %x[%base_b] : buffer -> view<2304xf32>
    %wo = index.mul %col, %w_stride : index
    %wo_b = index.scale %wo, %four : index, offset -> offset
    %wv = buffer.view %w[%wo_b] : buffer -> view<2304xf32>
    %ov = buffer.view %out[%base_b] : buffer -> view<2304xf32>
    %e0 = index.mul %tid, %c4 : index
    %e1 = index.madd %c192, %c4, %e0 : index
    %e2 = index.madd %c192, %c4, %e1 : index
    %x0 = vector.load %xv[%e0] : view<2304xf32> -> vector<4xf32>
    %x1 = vector.load %xv[%e1] : view<2304xf32> -> vector<4xf32>
    %x2 = vector.load %xv[%e2] : view<2304xf32> -> vector<4xf32>
    %s0 = vector.mulf %x0, %x0 : vector<4xf32>
    %s1 = vector.fmaf %x1, %x1, %s0 : vector<4xf32>
    %s2 = vector.fmaf %x2, %x2, %s1 : vector<4xf32>
    %lane = vector.reduce<addf> %s2, %f0 : vector<4xf32>, f32
    %total = kernel.workgroup.reduce<addf> %lane : f32
    %mean = scalar.mulf %total, %inv_embd : f32
    %biased = scalar.addf %mean, %eps : f32
    %r = scalar.rsqrtf %biased : f32
    %r4 = vector.splat %r : vector<4xf32>
    %w0 = vector.load %wv[%e0] : view<2304xf32> -> vector<4xf32>
    %w1 = vector.load %wv[%e1] : view<2304xf32> -> vector<4xf32>
    %w2 = vector.load %wv[%e2] : view<2304xf32> -> vector<4xf32>
    %y0 = vector.mulf %x0, %r4 : vector<4xf32>
    %y1 = vector.mulf %x1, %r4 : vector<4xf32>
    %y2 = vector.mulf %x2, %r4 : vector<4xf32>
    %z0 = vector.mulf %y0, %w0 : vector<4xf32>
    %z1 = vector.mulf %y1, %w1 : vector<4xf32>
    %z2 = vector.mulf %y2, %w2 : vector<4xf32>
    vector.store %z0, %ov[%e0] : vector<4xf32>, view<2304xf32>
    vector.store %z1, %ov[%e1] : vector<4xf32>, view<2304xf32>
    vector.store %z2, %ov[%e2] : vector<4xf32>, view<2304xf32>
  }
  kernel.return
}
