        %lb = vector.load %nw[%wi1] : view<9216xf32> -> vector<4xf32>
        scf.yield %la, %lb : vector<4xf32>, vector<4xf32>
      }
      %sa = vector.mulf %y_a, %factor4 : vector<4xf32>
      %sb = vector.mulf %y_b, %factor4 : vector<4xf32>
      %fa = vector.mulf %sa, %w_a : vector<4xf32>
      %fb = vector.mulf %sb, %w_b : vector<4xf32>
      %ra = scf.select %raw, %sa, %fa : vector<4xf32>
      %rb = scf.select %raw, %sb, %fb : vector<4xf32>
      %col_off0 = index.madd %q, %col_stride, %token_off : index
      %col_off = index.add %col_off0, %out_off : index
      %col_bytes = index.scale %col_off, %four : index, offset -> offset
      %ov = buffer.view %out[%col_bytes] : buffer -> view<2304xf32>
      vector.store %ra, %ov[%e0] : vector<4xf32>, view<2304xf32>
      vector.store %rb, %ov[%e1] : vector<4xf32>, view<2304xf32>
      %write_rinv = index.cmp eq, %tid, %c0 : index
      %need_rinv = scalar.andi %write_rinv, %raw : i1
      scf.if %need_rinv {
        %ri_raw = index.madd %q, %cap_in, %token : index
        %ri = index.assume %ri_raw [range(%ri_raw, 0, 2147483640), lt(%ri_raw, %cap_q)] : index
        view.store %inv_out, %rv[%ri] : f32, view<[%cap_q]xf32>
      }
    }
  }
  %is_commit = index.cmp uge, %token, %cap_in : index
  scf.if %is_commit {
    %commit_site = index.assume %commit_site_in [range(%commit_site_in, 0, 6656)] : index
    %commit_visit = index.assume %commit_visit_in [range(%commit_visit_in, 0, 2147483647)] : index
    %item = index.sub %token, %cap_in : index
    %commit_span = index.div %item, %c9 : index
    %commit_group = index.rem %item, %c9 : index
    %commit_c = index.madd %commit_group, %c256, %tid : index
    %commit_lane = index.cmp ult, %tid, %c256 : index
    scf.if %commit_lane {
      func.call @inkling_conv_commit_item(%spans, %commit_state, %commit_a, %commit_site, %commit_visit, %commit_span, %commit_c) : (buffer, buffer, buffer, index, index, index, index)
    }
  }
  kernel.return
}
