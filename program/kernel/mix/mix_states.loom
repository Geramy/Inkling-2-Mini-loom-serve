// Attention-residual mix: states are blocks[0..nb) and cur. One workgroup per token.

func.decl @inkling_conv_commit_item(%spans: buffer, %state: buffer, %a: buffer, %site: index, %visit: index, %span: index, %c: index)

func.def public inline @inkling_mix_load(%blocks: buffer, %cur: buffer, %s: index, %nb: index, %token: index, %block_stride: index, %blocks_off: index, %cur_off: index, %e: index) -> (vector<4xf32>) {
  %four = index.constant 4 : offset
  %embd = index.constant 2304 : index
  %is_cur = index.cmp eq, %s, %nb : index
  %token_off = index.mul %token, %embd : index
  %block_off0 = index.madd %s, %block_stride, %token_off : index
  %block_off = index.add %block_off0, %blocks_off : index
  %cur_at = index.add %token_off, %cur_off : index
  %token_bytes = index.scale %cur_at, %four : index, offset -> offset
  %block_bytes = index.scale %block_off, %four : index, offset -> offset
  %x = scf.if %is_cur -> (vector<4xf32>) {
    %view = buffer.view %cur[%token_bytes] : buffer -> view<2304xf32>
    %v = vector.load %view[%e] : view<2304xf32> -> vector<4xf32>
    scf.yield %v : vector<4xf32>
  } else {
    %view = buffer.view %blocks[%block_bytes] : buffer -> view<2304xf32>
    %v = vector.load %view[%e] : view<2304xf32> -> vector<4xf32>
    scf.yield %v : vector<4xf32>
  }
  func.return %x : vector<4xf32>
}

func.def public inline @inkling_mix_lds(%lds: buffer, %slot: index) -> (f32) {
  %zero = index.constant 0 : offset
  %view = buffer.view %lds[%zero] : buffer -> view<96xf32>
  %v = view.load %view[%slot] : view<96xf32> -> f32
  func.return %v : f32
}

func.def public inline @inkling_mix_coeff(%lds: buffer, %q: index, %s: index, %max_q: f32, %inv_q: f32, %single: i1) -> (f32) {
  %c9 = index.constant 9 : index
  %c36 = index.constant 36 : index
  %one = scalar.constant 1.0 : f32
  %row = index.madd %q, %c9, %s : index
  %score = func.call @inkling_mix_lds(%lds, %row) : (buffer, index) -> (f32)
  %rslot = index.add %c36, %s : index
  %rinv = func.call @inkling_mix_lds(%lds, %rslot) : (buffer, index) -> (f32)
  %shifted = scalar.subf %score, %max_q : f32
  %e = scalar.expf<afn> %shifted : f32
  %p = scalar.mulf %e, %inv_q : f32
  %w = scalar.mulf %p, %rinv : f32
  %c = scf.select %single, %one, %w : f32
  func.return %c : f32
}

func.def public inline @inkling_mix_softmax(%lds: buffer, %q: index, %nb: index) -> (f32, f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c9 = index.constant 9 : index
  %low = scalar.constant -1.0e30 : f32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %count = index.add %nb, %c1 : index
  %max_q = scf.for %s = [%c0 to %count step %c1](%m = %low : f32) -> (f32) {
    %row = index.madd %q, %c9, %s : index
    %score = func.call @inkling_mix_lds(%lds, %row) : (buffer, index) -> (f32)
    %next = scalar.maxnumf %m, %score : f32
    scf.yield %next : f32
  }
  %denom = scf.for %s = [%c0 to %count step %c1](%d = %zero : f32) -> (f32) {
    %row = index.madd %q, %c9, %s : index
    %score = func.call @inkling_mix_lds(%lds, %row) : (buffer, index) -> (f32)
    %shifted = scalar.subf %score, %max_q : f32
    %e = scalar.expf<afn> %shifted : f32
    %next = scalar.addf %d, %e : f32
    scf.yield %next : f32
  }
  %inv = scalar.divf %one, %denom : f32
  func.return %max_q, %inv : f32, f32
}

func.def public inline @inkling_mix_axpy(%acc: vector<4xf32>, %c: f32, %x: vector<4xf32>) -> (vector<4xf32>) {
  %cv = vector.splat %c : vector<4xf32>
  %r = vector.fmaf %cv, %x, %acc : vector<4xf32>
  func.return %r : vector<4xf32>
}

kernel.def export("inkling_mix_states") @inkling_mix_states(%cap: index, %ncommit: index, %nq: index) {
