// Staging of one K block (64 elements) into workgroup memory for the matrix-operation expert kernels. Stage rows have a pitch of 72 f16.

func.decl @inkling_experts_unit_f16(%wtype: index, %w: buffer, %row: offset, %units: index, %unit: index) -> (vector<16xf16>)

// Decodes the 4 units of K block kb of one weight row into stage row `stage_row`.
func.def public inline @inkling_experts_stage_w(%wtype: index, %w: buffer, %row_byte: offset, %row_units: index, %kb: index, %w_stage: buffer, %stage_row: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %origin = index.constant 0 : offset
  %ws = buffer.view %w_stage[%origin] : buffer -> view<128x72xf16>
  %row = index.assume %stage_row [ge(%stage_row, 0), lt(%stage_row, 128)] : index
  %first = index.mul %kb, %c4 : index
  scf.for %j = [%c0 to %c4 step %c1] unroll schedule(linear) {
    %unit = index.add %first, %j : index
    %v = func.call @inkling_experts_unit_f16(%wtype, %w, %row_byte, %row_units, %unit) : (index, buffer, offset, index, index) -> (vector<16xf16>)
    %col_raw = index.mul %j, %c16 : index
    %col = index.assume %col_raw [ge(%col_raw, 0), le(%col_raw, 48)] : index
    vector.store %v, %ws[%row, %col] : vector<16xf16>, view<128x72xf16>
  }
  func.return
}

// Copies 16 f16 values (part p of K block kb) of row `src_row` of a [rows][cols] f16 matrix into x stage row `stage_row`.
func.def public inline @inkling_experts_stage_x(%src: buffer, %rows: index, %cols: index, %src_row: index, %kb: index, %part: index, %x_stage: buffer, %stage_row: index) {
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %origin = index.constant 0 : offset
  %xs = buffer.view %x_stage[%origin] : buffer -> view<64x72xf16>
  %sv = buffer.view %src[%origin] : buffer -> view<[%rows]x[%cols]xf16>
  %row = index.assume %stage_row [ge(%stage_row, 0), lt(%stage_row, 64)] : index
  %r = index.assume %src_row [ge(%src_row, 0), lt(%src_row, %rows)] : index
  %k0 = index.mul %kb, %c64 : index
  %p16 = index.mul %part, %c16 : index
  %scol_raw = index.add %k0, %p16 : index
  %cm16 = index.sub %cols, %c16 : index
  %scol = index.assume %scol_raw [ge(%scol_raw, 0), le(%scol_raw, %cm16)] : index
  %dcol = index.assume %p16 [ge(%p16, 0), le(%p16, 48)] : index
  %v = vector.load %sv[%r, %scol] : view<[%rows]x[%cols]xf16> -> vector<16xf16>
  vector.store %v, %xs[%row, %dcol] : vector<16xf16>, view<64x72xf16>
  func.return
}

func.decl @inkling_nvfp4_unit_decode(%scales: i32, %v0: i32, %v1: i32, %unit: index) -> (vector<16xf16>, f32)

// NVFP4 matrix path: the nine words of K block kb of one weight row (scale word, then eight code words), loaded without a decode so that the next block can be loaded before the current one is used.
func.def public inline @inkling_experts_w_raw(%w: buffer, %row_byte: offset, %row_units: index, %kb: index) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %words = index.mul %row_units, %c9 : index
  %nwords = index.div %words, %c4 : index
  %view = buffer.view %w[%row_byte] : buffer -> view<[%nwords]xi32>
  %w9 = index.mul %kb, %c9 : index
  %i1 = index.add %w9, %c1 : index
  %i2 = index.add %w9, %c2 : index
  %i3 = index.add %w9, %c3 : index
  %i4 = index.add %w9, %c4 : index
  %i5 = index.add %w9, %c5 : index
  %i6 = index.add %w9, %c6 : index
  %i7 = index.add %w9, %c7 : index
  %i8 = index.add %w9, %c8 : index
  %r0 = view.load %view[%w9] : view<[%nwords]xi32> -> i32
  %r1 = view.load %view[%i1] : view<[%nwords]xi32> -> i32
  %r2 = view.load %view[%i2] : view<[%nwords]xi32> -> i32
  %r3 = view.load %view[%i3] : view<[%nwords]xi32> -> i32
  %r4 = view.load %view[%i4] : view<[%nwords]xi32> -> i32
  %r5 = view.load %view[%i5] : view<[%nwords]xi32> -> i32
  %r6 = view.load %view[%i6] : view<[%nwords]xi32> -> i32
  %r7 = view.load %view[%i7] : view<[%nwords]xi32> -> i32
  %r8 = view.load %view[%i8] : view<[%nwords]xi32> -> i32
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8 : i32, i32, i32, i32, i32, i32, i32, i32, i32
}

// One unit of the matrix path in f16 (same arithmetic as inkling_experts_unit_f16 for NVFP4).
func.def public inline @inkling_experts_unit_f16_fp4(%scales: i32, %v0: i32, %v1: i32, %unit: index) -> (vector<16xf16>) {
  %codes, %scale = func.call @inkling_nvfp4_unit_decode(%scales, %v0, %v1, %unit) : (i32, i32, i32, index) -> (vector<16xf16>, f32)
  %pre32 = scalar.constant 16384.0 : f32
  %inv32 = scalar.constant 6.103515625e-05 : f32
  %pre16 = scalar.fptrunc %pre32 : f32 to f16
  %fac = scalar.mulf %scale, %inv32 : f32
  %fac16 = scalar.fptrunc %fac : f32 to f16
  %pre_v = vector.splat %pre16 : vector<16xf16>
  %fac_v = vector.splat %fac16 : vector<16xf16>
  %real = vector.mulf %codes, %pre_v : vector<16xf16>
  %result = vector.mulf %real, %fac_v : vector<16xf16>
  func.return %result : vector<16xf16>
}

// Decodes the loaded block words of one weight row into stage row `stage_row`.
func.def public inline @inkling_experts_stage_w_fp4(%r0: i32, %r1: i32, %r2: i32, %r3: i32, %r4: i32, %r5: i32, %r6: i32, %r7: i32, %r8: i32, %w_stage: buffer, %stage_row: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %origin = index.constant 0 : offset
  %ws = buffer.view %w_stage[%origin] : buffer -> view<128x72xf16>
  %row = index.assume %stage_row [ge(%stage_row, 0), lt(%stage_row, 128)] : index
  %u0 = func.call @inkling_experts_unit_f16_fp4(%r0, %r1, %r2, %c0) : (i32, i32, i32, index) -> (vector<16xf16>)
  %u1 = func.call @inkling_experts_unit_f16_fp4(%r0, %r3, %r4, %c1) : (i32, i32, i32, index) -> (vector<16xf16>)
  %u2 = func.call @inkling_experts_unit_f16_fp4(%r0, %r5, %r6, %c2) : (i32, i32, i32, index) -> (vector<16xf16>)
  %u3 = func.call @inkling_experts_unit_f16_fp4(%r0, %r7, %r8, %c3) : (i32, i32, i32, index) -> (vector<16xf16>)
  vector.store %u0, %ws[%row, %c0] : vector<16xf16>, view<128x72xf16>
  vector.store %u1, %ws[%row, %c16] : vector<16xf16>, view<128x72xf16>
  vector.store %u2, %ws[%row, %c32] : vector<16xf16>, view<128x72xf16>
  vector.store %u3, %ws[%row, %c48] : vector<16xf16>, view<128x72xf16>
  func.return
}

// Loads 16 f16 values (part p of K block kb) of row `src_row` of a [rows][cols] f16 matrix. The row must be valid.
func.def public inline @inkling_experts_x_load(%src: buffer, %rows: index, %cols: index, %src_row: index, %kb: index, %part: index) -> (vector<16xf16>) {
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %origin = index.constant 0 : offset
  %sv = buffer.view %src[%origin] : buffer -> view<[%rows]x[%cols]xf16>
  %r = index.assume %src_row [ge(%src_row, 0), lt(%src_row, %rows)] : index
  %k0 = index.mul %kb, %c64 : index
  %p16 = index.mul %part, %c16 : index
  %scol_raw = index.add %k0, %p16 : index
  %cm16 = index.sub %cols, %c16 : index
  %scol = index.assume %scol_raw [ge(%scol_raw, 0), le(%scol_raw, %cm16)] : index
  %v = vector.load %sv[%r, %scol] : view<[%rows]x[%cols]xf16> -> vector<16xf16>
  func.return %v : vector<16xf16>
}

func.def public inline @inkling_experts_x_store(%v: vector<16xf16>, %x_stage: buffer, %stage_row: index, %part: index) {
  %c16 = index.constant 16 : index
  %origin = index.constant 0 : offset
  %xs = buffer.view %x_stage[%origin] : buffer -> view<64x72xf16>
  %row = index.assume %stage_row [ge(%stage_row, 0), lt(%stage_row, 64)] : index
  %p16 = index.mul %part, %c16 : index
  %dcol = index.assume %p16 [ge(%p16, 0), le(%p16, 48)] : index
  vector.store %v, %xs[%row, %dcol] : vector<16xf16>, view<64x72xf16>
  func.return
}
