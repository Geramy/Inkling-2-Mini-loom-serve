// NVFP4 (ggml type 40): 36 B per 64 elements. Bytes 0..3 are four UE4M3 scales, bytes 4..35 are E2M1 nibbles.
// Sub-block s (16 elements) owns qs bytes 8s..8s+7: low nibble j is element j, high nibble j is element 8+j.
// The decoded unit is 16 elements. Operand pairs are ordered as in inkling_x_slot (experts_common.loom).

// UE4M3 scale of one sub-block. Code 0x7F is zero. The f16 value built from a code is real/2^14.
func.def public inline @inkling_nvfp4_scale(%word: i32, %sub: index) -> (f32) {
  %s = index.cast %sub : index to i32
  %c3 = scalar.constant 3 : i32
  %c127 = scalar.constant 127 : i32
  %shift = scalar.shli %s, %c3 : i32
  %moved = scalar.shrui %word, %shift : i32
  %byte = scalar.andi %moved, %c127 : i32
  %b8 = scalar.trunci %byte : i32 to i8
  %f8 = scalar.bitcast %b8 : i8 to f8E4M3
  %raw = scalar.extf %f8 : f8E4M3 to f32
  %zero = scalar.constant 0.0 : f32
  %nan = scalar.cmpi eq, %byte, %c127 : i32
  %clean = scf.select %nan, %zero, %raw : f32
  func.return %clean : f32
}

// Nibble pair k of word w: nibbles k and k+4 become two f16 codes (sign, 3 magnitude bits shifted into the f16 exponent and mantissa).
func.def public inline @inkling_nvfp4_pair(%w: i32, %k: i32) -> (i32) {
  %c2 = scalar.constant 2 : i32
  %c9 = scalar.constant 9 : i32
  %c12 = scalar.constant 12 : i32
  %mag_mask = scalar.constant 458759 : i32
  %sgn_mask = scalar.constant 524296 : i32
  %k4 = scalar.shli %k, %c2 : i32
  %mm = scalar.shli %mag_mask, %k4 : i32
  %sm = scalar.shli %sgn_mask, %k4 : i32
  %mag = scalar.andi %w, %mm : i32
  %sgn = scalar.andi %w, %sm : i32
  %mag_low = scalar.shrui %mag, %k4 : i32
  %sgn_low = scalar.shrui %sgn, %k4 : i32
  %mag_f = scalar.shli %mag_low, %c9 : i32
  %sgn_f = scalar.shli %sgn_low, %c12 : i32
  %pair = scalar.ori %mag_f, %sgn_f : i32
  func.return %pair : i32
}

// Eight f16x2 words of one unit: words 0..3 come from w0 (bytes 0..3), words 4..7 from w1.
func.def public inline @inkling_nvfp4_codes(%w0: i32, %w1: i32) -> (vector<16xf16>) {
  %k0 = scalar.constant 0 : i32
  %k1 = scalar.constant 1 : i32
  %k2 = scalar.constant 2 : i32
  %k3 = scalar.constant 3 : i32
  %a0 = func.call @inkling_nvfp4_pair(%w0, %k0) : (i32, i32) -> (i32)
  %a1 = func.call @inkling_nvfp4_pair(%w0, %k1) : (i32, i32) -> (i32)
  %a2 = func.call @inkling_nvfp4_pair(%w0, %k2) : (i32, i32) -> (i32)
  %a3 = func.call @inkling_nvfp4_pair(%w0, %k3) : (i32, i32) -> (i32)
  %b0 = func.call @inkling_nvfp4_pair(%w1, %k0) : (i32, i32) -> (i32)
  %b1 = func.call @inkling_nvfp4_pair(%w1, %k1) : (i32, i32) -> (i32)
  %b2 = func.call @inkling_nvfp4_pair(%w1, %k2) : (i32, i32) -> (i32)
  %b3 = func.call @inkling_nvfp4_pair(%w1, %k3) : (i32, i32) -> (i32)
  %words = vector.from_elements %a0, %a1, %a2, %a3, %b0, %b1, %b2, %b3 : vector<8xi32>
  %codes = vector.bitcast %words : vector<8xi32> to vector<16xf16>
  func.return %codes : vector<16xf16>
}
