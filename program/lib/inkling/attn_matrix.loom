// F16 16x16 matrix tiles for the attention kernels. Adapted from the MIT licensed hrx-loom-library motif/tensor/matrix.loom.
// The RDNA3 operand carrier is replicated (16 elements); other targets use compact operands (256 / subgroup size).

target.decl @inkling_attn_rdna3

template.decl @inkling.attn.mma.operand_elements() -> (index)

template.def<@inkling.attn.mma.operand_elements> @inkling_attn_mma_operand_elements() -> (index) {
  %tile_elements = index.constant 256 : index
  %subgroup_size = target.subgroup.size : index
  %elements = index.div %tile_elements, %subgroup_size : index
  template.return %elements : index
}

template.def<@inkling.attn.mma.operand_elements> target(@inkling_attn_rdna3) priority(1) @inkling_attn_mma_operand_elements_rdna3() -> (index) {
  %elements = index.constant 16 : index
  template.return %elements : index
}

template.decl @inkling.attn.mma.accumulate(%accumulator_elements: index, %reduction_size: index, %left_columns: index, %left_layout: encoding<layout>, %left: buffer, %right_rows: index, %right_columns: index, %right: buffer, %right_row: index, %right_column: index, %initial: vector<[%accumulator_elements]xf32>) -> (vector<[%accumulator_elements]xf32>)

template.def<@inkling.attn.mma.accumulate> @inkling_attn_mma_accumulate(%accumulator_elements: index, %reduction_size: index, %left_columns: index, %left_layout: encoding<layout>, %left: buffer, %right_rows: index, %right_columns: index, %right: buffer, %right_row: index, %right_column: index, %initial: vector<[%accumulator_elements]xf32>) -> (vector<[%accumulator_elements]xf32>) {
  %operand_elements = template.apply<@inkling.attn.mma.operand_elements>() : () -> (index)
  %origin = index.constant 0 : offset
  %left_view = buffer.view %left[%origin] : buffer -> view<16x[%left_columns]xf16, %left_layout>
  %right_view = buffer.view %right[%origin] : buffer -> view<[%right_rows]x[%right_columns]xf16>
  %begin = index.constant 0 : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %last_tile_start = index.sub %right_rows, %padding : index
  %product = scf.for %reduction = [%begin to %reduction_size step %tile](%accumulator = %initial : vector<[%accumulator_elements]xf32>) -> (vector<[%accumulator_elements]xf32>) unroll schedule(recurrence) {
    %row_value = index.add %right_row, %reduction : index
    %row = index.assume %row_value [lt(%row_value, %last_tile_start)] : index
    %left_fragment = vector.fragment.load<lhs> %left_view[%begin, %reduction] shape [%tile, %tile] : view<16x[%left_columns]xf16, %left_layout> -> vector<[%operand_elements]xf16>
    %right_fragment = vector.fragment.load<rhs> %right_view[%row, %right_column] shape [%tile, %tile] : view<[%right_rows]x[%right_columns]xf16> -> vector<[%operand_elements]xf16>
    %next = vector.mma %left_fragment, %right_fragment, %accumulator : vector<[%operand_elements]xf16>, vector<[%operand_elements]xf16>, vector<[%accumulator_elements]xf32>
    scf.yield %next : vector<[%accumulator_elements]xf32>
  }
  template.return %product : vector<[%accumulator_elements]xf32>
}
