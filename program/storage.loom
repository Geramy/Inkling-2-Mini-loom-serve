config.decl @inkling.capture_width : %value: index where [range(%value, 1, 1048576)]

func.decl @inkling_packet_bytes(%capacity: index) -> (offset)

func.decl @inkling_feedback_bank_bytes(%capacity: index) -> (offset)

func.decl @inkling.allocation(%records: buffer, %slot: index, %bytes: i64, %initial_zero_bytes: i64)

func.decl @inkling.row_view(%records: buffer, %row_count: index, %row: index, %slot: index, %offset: i64, %length: i64)

// Arena: pooled global KV planes, then one private slot per row (control, recurrent region, token view, progress).
// Recurrent region: local ring of 40 visits (4096 B per entry, 1024 entries), then the conv state of 48 visits at ring_bytes + visit * 79872.
func.def public @inkling.storage(%packet_capacity_arg: i64, %context: i64, %pool: i64, %rows_arg: i64, %pins: i64) -> (buffer, buffer, buffer, buffer, buffer) {
  %packet_capacity = scalar.assume %packet_capacity_arg [range(%packet_capacity_arg, 2, 2147483646)] : i64
  %rows = scalar.assume %rows_arg [range(%rows_arg, 1, 2147483647)] : i64
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c11 = index.constant 11 : index
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %zero32 = scalar.constant 0 : i32
  %word_bytes = scalar.constant 4 : i64
  %block_tokens = scalar.constant 64 : i64
  %origin_stride = scalar.constant 40 : i64
  %origin_bytes = scalar.muli %rows, %origin_stride : i64
  %kv_token_bytes = scalar.constant 32768 : i64
  %page_bytes = scalar.constant 262144 : i64
  %planes = scalar.constant 8 : i64
  %plane_token_bytes = scalar.constant 4096 : i64
  %control_bytes = scalar.constant 12 : i64
  %recurrent_origin = scalar.constant 256 : i64
  %recurrent_bytes = scalar.constant 171606016 : i64
  %token_bytes = scalar.constant 2048 : i64
  %progress_bytes = scalar.constant 32 : i64
  %progress_extent = scalar.constant 256 : i64
  %tokens_offset = scalar.addi %recurrent_origin, %recurrent_bytes : i64
  %progress_offset = scalar.addi %tokens_offset, %token_bytes : i64
  %row_stride = scalar.addi %progress_offset, %progress_extent : i64
  %has_pins = scalar.cmpi ne, %pins, %zero64 : i64
  %owners = scalar.addi %rows, %pins : i64
  %with_writers = scalar.addi %owners, %rows : i64
  %slot_count = scf.select %has_pins, %with_writers, %rows : i64
  %private_bytes = scalar.muli %row_stride, %slot_count : i64
  %pool_bytes = scalar.muli %pool, %kv_token_bytes : i64
  %arena_bytes = scalar.addi %private_bytes, %pool_bytes : i64
  %c63 = scalar.constant 63 : i64
  %padded_context = scalar.addi %context, %c63 : i64
  %blocks_per_row = scalar.divui %padded_context, %block_tokens : i64
  %map_entries = scalar.muli %blocks_per_row, %rows : i64
  %map_bytes = scalar.muli %map_entries, %word_bytes : i64
  %table_bytes = scalar.addi %origin_bytes, %map_bytes : i64
  %packet_count = index.cast %packet_capacity : i64 to index
  %packet_extent = func.call @inkling_packet_bytes(%packet_count) : (index) -> (offset)
  %metadata_bytes = index.cast %packet_extent : offset to i64
  %two_plane_stride = scalar.constant 8 : i64
  %cohort_token_bytes = scalar.muli %packet_capacity, %two_plane_stride : i64
  %output_bytes = scalar.muli %packet_capacity, %word_bytes : i64
  %capture_width = config.get @inkling.capture_width : index
  %width64 = index.cast %capture_width : index to i64
  %row_capture_bytes = scalar.muli %width64, %word_bytes : i64
  %residual_bytes = scalar.muli %packet_capacity, %row_capture_bytes : i64
  %allocation_bytes = index.constant 264 : offset
  %allocations = buffer.alloca<private> align(8) %allocation_bytes : buffer
  scf.for %slot = [%c0 to %c11 step %c1] {
    func.call @inkling.allocation(%allocations, %slot, %zero64, %zero64) : (buffer, index, i64, i64)
  }
  func.call @inkling.allocation(%allocations, %c0, %residual_bytes, %residual_bytes) : (buffer, index, i64, i64)
  func.call @inkling.allocation(%allocations, %c1, %arena_bytes, %zero64) : (buffer, index, i64, i64)
  func.call @inkling.allocation(%allocations, %c2, %metadata_bytes, %zero64) : (buffer, index, i64, i64)
  func.call @inkling.allocation(%allocations, %c3, %table_bytes, %zero64) : (buffer, index, i64, i64)
  func.call @inkling.allocation(%allocations, %c4, %cohort_token_bytes, %zero64) : (buffer, index, i64, i64)
  func.call @inkling.allocation(%allocations, %c5, %output_bytes, %zero64) : (buffer, index, i64, i64)
  %row_count = index.cast %rows : i64 to index
  %view_stride = index.constant 64 : offset
  %view_bytes = index.scale %row_count, %view_stride : index, offset -> offset
  %views = buffer.alloca<private> align(8) %view_bytes : buffer
  %table_payload_bytes = index.cast %origin_bytes : i64 to offset
  %origins = buffer.alloca<private> align(8) %table_payload_bytes : buffer
  buffer.fill %zero32, %origins[%origin], %table_payload_bytes : i32
  %target = buffer.view %origins[%origin] : buffer -> view<[%row_count]x5xi64>
  scf.for %i = [%c0 to %row_count step %c1] {
    %row = index.cast %i : index to i64
    %relative = scalar.muli %row, %row_stride : i64
    %base = scalar.addi %pool_bytes, %relative : i64
    %recurrent_base = scalar.addi %base, %recurrent_origin : i64
    %tokens_base = scalar.addi %base, %tokens_offset : i64
    %progress_base = scalar.addi %base, %progress_offset : i64
    func.call @inkling.row_view(%views, %row_count, %i, %c0, %base, %control_bytes) : (buffer, index, index, index, i64, i64)
    func.call @inkling.row_view(%views, %row_count, %i, %c1, %tokens_base, %zero64) : (buffer, index, index, index, i64, i64)
    func.call @inkling.row_view(%views, %row_count, %i, %c2, %tokens_base, %token_bytes) : (buffer, index, index, index, i64, i64)
    func.call @inkling.row_view(%views, %row_count, %i, %c3, %progress_base, %progress_bytes) : (buffer, index, index, index, i64, i64)
    view.store %recurrent_base, %target[%i, 0] : i64, view<[%row_count]x5xi64>
    view.store %recurrent_base, %target[%i, 1] : i64, view<[%row_count]x5xi64>
    view.store %zero64, %target[%i, 2] : i64, view<[%row_count]x5xi64>
    %map_stride = scalar.muli %blocks_per_row, %word_bytes : i64
    %map_relative = scalar.muli %row, %map_stride : i64
    %map_base = scalar.addi %origin_bytes, %map_relative : i64
    view.store %map_base, %target[%i, 4] : i64, view<[%row_count]x5xi64>
  }
  // Geometry: eight header words, then one region per cache. Region words are allocation, origin, planes, plane bytes, page bytes.
  %header_bytes = index.constant 64 : offset
  %geometry_bytes = index.constant 104 : offset
  %geometry = buffer.alloca<private> align(8) %geometry_bytes : buffer
  %geometry_view = buffer.view %geometry[%origin] : buffer -> view<8xi64>
  %bank_capacity = index.cast %packet_capacity : i64 to index
  %bank_extent = func.call @inkling_feedback_bank_bytes(%bank_capacity) : (index) -> (offset)
  %feedback_split = index.cast %bank_extent : offset to i64
  view.store %block_tokens, %geometry_view[0] : i64, view<8xi64>
  view.store %origin_bytes, %geometry_view[1] : i64, view<8xi64>
  view.store %zero64, %geometry_view[2] : i64, view<8xi64>
  view.store %feedback_split, %geometry_view[3] : i64, view<8xi64>
  %absolute_recurrent_origin = scalar.addi %pool_bytes, %recurrent_origin : i64
  view.store %absolute_recurrent_origin, %geometry_view[4] : i64, view<8xi64>
  view.store %row_stride, %geometry_view[5] : i64, view<8xi64>
  view.store %recurrent_bytes, %geometry_view[6] : i64, view<8xi64>
  view.store %slot_count, %geometry_view[7] : i64, view<8xi64>
  %regions = buffer.view %geometry[%header_bytes] : buffer -> view<5xi64>
  %plane_stride = scalar.muli %pool, %plane_token_bytes : i64
  view.store %one64, %regions[0] : i64, view<5xi64>
  view.store %zero64, %regions[1] : i64, view<5xi64>
  view.store %planes, %regions[2] : i64, view<5xi64>
  view.store %plane_stride, %regions[3] : i64, view<5xi64>
  view.store %page_bytes, %regions[4] : i64, view<5xi64>
  %empty = buffer.alloca<private> align(1) %origin : buffer
  func.return %allocations, %views, %origins, %empty, %geometry : buffer, buffer, buffer, buffer, buffer
}
